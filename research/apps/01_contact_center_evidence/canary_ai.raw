c="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a6282ec6cc56a13423b87f_68f7f08a695afe10f5cd9c11_The%20Fullerton%20400x200.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="Crescent Hotels" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a6281244a0bbbae4a968b1_68f81526349ad34ebee3f9fb_Crescent%20400x200-1.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="Hotel 50 Bowery NYC" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a62990919f16c6fb0fc069_68f8145a291c0b5265f5c84d_50%20Bowery%20400x200.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="Remington" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a6297301731597c402a100_68f816f2c7d6f5ada6feea14_Remington%20400x200.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="Guldsmeden" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a62962b3834e4046d9b8f0_68f818f8d76a3df60b6d116b_Guldsmeden%20400x200.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="Ace Hotel" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a629517e70286e373ebaf7_68f8147f2acab08261720a3c_Ace%20Hotel%20400x200.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="Gardena Hotel" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a62936e905318eaa5a0760_68f8189d90b9ac45eb25e4f9_Gardena%20Hotel%20400x200.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="Shedir Collection" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a62910850f49d1ee48a74e_68f819dac8c7f329f2133e35_Shedir%20Collection%20400x200.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="The Standard" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a628fd10c401f2bbca2123_68f81776b36b759bf8ee3cc8_The%20Standard%20400x200.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="Ascend Hotel Collection" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a628e58794c89c5aaf0758_68f814a40b0601015be67a45_Ascend%20400x200.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="Crowne Resorts" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a628d20ed997ee2a2f5172_68f8184d86bc8a6aa2d2070e_Crowne%20Resorts%20400x200.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="The Ludlow New York City" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a629ddff35417b95e27fbf_68f81753d31b9df6cd299cda_The%20Ludlow%20400x200.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="Leading Hotels of the World" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a62896e33baa1790eb388f_68f8172de48b94ed967aebb7_The%20Leading%20Hotels%20400x200.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="Dream Hotels" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a629bf1c73d1d1ee3840eb_68f8156281d74e2239da14f6_Dream%20400x200.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="Real Hospitality" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a629a5cdb1eda78c9ba98a_68f816dadc7d9b97649bed72_Real%20400x200-1.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="Beaumier" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a6276cf3db3cf883403472_6997a950d20f9d826e36f307_beaumier400x200.avif" class="logo-image"/></div><div role="listitem" class="logo-wrapper w-dyn-item"><img alt="Schloss Elmau" loading="lazy" src="https://cdn.prod.website-files.com/5c6d6c45eaa55f57c6367749/69a6272aa842aa10ff1f5759_6997a97ea7975c8cc85867a7_schlosselmau400x200.avif" class="logo-image"/></div></div></div></div></div></section><section class="section-main _56-56"><div class="container-large"><div class="max-width-750 margin-center tablet-text-align-center text-align-center"><h2 class="text-style-h3">Free up time for true hospitality</h2><div class="spacer-24"></div><p>Your staff shines in creating memorable guest experiences—not repeating the same answers over and over. Canary’s AI Guest Messaging automates most inquiries, giving your team more time to deliver the hospitality your hotel is known for.</p><div><div class="spacer-24"></div><a href="https://resources.canarytechnologies.com/ai-hotel-messaging-demo.html" class="button-main w-inline-block"><div>Learn How</div></a></div></div><div class="spacer-56"></div><div class="flexbox gap-16 space-between align-center tablet-direction-vertical"><div class="max-width-590 hide-mobile-landscape hide-mobile-portrait"><img width="590" sizes="(max-width: 767px) 100vw, 590px" alt="Save Time with Conversational Intelligence" src="https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b28688702181_ai_gm_4_2x.webp" loading="lazy" srcset="https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b28688702181_ai_gm_4_2x-p-500.webp 500w, https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b28688702181_ai_gm_4_2x-p-800.webp 800w, https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b28688702181_ai_gm_4_2x-p-1080.webp 1080w, https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b28688702181_ai_gm_4_2x.webp 1180w"/></div><div class="max-width-590 mobile-text-align-center tablet-text-align-center"><h3 class="text-style-h5 text-color-blue">Save Time with Conversational Intelligence</h3><div class="spacer-24"></div><p>Serve up intelligent responses to guests, auto-generate service tickets and free up your team for tasks that require a human touch.</p></div></div><div class="spacer-56"></div><div class="flexbox gap-16 space-between align-center tablet-direction-vertical"><div class="max-width-590 mobile-text-align-center tablet-text-align-center"><h3 class="text-style-h5 text-color-blue">Speak 100+ Languages Tomorrow</h3><div class="spacer-24"></div><p>Effortlessly speak the same language as your guests—regardless of what it is. With automatic translations, guests can communicate in whatever language they prefer.</p></div><div class="max-width-590 hide-mobile-landscape hide-mobile-portrait"><img width="590" sizes="(max-width: 767px) 100vw, 590px" alt="Speak 100+ Languages Tomorrow" src="https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b2868870217a_ai_gm_3_2x.webp" loading="lazy" srcset="https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b2868870217a_ai_gm_3_2x-p-500.webp 500w, https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b2868870217a_ai_gm_3_2x-p-800.webp 800w, https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b2868870217a_ai_gm_3_2x-p-1080.webp 1080w, https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b2868870217a_ai_gm_3_2x.webp 1180w"/></div></div><div class="spacer-56"></div><div class="flexbox gap-16 space-between align-center tablet-direction-vertical tablet-direction-reverse"><div class="max-width-590"><img width="590" sizes="(max-width: 767px) 100vw, 590px" alt="Hotel booking form showing guest John Doe&#x27;s details with a special request for rose petals on the bed and a chatbot message wishing a happy anniversary." src="https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b2868870216a_ai_gm_1_2x.webp" loading="lazy" srcset="https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b2868870216a_ai_gm_1_2x-p-500.webp 500w, https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b2868870216a_ai_gm_1_2x-p-800.webp 800w, https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b2868870216a_ai_gm_1_2x-p-1080.webp 1080w, https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b2868870216a_ai_gm_1_2x.webp 1180w"/></div><div class="max-width-590 mobile-text-align-center tablet-text-align-center"><h3 class="text-style-h5 text-color-blue">Personalize Each Guest&#x27;s Stay</h3><div class="spacer-24"></div><p>Go beyond providing a list of canned recommendations. Canary AI Guest Messaging offers personalized suggestions for activities, dining and more based on guest preferences.</p></div></div><div class="spacer-56"></div><div class="flexbox gap-16 space-between align-center tablet-direction-vertical"><div class="max-width-590 mobile-text-align-center tablet-text-align-center"><h3 class="text-style-h5 text-color-blue">Increase Ancillary Revenue</h3><div class="spacer-24"></div><p>Boost upsell revenue by 4x. AI Guest Messaging intelligently detects guests&#x27; needs and surfaces relevant add-ons at exactly the right time.</p></div><div class="max-width-590"><img width="590" sizes="(max-width: 767px) 100vw, 590px" alt="Guest asks about check-in time, hotel offers early check-in options with fees, guest requests very early check-in, and hotel confirms approval." src="https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b28688702173_ai_gm_2_2x.webp" loading="lazy" srcset="https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b28688702173_ai_gm_2_2x-p-500.webp 500w, https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b28688702173_ai_gm_2_2x-p-800.webp 800w, https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b28688702173_ai_gm_2_2x-p-1080.webp 1080w, https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b28688702173_ai_gm_2_2x.webp 1180w"/></div></div></div></section><section class="section-main section-use-cases-experience"><div class="container-medium"><div class="flexbox gap-16 space-between"><div class="max-width-660 mobile-max-width-none mobile-text-align-center"><div class="flexbox mobile-justify-center"><div class="divider _250-3 blue"></div></div><div class="spacer-16"></div><h2 class="text-style-h3 text-color-white">See why brands like Wyndham and BWH Hotels are rolling out AI Guest Messaging across their entire portfolio</h2><div class="spacer-40"></div><a href="https://resources.canarytechnologies.com/ai-hotel-messaging-demo.html" class="button-main w-inline-block"><div>Book a Demo</div></a><div class="spacer-40"></div></div><div class="max-width-450 mobile-display-none"><img loading="lazy" src="https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/68e27963a1e9b28688702164_wyndham-bw.avif" alt="Wyndham Hotels &amp; Resorts logo above BW Hotels logo with a vertical line separating &#x27;BW&#x27; and &#x27;Hotels&#x27;." class="use-cases-experience-visual products tiny"/></div></div></div></section><section class="section-main _56-56"><div class="container-large"><div class="text-align-center"><h2 class="text-style-h3">Features &amp; Capabilities</h2><div class="spacer-20"></div><div class="how-it-works-items-wrapper"><div class="how-it-works-item"><img width="48" height="48" alt="Unique Links per Guest visual" src="https://cdn.prod.website-files.com/67d96a31f556fbb25bfa24cf/686331ac52a4078ded12e018_zinger1.svg" loading="lazy"/><div class="spacer-20"></div><h3 class="text-style-h5">Automated AI handoffs</h3><div class="spacer-10"></div><p>If Canary AI can’t answer a guest&#x27;s inquiry, it automatically redirects the message to your team.</p></div><div class="how-it-works-item"><img width="48" height="48" alt="Unique Links per Guest visual" src="https://cdn.prod.website-files.com/67d96a31f556fbb25bfa24cf/6863327fd293edf793c60120_zinger2.svg" loading="lazy"/><div class="spacer-20"></div><h3 class="text-style-h5">An ever-growing knowledge base</h3><div class="spacer-10"></div><p>Canary AI continuously learns more about your hotel, so it can respond to more guest requests as time goes on.</p></div><div class="how-it-works-item"><img width="48" height="48" alt="Unique Links per Guest visual" src="https://cdn.prod.website-files.com/67d96a31f556fbb25bfa24cf/68633290d09311763fd1c667_zinger3.svg" loading="lazy"/><div class="spacer-20"></div><h3 class="text-style-h5">Instant, professional, on-brand responses</h3><div class="spacer-10"></div><p>Speak with a consistent brand voice and respond with grammatically correct messages.</p></div><div class="how-it-works-item"><img width="48" height="48" alt="Unique Links per Guest visual" src="https://cdn.prod.website-files.com/67d96a31f556fbb25bfa24cf/686332a153eda7b67b53e209_zinger4.svg" loading="lazy"/><div class="spacer-20"></div><h3 class="text-style-h5">Automated service tickets</h3><div class="spacer-10"></div><p>Create service tickets from guest messages and send them to your service software with one click.</p></div><div class="how-it-works-item"><img width="48" height="48" alt="Unique Links per Guest visual" src="https://cdn.prod.website-files.com/67d96a31f556fbb25bfa24cf/686332b2bee1f495e9f7d719_zinger5.svg" loading="lazy"/><div class="spacer-20"></div><h3 class="text-style-h5">Responsible, customizable AI</h3><div class="spacer-10"></div><p>Canary employs sophisticated training, evaluation and real-time monitoring to prevent inappropriate replies.</p></div></div></div></div></section><section class="section-main _56-56"><div class="container-large"><div class="blue-cta-wrapper dark"><div class="cta-content-wrapper max-width-none gap-32"><div class="max-width-310"><img width="310" height="Auto" alt="" src="https://cdn.prod.website-files.com/5c6d1141d51c77692887d502/69bb591232a60d29bbdf1a23_free_ai_research_report-cover.webp" loading="lazy"/></div><div class="max-width-610 tablet-text-align-center"><h3 class="text-color-white text-size-36">Navigating AI: Hospitality Shifts From Exploration to Execution</h3><div class="spacer-24"></div><p class="text-color-white">The hospitality industry is in the era of AI adoption. Explore the trends and insights on AI exploration and adoption from hundreds of global IT decision makers at hotels.</p></div><div class="flexbox"><div class="min-width-205"><a href="https://resources.canarytechnologies.com/ai-hospitality-research.html" class="button-main is-white is-icon w-inline-block"><div>Download Now</div><div class="flexbox w-embed"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
