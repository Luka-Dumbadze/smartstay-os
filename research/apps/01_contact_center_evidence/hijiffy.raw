t_type="image.default"> <div class="elementor-widget-container"> <img width="580" height="210" alt="Autocamp logo card new homepage [en]" sizes="(max-width: 580px) 100vw, 580px" nitro-lazy-srcset="https://cdn-ileifea.nitrocdn.com/iPyOASfdsJWKFGsMcpWrFNEuPYjDaYld/assets/images/optimized/rev-06ec2d4/www.hijiffy.com/wp-content/uploads/2026/03/autocamp-logo-card.webp 580w, https://cdn-ileifea.nitrocdn.com/iPyOASfdsJWKFGsMcpWrFNEuPYjDaYld/assets/images/optimized/rev-06ec2d4/www.hijiffy.com/wp-content/uploads/2026/03/autocamp-logo-card-300x109.webp 300w" nitro-lazy-src="https://cdn-ileifea.nitrocdn.com/iPyOASfdsJWKFGsMcpWrFNEuPYjDaYld/assets/images/optimized/rev-06ec2d4/www.hijiffy.com/wp-content/uploads/2026/03/autocamp-logo-card.webp" class="attachment-large size-large wp-image-15069 nitro-lazy" decoding="async" /> </div> </div> <div class="elementor-element elementor-element-10b6eed elementor-widget elementor-widget-heading" data-id="10b6eed" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default"> <div class="elementor-widget-container"> <h3 class="elementor-heading-title elementor-size-default">AutoCamp generates over $1.6 million while saving 15% in operational costs using HiJiffy</h3> </div> </div> <div class="elementor-element elementor-element-c17b517 elementor-widget elementor-widget-text-editor" data-id="c17b517" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default"> <div class="elementor-widget-container"> <p>“HiJiffy has been a great partner of ours as we scale our outdoor hospitality brand across the country. Not only does the platform provide best-in-class automation, allowing our Guest Service team to spend more time on the phone with our guests, it has also proven to be an invaluable revenue-generating channel (&#8230;)”</p> </div> </div> <div class="elementor-element elementor-element-456546d elementor-position-left elementor-vertical-align-middle elementor-position-left elementor-vertical-align-middle elementor-widget elementor-widget-image-box" data-id="456546d" data-element_type="widget" data-e-type="widget" data-widget_type="image-box.default"> <div class="elementor-widget-container"> <div class="elementor-image-box-wrapper"><figure class="elementor-image-box-img"><img width="500" height="500" alt="Vinny cuneo new homepage [en]" sizes="(max-width: 500px) 100vw, 500px" nitro-lazy-srcset="https://cdn-ileifea.nitrocdn.com/iPyOASfdsJWKFGsMcpWrFNEuPYjDaYld/assets/images/optimized/rev-06ec2d4/www.hijiffy.com/wp-content/uploads/2024/10/Vinny-Cuneo.png 500w, https://cdn-ileifea.nitrocdn.com/iPyOASfdsJWKFGsMcpWrFNEuPYjDaYld/assets/images/optimized/rev-06ec2d4/www.hijiffy.com/wp-content/uploads/2024/10/Vinny-Cuneo-300x300.png 300w, https://cdn-ileifea.nitrocdn.com/iPyOASfdsJWKFGsMcpWrFNEuPYjDaYld/assets/images/optimized/rev-06ec2d4/www.hijiffy.com/wp-content/uploads/2024/10/Vinny-Cuneo-150x150.png 150w" nitro-lazy-src="https://cdn-ileifea.nitrocdn.com/iPyOASfdsJWKFGsMcpWrFNEuPYjDaYld/assets/images/optimized/rev-06ec2d4/www.hijiffy.com/wp-content/uploads/2024/10/Vinny-Cuneo.png" class="attachment-full size-full wp-image-10576 nitro-lazy" decoding="async" /></figure><div class="elementor-image-box-content"><div class="elementor-image-box-title">Vinny Cuneo</div><p class="elementor-image-box-description">Vice President of Revenue Strategy</p></div></div> </div> </div> <div class="elementor-element elementor-element-bc95e69 elementor-widget-mobile__width-auto elementor-widget elementor-widget-button" data-id="bc95e69" data-element_type="widget" data-e-type="widget" data-widget_type="button.default"> <div class="elementor-widget-container"> <div class="elementor-button-wrapper"> <a class="elementor-button elementor-button-link elementor-size-sm" href="https://www.hijiffy.com/success-stories/autocamp"> <span class="elementor-button-content-wrapper"> <span class="elementor-button-text">Read More</span> </span> </a> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> </div> <div class="elementor-element elementor-element-6f526f2 e-flex e-con-boxed e-con e-parent" data-id="6f526f2" data-element_type="container" data-e-type="container" data-settings="{&quot;jet_parallax_layout_list&quot;:[]}"> <div class="e-con-inner"> <div class="elementor-element elementor-element-9857670 e-con-full e-flex e-con e-child" data-id="9857670" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;,&quot;jet_parallax_layout_list&quot;:[]}"> <div class="elementor-element elementor-element-992e056 e-con-full e-flex e-con e-child" data-id="992e056" data-element_type="container" data-e-type="container" data-settings="{&quot;jet_parallax_layout_list&quot;:[]}"> <div class="elementor-element elementor-element-13497c1 e-flex e-con-boxed e-con e-child" data-id="13497c1" data-element_type="container" data-e-type="container" data-settings="{&quot;jet_parallax_layout_list&quot;:[]}"> <div class="e-con-inner"> <div class="elementor-element elementor-element-262c3aa elementor-position-left elementor-vertical-align-middle elementor-widget__width-auto elementor-position-left elementor-widget elementor-widget-image-box" data-id="262c3aa" data-element_type="widget" data-e-type="widget" data-widget_type="image-box.default"> <div class="elementor-widget-container"> <div class="elementor-image-box-wrapper"><figure class="elementor-image-box-img"><img width="16" height="16" alt="Package check new homepage [en]" nitro-lazy-src="https://cdn-ileifea.nitrocdn.com/iPyOASfdsJWKFGsMcpWrFNEuPYjDaYld/assets/images/optimized/rev-06ec2d4/www.hijiffy.com/wp-content/uploads/2026/01/package-check.svg" class="attachment-full size-full wp-image-14628 nitro-lazy" decoding="async" /></figure><div class="elementor-image-box-content"><div class="elementor-image-box-title">Proactive Campaigns Driving Direct Bookings and Upsells</div></div></div> </div> </div> <div class="elementor-element elementor-element-8111449 e-con-full e-flex e-con e-child" data-id="8111449" data-element_type="container" data-e-type="container" data-settings="{&quot;jet_parallax_layout_list&quot;:[]}"> <div class="elementor-element elementor-element-5104001 elementor-widget elementor-widget-heading" data-id="5104001" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default"> <div class="elementor-widget-container"> <h2 class="elementor-heading-title elementor-size-default">One Console, Full Control</h2> </div> </div> <div class="elementor-element elementor-element-5e39a4e elementor-widget__width-initial elementor-widget elementor-widget-text-editor" data-id="5e39a4e" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default"> <div class="elementor-widget-container"> <p>Manage everything from the Console with full visibility over every conversation, campaign, and result.</p><p><strong>Webchat campaigns</strong> turn browsing visitors into direct bookings. <strong>WhatsApp campaigns</strong>, triggered by real reservation events, carry the relationship from pre-arrival to post-stay with open rates above 80%. Both run on pre-built flows you set up once.</p> </div> </div> </div> </div> </div> <div class="elementor-element elementor-element-e9d6a1c e-flex e-con-boxed e-con e-child" data-id="e9d6a1c" data-element_type="container" data-e-type="container" data-settings="{&quot;jet_parallax_layout_list&quot;:[]}"> <div class="e-con-inner"> <div class="elementor-element elementor-element-ca91d14 elementor-widget elementor-widget-template" data-id="ca91d14" data-element_type="widget" data-e-type="widget" data-widget_type="template.default"> <div class="elementor-widget-container"> <div class="elementor-template"> <div data-elementor-type="container" data-elementor-id="14928" class="elementor elementor-14928" data-elementor-post-type="elementor_library"> <div class="elementor-element elem