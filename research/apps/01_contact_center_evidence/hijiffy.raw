                var widgetId = 'logo-carousel';
                var mountId = '#cew-widget-logo-carousel-4e8e444';

                function mountWidget() {
                    if (window.CustomElementorWidgets && window.CustomElementorWidgets[widgetId]) {
                        window.CustomElementorWidgets[widgetId].mount(mountId);
                        return true;
                    }
                    return false;
