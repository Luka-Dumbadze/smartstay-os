document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.testimonials-section');
    if (!section) return;

    const listItems = section.querySelectorAll('.elementor-icon-list-item');
    const carousels = section.querySelectorAll('.elementor-widget-n-carousel');

    if (!listItems.length || !carousels.length) return;

    // Set initial state - first item active, first carousel visible
    listItems[0].classList.add('active');
    carousels[0].classList.add('active');

    listItems.forEach(function(item, index) {
        item.addEventListener('click', function() {
            // Remove active from all list items
            listItems.forEach(function(li) {
                li.classList.remove('active');
            });

            // Remove active from all carousels
            carousels.forEach(function(c) {
                c.classList.remove('active');
            });

            // Activate clicked item and corresponding carousel
            item.classList.add('active');
            if (carousels[index]) {
                carousels[index].classList.add('active');
            }
        });
    });
});
</script><script id="44783847d0d882af2f25a51110091e12-1" type="nitropack/inlinescript" class="nitropack-inline-script">
    ( () => {
     const lazyloadRunObserver = () => {
      const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
      const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
       entries.forEach( ( entry ) => {
        if ( entry.isIntersecting ) {
         let lazyloadBackground = entry.target;
         if( lazyloadBackground ) {
          lazyloadBackground.classList.add( 'e-lazyloaded' );
         }
         lazyloadBackgroundObserver.unobserve( entry.target );
        }
       });
      }, { rootMargin: '200px 0px 200px 0px' } );
      lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
       lazyloadBackgroundObserver.observe( lazyloadBackground );
      } );
     };
     const events = [
      'DOMContentLoaded',
      'elementor/lazyload/observe',
     ];
     events.forEach( ( event ) => {
      document.addEventListener( event, lazyloadRunObserver );
     } );
    } )();
   </script><script id="pll_cookie_script-js-after" type="nitropack/inlinescript" class="nitropack-inline-script">
(function() {
    var expirationDate = new Date();
    expirationDate.setTime( expirationDate.getTime() + 31536000 * 1000 );
    document.cookie = "pll_language=en; expires=" + expirationDate.toUTCString() + "; path=/; secure; SameSite=Lax";
   }());

