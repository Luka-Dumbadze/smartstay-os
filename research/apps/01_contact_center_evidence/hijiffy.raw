document.addEventListener('DOMContentLoaded', function () {
  'use strict';

  if (document.body.classList.contains('elementor-editor-active')) return;

  var tabsWidget = document.querySelector('.guest-journey .e-n-tabs');
  if (!tabsWidget) return;

  var tabButtons = Array.from(tabsWidget.querySelectorAll('.e-n-tabs-heading .e-n-tab-title'));
  var tabPanels  = Array.from(tabsWidget.querySelectorAll('.e-n-tabs-content > [role="tabpanel"]'));
  var allAssets  = Array.from(document.querySelectorAll('.guest-journey .asset-content-wraper'));
  var allVideos  = Array.from(document.querySelectorAll('.guest-journey video'));

  // 1) Strip every video's src + autoplay at startup so NOTHING downloads.
  allVideos.forEach(function (v) {
    var src = v.getAttribute('src');
    if (src) { v.dataset.src = src; v.removeAttribute('src'); }
    v.removeAttribute('autoplay');     // prevent browser-initiated loads
    v.setAttribute('preload', 'none');
    try { v.pause(); } catch (e) {}
    try { v.load(); } catch (e) {}     // flush any in-flight request
  });

  // Make the grid stacking work
  var seenParents = [];
  allAssets.forEach(function (el) {
    if (el.parentElement && seenParents.indexOf(el.parentElement) === -1) {
      seenParents.push(el.parentElement);
      el.parentElement.style.display = 'grid';
    }
  });

  // 2) Section visibility gate — nothing loads until user scrolls here.
  var sectionInView = false;
  var pendingAsset = null;     // asset queued while section was offscreen

  function getOpenAccordionIndex(panel) {
    var openDetail = panel.querySelector('details.e-n-accordion-item[open]');
    if (!openDetail) return 1;
    var summary = openDetail.querySelector('summary[data-accordion-index]');
    return summary ? parseInt(summary.getAttribute('data-accordion-index'), 10) : 1;
  }

  function revealVideo(v) {
    function show() {
      v.classList.add('is-ready');
      v.play().catch(function () {});
    }
    if (v.dataset.loaded === '1') { show(); return; }
    if (v.dataset.src) {
      v.setAttribute('src', v.dataset.src);
      v.setAttribute('preload', 'auto');
      v.load();
    }
    v.addEventListener('canplaythrough', function () {
      v.dataset.loaded = '1';
      show();
    }, { once: true });
  }

  function hideVideo(v) {
    v.classList.remove('is-ready');
    try { v.pause(); } catch (e) {}
  }

  // 3) Only the SINGLE active asset's video is ever hydrated.
  function activateAsset(panel, accordionIdx) {
    // Pause + fade out everything currently visible
    allAssets.forEach(function (el) {
      if (el.classList.contains('is-visible')) {
        el.classList.remove('is-visible');
        el.querySelectorAll('video').forEach(hideVideo);
      }
    });

    var target = panel.querySelectorAll('.asset-content-wraper')[accordionIdx - 1];
    if (!target) return;

    requestAnimationFrame(function () {
      target.classList.add('is-visible');

      if (!sectionInView) {
        // Defer hydration until section scrolls into view
        pendingAsset = target;
        return;
      }
      target.querySelectorAll('video').forEach(revealVideo);
    });
  }

  function handleTabChange(tabIndex) {
    var panel = null;
    tabPanels.forEach(function (p) {
      if (p.getAttribute('data-tab-index') === tabIndex) panel = p;
    });
    if (panel) activateAsset(panel, getOpenAccordionIndex(panel));
  }

  // Listeners
  tabButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      setTimeout(function () { handleTabChange(btn.getAttribute('data-tab-index')); }, 60);
    });
  });

  tabPanels.forEach(function (panel) {
    panel.querySelectorAll('details.e-n-accordion-item').forEach(function (detail) {
      detail.addEventListener('toggle', function () {
        if (!detail.open) return;
        var summary = detail.querySelector('summary[data-accordion-index]');
        var accIdx = summary ? parseInt(summary.getAttribute('data-accordion-index'), 10) : 1;
        activateAsset(panel, accIdx);
      });
    });
  });

  // 4) IntersectionObserver on the section itself
  var sectionEl = document.querySelector('.guest-journey') || tabsWidget;
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting && !sectionInView) {
          sectionInView = true;
          if (pendingAsset) {
            pendingAsset.querySelectorAll('video').forEach(revealVideo);
            pendingAsset = null;
          }
          io.disconnect(); // we only need the first time it enters view
        }
      });
    }, { rootMargin: '200px 0px' }); // start loading slightly before it's visible
    io.observe(sectionEl);
  } else {
    // Fallback for ancient browsers
    sectionInView = true;
  }

  // Set up the initial active asset (no video loads until section is in view)
  handleTabChange('1');
});
</script><script id="6671f0d39938f7beecd9d368570d303e-1" type="nitropack/inlinescript" class="nitropack-inline-script">
