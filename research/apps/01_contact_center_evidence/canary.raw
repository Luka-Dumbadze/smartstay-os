    {
      "@type": "SoftwareApplication",
      "@id": "https://www.canarytechnologies.com/products/guest-messaging#software",
      "name": "Canary Guest Messaging",
      "url": "https://www.canarytechnologies.com/products/guest-messaging",
      "description": "Hotel guest messaging software that consolidates SMS, WhatsApp, OTAs, WeChat, LINE, and email in a unified inbox. Includes AI-powered smart replies and PMS integration with no app downloads required.",
      "applicationCategory": "BusinessApplication",
