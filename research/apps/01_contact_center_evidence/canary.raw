        "bestRating": "5",
        "worstRating": "1",
        "url": "https://hoteltechreport.com/guest-experience/guest-messaging-platforms/canary-messages"
      },
      "review": [
        {
          "@type": "Review",
          "itemReviewed": {
            "@id": "https://www.canarytechnologies.com/products/guest-messaging#software"
          },
          "author": {
            "@type": "Person",
            "name": "Kai Kankal",
            "jobTitle": "Operations Manager",
            "worksFor": {
              "@type": "Organization",
              "name": "Crowne Plaza Perth"
            }
          },
          "reviewBody": "Before Canary, someone would have to spend at least an hour a day manually sending out pre-arrival messages to guests. Automating that has reduced our administrative work by at least 40%.",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5",
            "bestRating": "5",
            "worstRating": "1"
          }
        },
        {
          "@type": "Review",
          "itemReviewed": {
            "@id": "https://www.canarytechnologies.com/products/guest-messaging#software"
          },
          "author": {
            "@type": "Person",
            "name": "Pearl Tam",
            "jobTitle": "Digital Marketing Manager",
            "worksFor": {
              "@type": "Organization",
              "name": "The LINE SF"
            }
          },
          "reviewBody": "We love having Canary Guest Messaging! It's great that we're able to communicate with guests whenever it's necessary. Our guests seem to enjoy using it too when they have inquiries, as some guests prefer to text over a phone call or email.",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5",
            "bestRating": "5",
            "worstRating": "1"
          }
        },
        {
          "@type": "Review",
          "itemReviewed": {
            "@id": "https://www.canarytechnologies.com/products/guest-messaging#software"
          },
          "author": {
            "@type": "Person",
            "name": "Greg Nawrocki",
            "jobTitle": "Corporate Director of Online Marketing",
            "worksFor": {
              "@type": "Organization",
              "name": "Linchris Hotels"
            }
          },
          "reviewBody": "Since we've started using Canary, guests have messaged us over 30,000 times. If that same volume had come to us over the phone, there's no way we could have gotten to all of those guests.",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "5",
            "bestRating": "5",
            "worstRating": "1"
          }
        }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.canarytechnologies.com/products/guest-messaging#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is guest messaging software?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Guest messaging software is a hotel text messaging system that enables hotel staff to send messages and engage with guests in real time. It also enables a hotel to set up AI messaging to answer some of the most common guest questions automatically."
          }
        },
        {
          "@type": "Question",
          "name": "Why is a hotel text messaging system like Canary Guest Messaging important for hoteliers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A hotel text messaging system like Canary Guest Messaging is important because it allows hoteliers to respond quickly and efficiently to guest inquiries, concerns, and requests. Guest messaging consolidates communication into a single inbox so no message is missed, and AI-powered replies reduce the routine workload on front-desk staff."
          }
        },
        {
          "@type": "Question",
          "name": "How does hotel guest messaging software work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hotel guest messaging software, sometimes referred to as a hotel text messaging system, enables hotels to send automated or manual messages to guests via SMS, email, or in-app notifications. Pre-arrival messages, in-stay communication, and post-stay follow-ups can all be orchestrated from a single platform."
          }
        },
        {
          "@type": "Question",
          "name": "What are the key benefits of hotel guest messaging software?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hotel text messaging systems offer benefits to front desk agents, hotel management teams, and guests, including increased guest satisfaction through faster responses, improved operational efficiency through automation of routine messages, more upsell opportunities via targeted in-stay messages, and a unified record of communication for every reservation."
          }
        },
        {
          "@type": "Question",
          "name": "What should hotels look for when choosing an automated messaging system?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ease of use for guests and hotel staff should be the top concern. No new app downloads should be required of guests, and the dashboard should be intuitive for staff. Key criteria also include PMS integration, multi-channel support (SMS, WhatsApp, email), AI assistance, multi-language support, and reliable deliverability."
          }
        },
        {
          "@type": "Question",
          "name": "How does Canary's Guest Messaging elevate guest satisfaction?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Canary's Guest Messaging transforms how you connect with guests by enabling fast, two-way communication via SMS and WhatsApp. From answering questions pre-arrival to resolving requests during the stay, guests get quick, accurate responses on the channels they already use."
          }
        },
        {
          "@type": "Question",
          "name": "Can Canary Guest Messaging integrate with your existing PMS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Canary's Guest Messaging integrates seamlessly with all major property management systems. These deep integrations automatically sync guest profiles and reservation data, so your team always sees the right context next to every message."
          }
        },
        {
          "@type": "Question",
          "name": "How does Canary Guest Messaging increase hotel staff operational efficiency?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "By consolidating guest messages in a centralized dashboard and automating routine replies, Canary's Guest Messaging saves staff hours of manual work each week. Real-time alerts and quick replies mean staff spend less time on repetitive inquiries and more time on high-value guest interactions."
          }
        }
      ]
    }
  ]
}
