			{{{data.after_title}}}
			{{{data.before_content}}}
			<div class="jet-ajax-search__item-content">{{{data.content}}}</div>
			{{{data.after_content}}}
			{{{data.rating}}}
			{{{data.price}}}
		</div>
	</a>
	{{{data.add_to_cart}}}
</div>
</script><script type="text/html" id="tmpl-jet-search-focus-suggestion-item">
