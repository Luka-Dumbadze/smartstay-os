<style>
/* Language Selector spacing */
.cpel-switcher__lang a:nth-last-child(1) {
	padding-bottom: 4px;
	}
.cpel-switcher__lang a:first-child {
	padding-top: 4px;
	}
/* FAQ\'s Link Colour */
[id^=\"elementor-tab-content\"] a {
    color: #6b48ff;
    font-size: 16px;
}
[id^=\"elementor-tab-content\"] a:hover {
    color: #6d72f6;
}
[id^=\"elementor-tab-content\"] h2 {
	font-size: 20px;
	line-height: 20px;
	font-weight: 800;
}
/* Internal Linking Styles for Articles */
.wrapperil {
  display: flex;
  flex-direction: column;
  padding-top: 5px;
  padding-bottom: 5px;
}
.blocktext {
  display: block;
}
.primarycontainer {
  font-family: \"Work Sans\", sans-serif;
  font-size: 16px;
  line-height: 22px;
  font-weight: 600;
  display: inline-flex;
  background-color: #6b48ff;
  color: white;
  padding: 10px 20px;
  border-radius: 8px 8px 0px 0px;
  float: left;
}
.lightcontainer {
  font-family: \"Work Sans\", sans-serif;
  font-size: 16px;
  line-height: 22px;
  font-weight: 600;
  display: inline-flex;
  background-color: #c5b6fA;
  color: white;
  padding: 10px 20px;
  border-radius: 8px 8px 0px 0px;
  float: left;
}
.greycontainer {
  font-family: \"Work Sans\", sans-serif;
  font-size: 16px;
  line-height: 22px;
  font-weight: 600;
  display: inline-flex;
  background-color: #ccd4d7;
  color: white;
  padding: 10px 20px;
  border-radius: 8px 8px 0px 0px;
  float: left;
}
.bluecontainer {
  font-family: \"Work Sans\", sans-serif;
  font-size: 16px;
  line-height: 22px;
  font-weight: 600;
  display: inline-flex;
  background-color: #1a1e42;
  color: white;
  padding: 10px 20px;
  border-radius: 8px 8px 0px 0px;
  float: left;
}
.lowercontainer {
  font-family: \"Work Sans\", sans-serif;
  font-size: 16px;
  line-height: 22px;
  font-weight: 400;
  color: #333333;
  padding: 12px 20px;
  border: #ddd solid 1px;
  border-radius: 0px 8px 8px 8px;
}

