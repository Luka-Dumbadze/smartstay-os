-orientation="horizontal" class="ml-auto flex items-center"><li data-testid="nav-cta"><a href="https://app.intercom.com/admins/sign_in" class="flex h-10 items-center whitespace-nowrap rounded-md px-3 hover:bg-[var(--nav-hover,var(--color-chalk))]"><span class="font-sans tracking-normal text-current text-[14px] leading-[1.1]">Log in</span></a></li><li data-testid="nav-cta"><a class="flex h-10 items-center whitespace-nowrap rounded-md px-3 hover:bg-[var(--nav-hover,var(--color-chalk))]" href="/contact-sales"><span class="font-sans tracking-normal text-current text-[14px] leading-[1.1]">Contact sales</span></a></li><li data-testid="nav-cta"><a href="/start-free-trial" class="flex h-10 items-center whitespace-nowrap rounded-md px-3 hover:bg-[var(--nav-hover,var(--color-chalk))]"><span class="font-sans tracking-normal text-current text-[14px] leading-[1.1]">Start free trial</span></a></li><li data-testid="nav-cta" class="ml-2 first:ml-0"><a class="duration-400 ease-out-quart relative inline-flex cursor-pointer items-center justify-center whitespace-nowrap text-center font-sans font-normal tracking-tight transition-colors focus-visible:outline-offset-2 bg-nav-content-primary border-nav-content-primary text-nav-control group-hover:border-nav-button-hover group-hover:bg-nav-button-hover hover:border-nav-button-hover hover:bg-nav-button-hover border h-10 gap-1 rounded-[4px] px-3 py-0 text-[14px] leading-[1.1] min-[1140px]:px-3 xl:px-3 xl:py-0 xl:text-[14px]" href="/view-demos">View demo</a></li></ul><div class="group/switch relative flex items-center gap-[9px]"><div class="bg-[color-mix(in_oklab,var(--nav-fg,var(--color-off-black))_15%,transparent)] h-[33px] w-px"></div><ul class="flex"><li class="ml-2 first:ml-0"><a role="button" tabindex="0" href="https://www.intercom.com/" class="duration-400 ease-out-quart relative inline-flex cursor-pointer items-center justify-center whitespace-nowrap text-center font-sans font-normal tracking-tight transition-colors focus-visible:outline-offset-2 border-nav-content-primary text-nav-content-primary group-hover:bg-nav-content-primary group-hover:text-nav-control hover:bg-nav-content-primary hover:text-nav-control border h-10 gap-1 rounded-[4px] px-3 py-0 text-[14px] leading-[1.1] min-[1140px]:px-3 xl:px-3 xl:py-0 xl:text-[14px]">Intercom<span aria-hidden="true">→</span></a></li></ul><div class="border-[var(--nav-panel-border,var(--color-clay))] invisible absolute right-0 top-full mt-[18px] w-[344px] -translate-y-1.5 border bg-[color-mix(in_oklab,var(--nav-panel-bg,#fff)_95%,transparent)] opacity-0 group-hover/switch:visible group-hover/switch:translate-y-0 group-hover/switch:opacity-100 group-hover/switch:backdrop-blur-[4px] group-hover/switch:transition-all group-hover/switch:duration-200 group-hover/switch:ease-out group-focus-within/switch:visible group-focus-within/switch:translate-y-0 group-focus-within/switch:opacity-100 group-focus-within/switch:backdrop-blur-[4px] group-focus-within/switch:transition-all group-focus-within/switch:duration-200 group-focus-within/switch:ease-out h-[192px]"><div aria-hidden="true" class="absolute inset-x-1 flex justify-between top-1"><span class="bg-helpdesk size-1"></span><span class="bg-helpdesk size-1"></span><span class="bg-helpdesk size-1"></span></div><div aria-hidden="true" class="absolute inset-x-1 flex justify-between bottom-1"><span class="bg-helpdesk size-1"></span><span class="bg-helpdesk size-1"></span><span class="bg-helpdesk size-1"></span></div><p class="text-[var(--nav-fg,var(--color-off-black))] absolute left-4 w-[300px] text-[24px] leading-none tracking-[-0.48px] top-[31px]">The only helpdesk<!-- --> <span class="text-[color-mix(in_oklab,var(--nav-fg,var(--color-off-black))_60%,transparent)]">designed for the AI Agent era</span></p><p class="text-[var(--nav-fg,var(--color-off-black))] absolute left-[15px] w-[320px] text-[12px] leading-[1.2] top-[103px]">Intercom has every feature your team needs to resolve queries faster, deliver personalized service, engage proactively, and continuously improve your customer experience.</p></div></div></div></nav></div></header><div class="brand-i2y4 saans_f8486ea3-module__LTws8a__variable saansmono_7f27222-module__Snlndq__variable serrif_5f5aab1d-module__ozC_IG__variable serrifcondensed_295dd80a-module__H7-DtG__variable"><div tabindex="-1" role="region" aria-live="polite" aria-atomic="false" aria-relevant="additions text" aria-label="Notifications" class="fixed bottom-4 left-1/2 z-50 flex w-max -translate-x-1/2 flex-col gap-2 outline-none md:left-auto md:right-6 md:translate-x-0"></div><div class="selection:bg-off-black font-sans selection:text-white"><div class="root"><div><script id="home-schema" type="application/ld+json">[{"@context":"https://schema.org","@graph":[{"@type":"WebPage","@id":"https://fin.ai","url":"https://fin.ai","name":"Fin. The #1 AI Agent for Customer Service, Sales, and Ecommerce","isPartOf":{"@id":"https://fin.ai/#website"},"about":{"@id":"https://fin.ai/#organization"},"primaryImageOfPage":{"@id":"https://fin.ai/#primaryimage"},"image":{"@id":"https://fin.ai/#primaryimage"},"thumbnailUrl":"https://fin.ai/img/social/home-v2.jpg","dateModified":"2026-06-12T09:00:00-07:00","description":"Fin is now a Customer Agent. Featuring Fin AI Agent and Intercom Helpdesk — everything you need to deliver exceptional customer support at scale.","inLanguage":"en-US","mainEntity":{"@id":"https://fin.ai#reasons-to-hire-fin"},"potentialAction":[{"@type":"ReadAction","target":["https://fin.ai"]}]},{"@type":"ItemList","@id":"https://fin.ai#reasons-to-hire-fin","name":"22 reasons to hire Fin","description":"The 22 reasons businesses choose Fin as their AI Customer Agent, spanning performance, proprietary AI models, channels, helpdesk integrations, trust and security, customization, pricing and vision.","numberOfItems":22,"itemListOrder":"https://schema.org/ItemListOrderAscending","itemListElement":[{"@type":"ListItem","position":1,"name":"Fin is the highest performing customer agent on the market","description":"Fin has industry-leading resolution rates, averaging 76% across 12,000+ customers, with many seeing over 85%. It is currently handling 2 million weekly resolutions and the average resolution rate increases 1% every month."},{"@type":"ListItem","position":2,"name":"Fin is used by over 12,000 of the world's most forward-looking brands","description":"Customers include Anthropic, Clay, Lightspeed, Rocket Money and Gamma, spanning Software and Technology, Retail and eCommerce, Gaming, Financial Services and large Enterprise. Fin is the leader on G2 with a 90% satisfaction score, beating the nearest competitor by 8 percentage points."},{"@type":"ListItem","position":3,"name":"Fin performs best because it runs on our proprietary AI models","description":"Fin runs on Apex 1.0 and Apex Flash, models custom-trained on billions of customer experience interactions. They are the highest performing, fastest and cheapest models for customer experience, with sophisticated checks and balances to ensure accurate answers."},{"@type":"ListItem","position":4,"name":"Fin works across the entire customer journey","description":"Fin is pioneering the Customer Agent: a single customer-facing agent that works across the customer journey from day 1 to year 10. It handles every role, from Service to Sales, using pre-trained skills, knowledge, customer history and context."},{"@type":"ListItem","position":5,"name":"Fin gets better every week","description":"Fin improves at a rapid pace. In 2025 we shipped 226 product updates, and as of June 2026 we have already shipped 191 this year, on track to 3x our productivity thanks to deep investment in AI engineering."},{"@type":"ListItem","position":6,"name":"Fin can resolve every customer issue, no matter how complex","description":"Fin resolves incredibly complex queries, reading and writing to complicated third-party systems with ease. It updates accounts, processes payments and refunds, troubleshoots technical issues and much more."},{"@type":"ListItem","position":7,"name":"Fin integrates with your entire tech stack","description":"Fin connects to all your systems, pulling in customer data, personalising responses and taking actions via API, Data Connectors or MCP. Extend Fin with custom actions, workflows and integrations through a fully documented API platform."},{"@type":"ListItem","position":8,"name":"Fin works excellently on every customer channel","description":"Fin meets customers where they are, working natively across all channels including Voice, Chat, email, Slack and social. Fin over Voice uses Apex Flash, a model designed for low-latency interactions that feel natural."},{"@type":"ListItem","position":9,"name":"Fin works seamlessly with every helpdesk","description":"Fin hands off to your human team effortlessly, maintaining full customer context. It is natively integrated with Intercom and works with Salesforce, Hubspot, Freshdesk and many other helpdesks, and can be live in less than an hour."},{"@type":"ListItem","position":10,"name":"Fin gives you full confidence because you're in control","description":"Fin is the only agent you can fully manage yourself, configuring tone, behaviour, knowledge and more without needing engineering resources. You never need to contact us to make changes, so you can experiment and learn quickly."},{"@type":"ListItem","position":11,"name":"Fin is built with trust, safety and reliability at the core","description":"Fin is architected for continuous uptime with redundancy across regions, backed by a 99.8% SLA. It holds SOC2, ISO 27001, ISO 42001, AIUC-1, ISO 27701 and HIPAA, supports Okta, Azure AD and OneLogin SSO, 2FA, SCIM and IP restrictions, with data hosted in the US, EU or Australia."},{"@type":"ListItem","position":12,"name":"Fin learns from every interaction and continuously improves","description":"Fin is built around a flywheel where every conversation makes it smarter, automatically turning insights into recommendations and improvements. As your business evolves, Fin evolves in a cycle of continuous improvement."},{"@type":"ListItem","position":13,"name":"Fin is trained to understand your business deeply","description":"Fin is trained to understand your business goals, policies, rules, guidelines and operating procedures, enabling it to resolve complex multi-step workflows via Procedures. It communicates in your brand voice, speaks dozens of languages and works 24 hours a day."},{"@type":"ListItem","position":14,"name":"Fin has a full testing suite to give you confidence before setting changes live","description":"Fin has a full testing suite to run simulations, regression testing and manual inspection, so you can understand how changes will work in production and at scale before setting them live."},{"@type":"ListItem","position":15,"name":"Fin has a full observability suite to understand and improve","description":"Fin lets you measure and monitor everything in your customer experience and operations, with alerts on what matters most. AI-powered Insights and QA products surface dominant and emergent trends, plus one-click recommendations to improve performance."},{"@type":"ListItem","position":16,"name":"Fin runs your customer operations for you","description":"Fin Operator is an agent that runs your customer operations, orchestrating and automating the work behind the scenes. It spots problems, finds opportunities to improve and acts on them, tuning Fin, keeping knowledge current and scaling automation as your business changes."},{"@type":"ListItem","position":17,"name":"Fin comes with the Blueprint for AI transformation","description":"We have fully transformed our own customer experience and partnered with thousands of customers to do the same, encoding everything into a practical step-by-step guide called the Blueprint, and run Blueprint Events to teach people in person."},{"@type":"ListItem","position":18,"name":"Fin delivers best-in-market results by partnering deeply with customers","description":"Our deployment team works directly with customers to optimise for their bespoke requirements. We see customers as partners and co-develop Fin in direct collaboration with the most forward-thinking of them."},{"@type":"ListItem","position":19,"name":"Fin's groundbreaking AI research is public by default","description":"We believe in sharing as much as we can so others can learn, publishing cutting-edge, industry-first AI research papers and heavily cited industry reports."},{"@type":"ListItem","position":20,"name":"Fin events deliver world-class thought leadership and education","description":"We organise many events, big and small, spending time in person with customers to build the future together. We teach what we know, learn from what they are doing, and help them connect and learn from each other."},{"@type":"ListItem","position":21,"name":"Fin invented and championed outcome-based pricing","description":"We believe you should only pay for Fin when it delivers value. We were first to introduce outcome-based pricing to the market, with control built in via configurable alerts, limits and real-time reporting. As Fin does more work, your support costs go down."},{"@type":"ListItem","position":22,"name":"Fin has the most compelling vision and plan for the future","description":"Three years ago Fin launched as the first agent for customer service, creating the Service Agent category. We are now pioneering perfect customer experiences across the entire customer journey, which requires a single Customer Agent, full control to experiment and learn, and full-stack vertical AI trained specifically for customer experience."}]},{"@type":"ImageObject","@id":"https://fin.ai/#primaryimage","inLanguage":"en","url":"https://fin.ai/img/social/home-v2.jpg","contentUrl":"https://fin.ai/img/social/home-v2.jpg","caption":"The #1 AI Agent for all your customer service"},{"@type":"WebSite","@id":"https://fin.ai/#website","url":"https://fin.ai/","name":"Fin","description":"One AI Customer Agent for Sales, Service, Support and Ecommerce. Featuring Fin AI Agent and Intercom Helpdesk.","publisher":{"@id":"https://fin.ai/#organization"},"inLanguage":"en","copyrightHolder":{"@id":"https://fin.ai/#organization"}},{"@type":["Organization","Brand"],"@id":"https://fin.ai/#organization","name":"Fin","alternateName":["Fin AI","Intercom"],"url":"https://fin.ai/","logo":{"@type":"ImageObject","inLanguage":"en","@id":"https://fin.ai/#logo","url":"https://fin.ai/favicons/favicon-black.png","contentUrl":"https://fin.ai/favicons/favicon-black.png","caption":"Fin Logo"},"image":{"@id":"https://fin.ai/#logo"},"description":"Fin is the Customer Agent company delivering perfect customer experiences – from support to sales to commerce.","foundingDate":"2011","sameAs":["https://www.linkedin.com/company/fin/","https://x.com/fin_ai","https://www.instagram.com/fin_customer_agent/","https://www.youtube.com/channel/UCJG0MvLP03kyzzAkD-w98aQ"],"contactPoint":[{"@type":"ContactPoint","contactType":"sales","url":"https://fin.ai/contact-sales"}],"subjectOf":[{"@id":"https://fin.ai/#app"},{"@id":"https://fin.ai/#video-anthropic"}]},{"@type":"SoftwareApplication","@id":"https://fin.ai/#app","name":"Fin AI Agent","url":"https://fin.ai/","applicationCategory":"CustomerSupportApplication","operatingSystem":"Web","inLanguage":["en"],"description":"Fin uses industry-leading capabilities to deliver accurate answers and resolve complex customer support queries across any channel—including email, live-chat, phone, and social.","featureList":["Industry-leading resolution rates, averaging 76% across 12,000+ customers","Runs on proprietary Apex 1.0 and Apex Flash AI models built for customer experience","Works across the entire customer journey, from Service to Sales to Ecommerce","Works natively across every channel including Voice, Chat, email, Slack and social","Integrates with every helpdesk, including Intercom, Salesforce, Hubspot and Freshdesk","Connects to your tech stack via API, Data Connectors and MCP","Resolves complex multi-step workflows via Procedures","Fully self-serve configuration of tone, behaviour and knowledge","Enterprise-grade trust and security: SOC2, ISO 27001, ISO 42001, AIUC-1, ISO 27701 and HIPAA","Testing suite with simulations and regression testing","Observability suite with AI-powered Insights and QA","Fin Operator to orchestrate and automate customer operations","Outcome-based pricing — only pay when Fin delivers value"],"publisher":{"@id":"https://fin.ai/#organization"},"isPartOf":{"@id":"https://fin.ai/#website"},"offers":{"@type":"Offer","url":"https://fin.ai/pricing","priceCurrency":"USD","priceSpecification":{"@type":"UnitPriceSpecification","price":0.99,"unitText":"Per Outcome"},"availability":"https://schema.org/InStock"}},{"@type":"VideoObject","@id":"https://fin.ai/#video-anthropic","name":"Build vs. buy: Why Anthropic chose Fin","description":"If you're debating whether to build your own AI solution or buy one, my advice would be to buy – and specifically, buy Fin.","embedUrl":"https://fast.wistia.com/embed/iframe/2px6q5pt0a","thumbnailUrl":"https://fin.ai/img/home/anthropic-thumbnail.webp","uploadDate":"2024-04-10T02:13:00-07:00","duration":"PT2M18S","inLanguage":"en","publisher":{"@id":"https://fin.ai/#organization"},"isPartOf":{"@id":"https://fin.ai"},"potentialAction":{"@type":"WatchAction","target":"https://fast.wistia.com/embed/iframe/2px6q5pt0a"}}]}]</script><!--$--><!--/$--><main class="home-v2-page bg-off-white relative overflow-hidden" data-page-theme="light"><div class="container relative"><div class="contents" data-experiment="team-web-fin-ai-home-hero-centered" data-experiment-variant="control" data-experiment-allocation="allocation-169848"><section data-analytics-region="Hero" data-analytics-id="sec_home_hero" class="xl:mt-16.5 mt-14.5 relative grid grid-cols-12 gap-y-6 pt-12 lg:h-[65vh] lg:max-h-[600px] lg:gap-y-6 lg:pt-12"><div class="col-span-full lg: