an-2\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"fill\":\"none\",\"viewBox\":\"0 0 507 88\",\"className\":\"h-auto w-[120px] opacity-60 lg:ml-8\",\"children\":[[\"$\",\"g\",null,{\"fill\":\"currentColor\",\"clipPath\":\"url(#growth-unhinged_svg__a)\",\"children\":[\"$\",\"path\",null,{\"d\":\"$c8\"}]}],\"$Lc9\"]}]}],\"$Lca\",\"$Lcb\",\"$Lcc\"]}]]}]}]}]\n82:[\"$\",\"div\",null,{\"id\":\"customer-agent\",\"className\":\"relative grid scroll-mt-[130px] grid-cols-12 overflow-hidden py-10 lg:py-16\",\"data-chapter-name\":\"Customer Agent\",\"data-chapter-analytics-id\":\"btn_home_chapter_customer_agent\",\"data-analytics-region\":\"customer-agent\",\"data-analytics-id\":\"sec_home_customer_agent\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"md:px-0! container col-span-full md:col-span-10 md:col-start-2\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative grid grid-cols-10 gap-x-4 gap-y-6 lg:gap-y-10\",\"children\":[\"$\",\"div\",null,{\"className\":\"col-span-full grid grid-cols-subgrid gap-y-6 lg:gap-y-10\",\"children\":[[\"$\",\"div\",null,{\"className\":\"col-span-full lg:col-span-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"text-body-lg font-serif max-w-none\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-callout home-v2-reason-title relative mb-4 mr-5 text-pretty font-sans lg:max-w-152\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-5 xl:absolute xl:right-full xl:top-0 xl:mr-10 2xl:mr-16\",\"children\":[\"$\",\"$L65\",null,{\"label\":\"22\"}]}],\"Fin has the most compelling vision and plan for the future\"]}],[\"$\",\"p\",null,{\"className\":\"home-v2-reason-body text-current/80 text-pretty lg:grid lg:grid-cols-2 lg:gap-x-4\",\"children\":[[\"$\",\"span\",null,{\"className\":\"block\",\"children\":[[\"$\",\"span\",null,{\"className\":\"block\",\"children\":\"Three years ago, Fin was launched as the first Agent for Customer Service, thereby creating the Service Agent category.\"}],[\"$\",\"span\",null,{\"className\":\"mt-4 block\",\"children\":\"We are now pioneering the next big leap, making perfect customer experiences truly possible across the entire customer journey.\"}]]}],[\"$\",\"span\",null,{\"className\":\"mt-4 block lg:mt-0\",\"children\":[[\"$\",\"span\",null,{\"className\":\"block\",\"children\":\"This vision requires three things that only Fin can provide:\"}],[\"$\",\"span\",null,{\"className\":\"mt-6 flex flex-col gap-y-4 lg:mt-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"flex items-start gap-x-6\",\"children\":[[\"$\",\"span\",null,{\"className\":\"bg-current/10 mt-1 flex size-[18px] shrink-0 items-center justify-center rounded-full text-[13px] leading-none text-black\",\"children\":\"1\"}],[\"$\",\"span\",null,{\"children\":\"You need a single Customer Agent to deliver seamless experiences\"}]]}],[\"$\",\"span\",null,{\"className\":\"flex items-start gap-x-6\",\"children\":[[\"$\",\"span\",null,{\"className\":\"bg-current/10 mt-1 flex size-[18px] shrink-0 items-center justify-center rounded-full text-[13px] leading-none text-black\",\"children\":\"2\"}],[\"$\",\"span\",null,{\"children\":\"You need full control of everything, so you can experiment fast and learn\"}]]}],[\"$\",\"span\",null,{\"className\":\"flex items-start gap-x-6\",\"children\":[[\"$\",\"span\",null,{\"className\":\"bg-current/10 mt-1 flex size-[18px] shrink-0 items-center justify-center rounded-full text-[13px] leading-none text-black\",\"children\":\"3\"}],[\"$\",\"span\",null,{\"children\":\"You need full stack, vertical AI, trained specifically for customer experience\"}]]}]]}]]}]]}]]}]}],[\"$\",\"div\",null,{\"className\":\"col-span-full lg:col-span-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative aspect-video w-full\",\"children\":[[\"$\",\"$L68\",null,{\"analyticsId\":\"evt_home_v2_vision_video\",\"video\":{\"id\":\"90ol83ma94\",\"url\":\"https://fast.wistia.com/embed/medias/90ol83ma94.m3u8\",\"title\":\"\",\"captions\":\"