="0" stroke-dasharray="650" stroke-dashoffset="650"></rect></svg><svg class="z-2 absolute -bottom-[0.5px] -left-[0.5px] -right-[0.5px] -top-[0.5px] h-[calc(100%+1px)] w-[calc(100%+1px)] overflow-visible" preserveAspectRatio="none"><rect x="0" y="0" width="100%" height="100%" fill="none" stroke="transparent" stroke-width="1" stroke-opacity="0" stroke-dasharray="15 500"></rect></svg><div class="duration-400 flex h-full w-full items-center justify-center transition-[opacity,background-color] opacity-40"></div><div class="absolute h-3 w-0.5 lg:h-4 -bottom-px translate-y-3 lg:translate-y-4"><svg class="h-full w-full" viewBox="0 0 1 16" preserveAspectRatio="none"><line x1="0" y1="0" x2="0" y2="16" stroke="rgba(0,0,0,0.2)" stroke-width="1" stroke-dasharray="16" stroke-dashoffset="16"></line></svg></div></div></div></div></div></div></div><div aria-hidden="true" data-dot-decorators="true" class="pointer-events-none absolute inset-0 m-3 xl:m-4 m-0! text-off-black/10 *:size-2"><span class="absolute size-2 bg-current top-0 left-0"></span><span class="absolute size-2 bg-current top-0 right-0"></span><span class="absolute size-2 bg-current bottom-0 left-0"></span><span class="absolute size-2 bg-current bottom-0 right-0"></span></div></div></div><div class="col-span-full flex flex-col lg:col-span-4 lg:col-start-7 lg:row-start-2 xl:col-span-3 xl:col-start-8"><div class="mt-auto flex flex-col gap-6"><div class="border-current/10 flex flex-col gap-2 border-t pt-2"><span class="text-label-lg text-current/80 font-mono">[ <!-- -->Matterport<!-- --> ]</span></div><p class="text-body text-current/60">“<!-- -->Fin for Salesforce has been a game-changer. Fin&#x27;s seamless integration meant no disruption to our existing setup, leading to faster customer responses.<!-- -->”</p><div class="flex items-start gap-2.5"><span class="text-label-lg text-current/80 font-mono uppercase">Arminder Singh<!-- -->, <!-- -->Vice President, Customer Support</span></div></div></div></div></div></div></div><div id="customize" class="relative grid scroll-mt-[130px] grid-cols-12 overflow-hidden py-10 lg:py-16" data-chapter-name="Customize" data-chapter-analytics-id="btn_home_chapter_customize" data-analytics-region="customize" data-analytics-id="sec_home_customize"><div class="md:px-0! container col-span-full md:col-span-10 md:col-start-2"><div class="relative grid grid-cols-10 gap-x-4 gap-y-6 lg:gap-y-10"><div class="col-span-full grid grid-cols-subgrid gap-y-6 lg:items-start lg:gap-y-10"><div class="col-span-full lg:col-span-5 lg:col-start-1"><div class="text-body-lg font-serif"><p class="text-callout home-v2-reason-title relative mb-4 mr-5 text-pretty font-sans"><span class="mr-5 xl:absolute xl:right-full xl:top-0 xl:mr-10 2xl:mr-16"><span class="inline-flex overflow-hidden"><span class="inline-block" style="opacity:0;transform:translateY(1em);transition:opacity 800ms cubic-bezier(0.33, 0, 0.25, 1), transform 1000ms cubic-bezier(0.33, 0, 0.25, 1);transition-delay:0ms">1</span><span class="inline-block" style="opacity:0;transform:translateY(1em);transition:opacity 800ms cubic-bezier(0.33, 0, 0.25, 1), transform 1000ms cubic-bezier(0.33, 0, 0.25, 1);transition-delay:80ms">0</span></span></span>Fin gives you full confidence because you&#x27;re in control</p><p class="home-v2-reason-body text-current/80 text-pretty"><span class="block">Because every business is unique, Fin is built to put you in control.</span><span class="mt-4 block">Fin is the only Agent you can fully manage yourself, configuring tone, behavior, knowledge and more, all without needing any engineering resources.</span><span class="mt-4 block">This empowers you to experiment and learn, quickly. Unlike competitors, you never need to contact us to make changes to any part of the system. Every aspect of configuring and customising Fin is designed to be easy to do by yourself.</span></p></div></div><div class="bg-chalk relative col-span-full lg:col-span-5 lg:col-start-6"><div class="relative"><div class="@container size-full"><div class="relative overflow-hidden aspect-square"><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F4bgok82s%2Fmonorepo-static-assets%2F3392db4925a41d160b40dc2b3c375ed1b7768f1a-1851x1851.webp&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F4bgok82s%2Fmonorepo-static-assets%2F3392db4925a41d160b40dc2b3c375ed1b7768f1a-1851x1851.webp&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F4bgok82s%2Fmonorepo-static-assets%2F3392db4925a41d160b40dc2b3c375ed1b7768f1a-1851x1851.webp&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F4bgok82s%2Fmonorepo-static-assets%2F3392db4925a41d160b40dc2b3c375ed1b7768f1a-1851x1851.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F4bgok82s%2Fmonorepo-static-assets%2F3392db4925a41d160b40dc2b3c375ed1b7768f1a-1851x1851.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F4bgok82s%2Fmonorepo-static-assets%2F3392db4925a41d160b40dc2b3c375ed1b7768f1a-1851x1851.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F4bgok82s%2Fmonorepo-static-assets%2F3392db4925a41d160b40dc2b3c375ed1b7768f1a-1851x1851.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F4bgok82s%2Fmonorepo-static-assets%2F3392db4925a41d160b40dc2b3c375ed1b7768f1a-1851x1851.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F4bgok82s%2Fmonorepo-static-assets%2F3392db4925a41d160b40dc2b3c375ed1b7768f1a-1851x1851.webp&amp;w=3840&amp;q=75"/><div class="relative size-full"><img alt="Configure Fin&#x27;s tone, behavior, and knowledge without needing engineering resources on your own" loading="lazy" d