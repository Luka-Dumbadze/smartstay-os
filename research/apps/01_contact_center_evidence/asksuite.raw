t':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=!0;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f)})(window,document,'script','dataLayer','GTM-MCQ67CS')</script> </head><body class="home wp-singular page-template page-template-elementor_header_footer page page-id-65361 wp-custom-logo wp-embed-responsive wp-theme-hello-elementor wp-child-theme-hello-elementor-child hello-elementor-default elementor-default elementor-template-full-width elementor-kit-80 elementor-page elementor-page-65361"><noscript><iframe data-lazyloaded="1" src="about:blank" data-litespeed-src="https://www.googletagmanager.com/ns.html?id=GTM-MCQ67CS"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript><a class="skip-link screen-reader-text" href="#content">Skip to content</a><header data-elementor-type="header" data-elementor-id="1009" class="elementor elementor-1009 elementor-location-header" data-elementor-post-type="elementor_library"><div class="elementor-element elementor-element-ff20289 e-con-full e-flex e-con e-parent" data-id="ff20289" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;,&quot;position&quot;:&quot;fixed&quot;}"><div class="elementor-element elementor-element-def0964 elementor-widget elementor-widget-html" data-id="def0964" data-element_type="widget" data-e-type="widget" data-widget_type="html.default"><div class="elementor-widget-container"><p class="link-top" style="margin-bottom: 0px;"><img src="/wp-content/uploads/2026/05/estrelas.png"/ style="width: 70px; margin-right: 7px;">  4.9/5  <img src="/wp-content/uploads/2026/05/logo-topbar.png" style="width: 13px;vertical-align: text-bottom; margin: 0px 10px;" fetchpriority="high" decoding="sync"/>  HotelTechReport - with +970 verified reviews</p></div></div></div><div class="elementor-element elementor-element-5b81e81 e-flex e-con-boxed e-con e-parent" data-id="5b81e81" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;,&quot;animation&quot;:&quot;none&quot;,&quot;position&quot;:&quot;fixed&quot;}"><div class="e-con-inner"><div class="elementor-element elementor-element-04c3961 elementor-widget-mobile__width-auto elementor-widget elementor-widget-theme-site-logo elementor-widget-image" data-id="04c3961" data-element_type="widget" data-e-type="widget" data-widget_type="theme-site-logo.default"><div class="elementor-widget-container">
<a href="https://asksuite.com">
<img width="181" height="38" src="https://asksuite.com/wp-content/uploads/2020/02/aks.svg" class="attachment-full size-full wp-image-229" alt="aks" fetchpriority="high" decoding="sync"/>				</a></div></div><div class="elementor-element elementor-element-0f063f0 elementor-widget__width-initial elementor-hidden-desktop elementor-hidden-tablet elementor-widget elementor-widget-button" data-id="0f063f0" data-element_type="widget" data-e-type="widget" data-widget_type="button.default"><div class="elementor-widget-container"><div class="elementor-button-wrapper">
<a class="elementor-button elementor-button-link elementor-size-sm elementor-animation-float" href="https://content.asksuite.com/en-hr-demo-asksuite-11-2024/?utm_medium=referral&#038;utm_source=site-home-en" target="_blank">
<span class="elementor-button-content-wrapper">
<span class="elementor-button-text">book a demo</span>
</span>
</a></div></div></div><div class="elementor-element elementor-element-1ec3961 elementor-widget elementor-widget-shortcode" data-id="1ec3961" data-element_type="widget" data-e-type="widget" data-widget_type="shortcode.default"><div class="elementor-widget-container"><div class="elementor-shortcode"><style>/* ============================================================
       ASKSUITE MEGA MENU
       Reset agressivo para neutralizar estilos de botão do Elementor/tema
       ============================================================ */
    .asksuite-mm,
    .asksuite-mm * { box-sizing: border-box; }

    .asksuite-mm {
        --as-orange: #FF5617;
        --as-orange-2: #FF5722;
        --as-text: #1F2937;
        --as-text-light: #6B7280;
        --as-bg-panel: #F3F4F6;
        --as-border: #E5E7EB;
        font-family: inherit;
        position: relative;
        display: flex;
        align-items: center;
    }

    /* RESET AGRESSIVO para botões (sobrescreve estilos globais do tema/Elementor) */
    .asksuite-mm button.asksuite-mm__toggle,
    .asksuite-mm button.asksuite-mm__link,
    .asksuite-mm button.asksuite-mm__link--toggle {
        background: transparent !important;
        background-color: transparent !important;
        background-image: none !important;
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        text-shadow: none !important;
        color: inherit !important;
        padding: 0;
        margin: 0;
        font-family: inherit;
        cursor: pointer;
        line-height: 1.2;
        text-transform: none !important;
        letter-spacing: normal !important;
        appearance: none;
        -webkit-appearance: none;
    }
    .asksuite-mm button.asksuite-mm__link:hover,
    .asksuite-mm button.asksuite-mm__link:focus,
    .asksuite-mm button.asksuite-mm__link:active,
    .asksuite-mm button.asksuite-mm__toggle:hover,
    .asksuite-mm button.asksuite-mm__toggle:focus,
    .asksuite-mm button.asksuite-mm__toggle:active {
        background: transparent !important;
        background-color: transparent !important;
        background-image: none !important;
        box-shadow: none !important;
        outline: 0;
        transform: none !important;
    }

    /* Toggle (mobile burger) */
    .asksuite-mm__toggle {
        display: none;
        flex-direction: column;
        gap: 5px;
        padding: 8px !important;
        margin-left: auto;
    }
    .asksuite-mm__toggle span {
        display: block;
        width: 24px;
        height: 2px;
        background: var(--as-text) !important;
        border-radius: 2px;
        transition: transform .25s ease, opacity .25s ease;
    }
    .asksuite-mm__toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .asksuite-mm__toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .asksuite-mm__toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .asksuite-mm__wrapper {
        display: flex;
        align-items: center;
    }

    /* Top-level items */
    .asksuite-mm__items {
        list-style: none !important;
        margin: 0 !important;
        padding: 0 !important;
        display: flex;
        gap: 8px;
    }
    .asksuite-mm__items > li {
        margin: 0 !important;
        padding: 0 !important;
        list-style: none !important;
    }
    .asksuite-mm__items > li::before,
    .asksuite-mm__items > li::marker { display: none !important; content: none !important; }

    /* RESET GLOBAL de ::marker e ::before em TODOS os <li> internos do menu
       (neutraliza a setinha SVG injetada pelo tema/Elementor) */
    .asksuite-mm ul,
    .asksuite-mm ol {
        list-style: none !important;
        list-style-type: none !important;
        list-style-image: none !important;
    }
    .asksuite-mm li,
    .asksuite-mm ul li,
    .asksuite-mm ol li {
        list-style: none !important;
        list-style-type: none !important;
        list-style-image: none !important;
    }
    .asksuite-mm li::marker,
    .asksuite-mm ul li::marker,
    .asksuite-mm ol li::marker {
        content: none !important;
        display: none !important;
    }
    .asksuite-mm li::before,
    .asksuite-mm ul li::before,
    .asksuite-mm ol li::before {
        content: none !important;
        display: none !important;
        background: none !important;
        background-image: none !important;
    }

    .asksuite-mm__item { position: static; }

    .asksuite-mm__link {
        display: inline-flex !important;
        align-items: center;
        gap: 6px;
        padding: 10px 10px !important;
        font-size: 16px !important;
        font-weight: 500 !important;
        color: var(--as-text) !important;
        text-decoration: none !important;
        transition: color .2s ease;
        line-height: 1.2 !important;
        white-space: nowrap;
    }
    .asksuite-mm__link:hover,
    .asksuite-mm__link:focus,
    .asksuite-mm__link[aria-expanded="true"] {
        color: var(--as-orange) !important;
    }
    .asksuite-mm__chevron { transition: transform .25s ease; }
    .asksuite-mm__link[aria-expanded="true"] .asksuite-mm__chevron { transform: rotate(180deg); }

    /* ============================================================
       PANEL — fullwidth da viewport (quebra para fora do container)
       ============================================================ */
    .asksuite-mm__panel {
        position: fixed;
        top: 100px;
        left: 0;
        right: 0;
        width: 100vw;
        background: var(--as-bg-panel);
        border-top: 1px solid var(--as-border);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition: opacity .25s ease, transform .25s ease, visibility .25s;
        max-height: calc(100vh - var(--asksuite-mm-top, 80px));
        overflow-y: auto;
        z-index: 9998;
    }
    .asksuite-mm__item--has-panel:hover > .asksuite-mm__panel,
    .asksuite-mm__panel.is-open {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    .asksuite-mm__panel-inner {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        max-width: 1140px;
        margin: 0 auto;
        padding: 56px 32px;
        gap: 36px;
    }

    /* Intro */
    .asksuite-mm__intro { padding-right: 24px; }
    .asksuite-mm__intro-tag {
        display: inline-block;
        color: var(--as-orange);
        font-weight: 700;
        font-size: 16px;
        margin-bottom: 16px;
    }
    .asksuite-mm__intro-title {
        font-size: 24px !important;
        line-height: 1.2 !important;
        font-weight: 700 !important;
        color: var(--as-text) !important;
        margin: 0 0 20px !important;
    }
    .asksuite-mm__intro-text {
        font-size: 15px;
        line-height: 1.6;
        color: var(--as-text-light);
        margin: 0;
    }

    /* Columns */
    .asksuite-mm__columns {
        grid-column: 2 / 4;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
    }
    .asksuite-mm__column-title {
        font-size: 20px !important;
        font-weight: 700 !important;
        color: var(--as-text) !important;
        margin: 0 0 24px !important;
        line-height: 1.2 !important;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .asksuite-mm__column-title a {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--as-text) !important;
        text-decoration: none !important;
    }
    .asksuite-mm__column-title a:hover span { color: var(--as-orange) !important; }
    .asksuite-mm__column-title svg { flex-shrink: 0; }

    /* Lista padrão */
    .asksuite-mm__list {
        list-style: none !important;
        margin: 0 !important;
        padding: 0 !important;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }
    .asksuite-mm__list li {
        margin: 0 !important;
        padding: 0 !important;
        list-style: none !important;
    }
    .asksuite-mm__list li::before { display: none !important; content: none !important; }

    .asksuite-mm__list a {
        display: flex !important;
        align-items: center;
        gap: 10px;
        color: var(--as-text) !important;
        text-decoration: none !important;
        font-size: 16px !important;
        font-weight: 400 !important;
        line-height: 1.4 !important;
        transition: color .15s ease, transform .15s ease;
    }
    .asksuite-mm__list a:hover {
        color: var(--as-orange) !important;
        transform: translateX(2px);
    }
    .asksuite-mm__list a svg { flex-shrink: 0; }
    .asksuite-mm__list a.is-bold { font-weight: 600 !important; font-size: 17px !important; }

    /* Cards (Resources) */
    .asksuite-mm__cards {
        list-style: none !important;
        margin: 0 !important;
        padding: 0 !important;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    .asksuite-mm__cards li {
        margin: 0 !important;
        padding: 0 !important;
        list-style: none !important;
    }
    .asksuite-mm__card {
        display: flex !important;
        gap: 16px;
        align-items: flex-start;
        text-decoration: none !important;
        color: var(--as-text) !important;
        transition: transform .2s ease;
    }
    .asksuite-mm__card:hover { transform: translateX(3px); }
    .asksuite-mm__card img {
        width: 110px;
        height: 80px;
        object-fit: cover;
        border-radius: 8px;
        flex-shrink: 0;
    }
    .asksuite-mm__card-title {
        display: block;
        color: var(--as-orange) !important;
        font-weight: 700;
        font-size: 16px;
        margin-bottom: 6px;
    }
    .asksuite-mm__card p {
        margin: 0 !important;
        font-size: 13px !important;
        line-height: 1.5 !important;
        color: var(--as-text) !important;
    }

    /* Blocos (About us) */
    .asksuite-mm__blocks {
        list-style: none !important;
        margin: 0 !important;
        padding: 0 !important;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }
    .asksuite-mm__blocks li {
        margin: 0 !important;
        padding: 0 !important;
        list-style: none !important;
    }
    .asksuite-mm__block {
        display: block !important;
        text-decoration: none !important;
        color: var(--as-text) !important;
        transition: transform .2s ease;
    }
    .asksuite-mm__block:hover { transform: translateX(3px); }
    .asksuite-mm__block:hover h4 span { color: var(--as-orange) !important; }
    .asksuite-mm__block h4 {
        display: flex !important;
        align-items: center;
        gap: 10px;
        font-size: 20px !important;
        font-weight: 700 !important;
        margin: 0 0 12px !important;
        color: var(--as-text) !important;
        line-height: 1.2 !important;
    }
    .asksuite-mm__block p {
        margin: 0 !important;
        font-size: 15px !important;
        line-height: 1.5 !important;
        color: var(--as-text) !important;
        padding-left: 32px;
    }

    /* ============================================================
       RESPONSIVE — Tablet
       ============================================================ */
    @media (max-width: 1100px) {
        .asksuite-mm__panel-inner {
            grid-template-columns: 1fr;
            padding: 32px 24px;
            gap: 32px;
        }
        .asksuite-mm__columns { grid-column: 1; gap: 32px; }
        .asksuite-mm__intro-title { font-size: 24px !important; }
        .asksuite-mm__intro { padding-right: 0; }
    }

    /* ============================================================
       RESPONSIVE — Mobile
       ============================================================ */
    @media (max-width: 900px) {
        .asksuite-mm { width: 100%; }
        .asksuite-mm__toggle { display: flex; }

        .asksuite-mm__wrapper {
            position: fixed;
            top: 120px;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100vw;
            background: #fff;
            flex-direction: column;
            align-items: stretch;
            overflow-y: auto;
            padding-top: 10px;
            transform: translateX(100%);
            transition: transform .3s ease;
            z-index: 9999;
        }
        .asksuite-mm.is-open .asksuite-mm__wrapper { transform: translateX(0); }
        .asksuite-mm.is-open .asksuite-mm__toggle { position: fixed; top: 68px; right: 60px; z-index: 10000; }

        .asksuite-mm__items {
            flex-direction: column;
            gap: 0;
            width: 100%;
        }
        .asksuite-mm__item {
            border-bottom: 1px solid var(--as-border);
            width: 100%;
        }
        .asksuite-mm__link {
            width: 100% !important;
            justify-content: space-between;
            padding: 18px 24px !important;
            font-size: 17px !important;
        }

        .asksuite-mm__panel {
            position: static;
            opacity: 1;
            visibility: visible;
            transform: none;
            max-height: 0;
            overflow: hidden;
            transition: max-height .3s ease;
            background: #FAFAFA;
            border-top: 0;
            width: 100%;
        }
        .asksuite-mm__panel.is-open { max-height: 3000px; }
        .asksuite-mm__item--has-panel:hover > .asksuite-mm__panel { max-height: 0; }
        .asksuite-mm__item--has-panel:hover > .asksuite-mm__panel.is-open { max-height: 3000px; }

        /* Força coluna única no mobile (intro + cada coluna empilhadas) */
        .asksuite-mm__panel-inner {
            grid-template-columns: 1fr !important;
            padding: 24px 24px 32px;
            gap: 28px;
        }
        .asksuite-mm__columns {
            grid-column: 1 !important;
            grid-template-columns: 1fr !important;
            gap: 28px;
        }
        .asksuite-mm__intro-tag { font-size: 14px; margin-bottom: 8px; }
        .asksuite-mm__intro-title { font-size: 20px !important; margin-bottom: 12px !important; }
        .asksuite-mm__intro-text { font-size: 14px; }
        .asksuite-mm__column-title { font-size: 17px !important; margin-bottom: 16px !important; }
        .asksuite-mm__card img { width: 80px; height: 60px; }
        .asksuite-mm__card-title { font-size: 15px; }
        .asksuite-mm__card p { font-size: 12px !important; }
        .asksuite-mm__block h4 { font-size: 17px !important; }
        .asksuite-mm__block p { font-size: 14px !important; }
    }</style><nav class="asksuite-mm" aria-label="Main navigation"><button type="button" class="asksuite-mm__toggle"
