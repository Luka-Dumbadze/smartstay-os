/_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F69965675da3174293646265f_rambla.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F69965675da3174293646265f_rambla.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F69965675da3174293646265f_rambla.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F69965675da3174293646265f_rambla.png&amp;w=3840&amp;q=75"/><div class="absolute inset-0 bg-radial from-black/45 via-black/25 via-45% to-black/10"></div><div class="absolute inset-0 flex items-center justify-center"><img src="https://ays3b2uw1tc81xyw.public.blob.vercel-storage.com/marketing-site/69965fa5aeae367edf32cee5_rambla-logo.png" alt="Rambla logo" class="max-h-[72px] max-w-[52%]"/></div></div><div class="px-3.5 pb-3 pt-4"><h3 class="font-header text-lg font-medium leading-snug text-text">Contactless property maintains high guest services with AI Agents.</h3><p class="mt-1.5 line-clamp-2 text-sm font-light text-text-secondary">As Rambla expanded across five contactless properties, AI Agents took on the majority of guest communication, now handling over 80% of outbound messages so the team can deliver fast, consistent service that guests expect. </p></div></a><a class="group flex flex-col rounded-[14px] border border-border bg-white p-1.5 w-[320px] shrink-0" aria-hidden="false" href="/case-studies/werfy-doubled-revenue-in-their-slowest-months"><div class="relative aspect-[1200/630] overflow-hidden rounded-[8px] bg-bg-elevated"><img alt="WERFY" loading="lazy" decoding="async" data-nimg="fill" class="photo-film object-cover transition-transform duration-300 group-hover:scale-[1.03]" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="320px