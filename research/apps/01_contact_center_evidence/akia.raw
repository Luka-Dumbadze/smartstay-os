2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F6841d540b8a5c04a6e4ec908_Revival%2520Hotels%2520bg.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F6841d540b8a5c04a6e4ec908_Revival%2520Hotels%2520bg.png&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F6841d540b8a5c04a6e4ec908_Revival%2520Hotels%2520bg.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F6841d540b8a5c04a6e4ec908_Revival%2520Hotels%2520bg.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F6841d540b8a5c04a6e4ec908_Revival%2520Hotels%2520bg.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F6841d540b8a5c04a6e4ec908_Revival%2520Hotels%2520bg.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F6841d540b8a5c04a6e4ec908_Revival%2520Hotels%2520bg.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F6841d540b8a5c04a6e4ec908_Revival%2520Hotels%2520bg.png&amp;w=3840&amp;q=75"/><div class="absolute inset-0 bg-radial from-black/45 via-black/25 via-45% to-black/10"></div><div class="absolute inset-0 flex items-center justify-center"><img src="https://ays3b2uw1tc81xyw.public.blob.vercel-storage.com/marketing-site/6841d54430f4dbeb3e9ef4a6_Revival%20Hotels%20Logo.png" alt="Revival Hotels logo" class="max-h-[72px] max-w-[52%]"/></div></div><div class="px-3.5 pb-3 pt-4"><h3 class="font-header text-lg font-medium leading-snug text-text">Revival Hotels is Pioneering &quot;Invisible Hospitality&quot; with Akia’s Guest Journey Platform</h3><p class="mt-1.5 line-clamp-2 text-sm font-light text-text-secondary">Revival Hotels uses Akia to power its Invisible Hospitality™ model—delivering high-touch, tech-enabled guest experiences with minimal staff by automating check-ins, messaging, access, and support across its portfolio.</p></div></a><a class="group flex flex-col rounded-[14px] border border-border bg-white p-1.5 w-[320px] shrink-0" aria-hidden="true" tabindex="-1" href="/case-studies/ai-agents-keep-guest-messaging-consistent-across-its-international-team"><div class="relative aspect-[1200/630] overflow-hidden rounded-[8px] bg-bg-elevated"><img alt="Habitue Homes" loading="lazy" decoding="async" data-nimg="fill" class="photo-film object-cover transition-transform duration-300 group-hover:scale-[1.03]" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="320px" srcSet="/_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=32&amp;q=75 32w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=48&amp;q=75 48w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=64&amp;q=75 64w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=96&amp;q=75 96w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=128&amp;q=75 128w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fhabitue-homes-property.jpg&amp;w=3840&amp;q=75"/><div class="absolute inset-0 bg-radial from-black/45 via-black/25 via-45% to-black/10"></div><div class="absolute inset-0 flex items-center justify-center"><img src="https://ays3b2uw1tc81xyw.public.blob.vercel-storage.com/Habitue-homes-logo.png" alt="Habitue Homes logo" class="max-h-[72px] max-w-[52%]"/></div></div><div class="px-3.5 pb-3 pt-4"><h3 class="font-header text-lg font-medium leading-snug text-text">AI Agents keep guest messaging consistent across its international team.  </h3><p class="mt-1.5 line-clamp-2 text-sm font-light text-text-secondary">Different people, different countries, thousands of messages — all sounding the same. Akia&#x27;s AI Agent drafts every reply for Habitue Homes, pulling guest data from Streamline so each one&#x27;s accurate and it allows the team to get time back for other admin work.
</p></div></a><a class="group flex flex-col rounded-[14px] border border-border bg-white p-1.5 w-[320px] shrink-0" aria-hidden="true" tabindex="-1" href="/case-studies/how-an-eos-hospitality-property-manages-communication-for-their-hotel-and-the-spa-bookings"><div class="relative aspect-[1200/630] overflow-hidden rounded-[8px] bg-bg-elevated"><img alt="The Bellmoor Inn &amp; Spa" loading="lazy" decoding="async" data-nimg="fill" class="photo-film object-cover transition-transform duration-300 group-hover:scale-[1.03]" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="320px" srcSet="/_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fbellmoor-inn-spa.jpg&amp;w=32&amp;q=75 32w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fbellmoor-inn-spa.jpg&amp;w=48&amp;q=75 48w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fbellmoor-inn-spa.jpg&amp;w=64&amp;q=75 64w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fbellmoor-inn-spa.jpg&amp;w=96&amp;q=75 96w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fbellmoor-inn-spa.jpg&amp;w=128&amp;q=75 128w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fbellmoor-inn-spa.jpg&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fbellmoor-inn-spa.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fbellmoor-inn-spa.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fbellmoor-inn-spa.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fbellmoor-inn-spa.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fbellmoor-inn-sp