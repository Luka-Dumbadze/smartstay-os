=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F699e0c7d5c0c6afb080228a1_weekender-hotels-photo.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F699e0c7d5c0c6afb080228a1_weekender-hotels-photo.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F699e0c7d5c0c6afb080228a1_weekender-hotels-photo.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fays3b2uw1tc81xyw.public.blob.vercel-storage.com%2Fmarketing-site%2F699e0c7d5c0c6afb080228a1_weekender-hotels-photo.png&amp;w=3840&amp;q=75"/><div class="absolute inset-0 bg-radial from-black/45 via-black/25 via-45% to-black/10"></div><div class="absolute inset-0 flex items-center justify-center"><img src="https://ays3b2uw1tc81xyw.public.blob.vercel-storage.com/marketing-site/699e0c5231e9b0290ba2355b_weekender-hotels-logo.png" alt="Weekender Hotels logo" class="max-h-[72px] max-w-[52%]"/></div></div><div class="px-3.5 pb-3 pt-4"><h3 class="font-header text-lg font-medium leading-snug text-text">Weekender Hotels: Simplifying multi-property operations</h3><p class="mt-1.5 line-clamp-2 text-sm font-light text-text-secondary">Operating ten boutique properties, Weekender Hotels streamlined check-ins, messaging, digital guides, and guest workflows into one intuitive system that saves hours daily and keeps all guest data in one place for a complete view across properties.</p></div></a><a class="group flex flex-col rounded-[14px] border border-border bg-white p-1.5 w-[320px] shrink-0" aria-hidden="true" tabindex="-1" href="/case-studies/rambla-a-contactless-property-maintains-high-guest-services-with-ai-agents"><div class="relative aspect-[1200/630] overflow-hidden rounded-[8px] bg-bg-elevated"><img alt="Rambla" loading="lazy" decoding="async" data-nimg="fill" class="photo-film object-cover transition-transform duration-300 group-hove