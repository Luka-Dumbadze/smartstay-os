:text-white"><!--v-if--></div><!--]--></div><div><noscript data-nosnippet><div class="pb-4">
    <h2 class="text-lg font-bold mt-4">About this RFC</h2>
    <h3 class="text-sm font-bold mt-2">Details</h3>
    <dl>
      <dt class="font-bold mt-2">Updates (1)</dt><dd><a href="/info/rfc4021/" class="text-blue-300 dark:text-blue-100 hover:text-blue-500 dark:hover:text-blue-200 cursor-pointer underline">RFC 4021: Registration of Mail and MIME Header Fields</a>.</dd>
      <dt class="font-bold mt-2">Updated by (1)</dt><dd><a href="/info/rfc6854/" class="text-blue-300 dark:text-blue-100 hover:text-blue-500 dark:hover:text-blue-200 cursor-pointer underline">RFC 6854: Update to Internet Message Format to Allow Group Syntax in the &quot;From:&quot; and &quot;Sender:&quot; Header Fields</a>.</dd>
      <dt class="font-bold mt-2">Obsoletes (1)</dt><dd><a href="/info/rfc2822/" class="text-blue-300 dark:text-blue-100 hover:text-blue-500 dark:hover:text-blue-200 cursor-pointer underline">RFC 2822: Internet Message Format</a>.</dd>
      
      <dt class="font-bold mt-2">Date published</dt><dd>October 2008</dd>
