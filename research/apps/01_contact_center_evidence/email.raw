n":1408},{"href":1407},"#appendix-A.5",[1409],{"type":464,"textContent":1410},"Appendix A.5",{"type":464,"textContent":1412},".   White Space, Comments, and Other Oddities  . . . . ",{"type":459,"nodeName":467,"attributes":1414,"children":1416},{"href":1415},"#page-49",[1417],{"type":464,"textContent":1418},"49",{"type":464,"textContent":624},{"type":459,"nodeName":467,"attributes":1421,"children":1423},{"href":1422},"#appendix-A.6",[1424],{"type":464,"textContent":1425},"Appendix A.6",{"type":464,"textContent":1427},".   Obsoleted Forms  . . . . . . . . . . . . . . . . . ",{"type":459,"nodeName":467,"attributes":1429,"children":1431},{"href":1430},"#page-50",[1432],{"type":464,"textContent":1433},"50",{"type":464,"textContent":624},{"type":459,"nodeName":467,"attributes":1436,"children":1438},{"href":1437},"#appendix-A.6.1",[1439],{"type":464,"textContent":1440},"Appendix A.6.1",{"type":464,"textContent":1442},". Obsolete Addressing  . . . . . . . . . . . . . . . ",{"type":459,"nodeName":467,"attributes":1444,"children":1445},{"href":1430},[1446],{"type":464,"textContent":1433},{"type":464,"textContent":624},{"type":459,"nodeName":467,"attributes":1449,"children":1451},{"href":1450},"#appendix-A.6.2",[1452],{"type":464,"textContent":1453},"Appendix A.6.2",{"type":464,"textContent":1455},". Obsolete Dates . . . . . . . . . . . . . . . . . . ",{"type":459,"nodeName":467,"attributes":1457,"children":1458},{"href":1430},[1459],{"type":464,"textContent":1433},{"type":464,"textContent":624},{"type":459,"nodeName":467,"attributes":1462,"children":1464},{"href":1463},"#appendix-A.6.3",[1465],{"type":464,"textContent":1466},"Appendix A.6.3",{"type":464,"textContent":1468},". Obsolete White Space and Comments  . . . . . . . . ",{"type":459,"nodeName":467,"attributes":1470,"children":1472},{"href":1471},"#page-51",[1473],{"type":464,"textContent":1474},"51",{"type":464,"textContent":624},{"type":459,"nodeName":467,"attributes":1477,"children":1479},{"href":1478},"#appendix-B",[1480],{"type":464,"textContent":1481},"Appendix B",{"type":464,"textContent":1483},".     Differences from Earlier Specifications  . . . . . ",{"type":459,"nodeName":467,"attributes":1485,"children":1487},{"href":1486},"#page-52",[1488],{"type":464,"textContent":1489},"52",{"type":464,"textContent":624},{"type":459,"nodeName":467,"attributes":1492,"children":1494},{"href":1493},"#appendix-C",[1495],{"type":464,"textContent":1496},"Appendix C",{"type":464,"textContent":1498},".     Acknowledgements . . . . . . . . . . . . . . . . . ",{"type":459,"nodeName":467,"attributes":1500,"children":1502},{"href":1501},"#page-53",[1503],{"type":464,"textContent":1504},"53",{"type":464,"textContent":624},{"type":459,"nodeName":467,"attributes":1507,"children":1509},{"href":1508},"#section-7",[1510],{"type":464,"textContent":666},{"type":464,"textContent":1512},".  References . . . . . . . . . . . . . . . . . . . . . . . . . . ",{"type":459,"nodeName":467,"attributes":1514,"children":1516},{"href":1515},"#page-55",[1517],{"type":464,"textContent":1518},"55",{"type":464,"textContent":555},{"type":459,"nodeName":467,"attributes":1521,"children":1523},{"href":1522},"#section-7.1",[1524],{"type":464,"textContent":1525},"7.1",{"type":464,"textContent":1527},".  Normative References . . . . . . . . . . . . . . . . . . . ",{"type":459,"nodeName":467,"attributes":1529,"children":1530},{"href":1515},[1531],{"type":464,"textContent":1518},{"type":464,"textContent":555},{"type":459,"nodeName":467,"attributes":1534,"children":1536},{"href":1535},"#section-7.2",[1537],{"type":464,"textContent":1538},"7.2",{"type":464,"textContent":1540},".  Informative References . . . . . . . . . . . . . . . . . . ",{"type":459,"nodeName":467,"attributes":1542,"children":1543},{"href":1515},[1544],{"type":464,"textContent":1518},{"type":464,"textContent":1546},"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":1548,"children":1549},{"class":507},[1550],{"type":464,"textContent":1551},"Resnick                     Standards Track                     [Page 3]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":1554,"children":1555},{"class":516},[],{"type":459,"nodeName":460,"attributes":1557,"children":1558},{"class":520},[1559,1563,1564,1572,1574,1585,1587,1597,1599,1604,1606,1612,1614,1620,1622,1628,1630,1636,1637,1643,1645,1651,1653],{"type":459,"nodeName":484,"attributes":1560,"children":1562},{"id":1561},"page-4",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":1565,"children":1566},{"class":507},[1567,1571],{"type":459,"nodeName":467,"attributes":1568,"children":1569},{"href":532},[1570],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},"\n\n\n",{"type":459,"nodeName":484,"attributes":1575,"children":1577},{"class":1576},"h2",[1578,1583],{"type":459,"nodeName":467,"attributes":1579,"children":1581},{"class":1580,"id":99,"href":542},"selflink",[1582],{"type":464,"textContent":545},{"type":464,"textContent":1584},".  Introduction",{"type":464,"textContent":1586},"\n\n",{"type":459,"nodeName":484,"attributes":1588,"children":1590},{"class":1589},"h3",[1591,1595],{"type":459,"nodeName":467,"attributes":1592,"children":1593},{"class":1580,"id":105,"href":558},[1594],{"type":464,"textContent":561},{"type":464,"textContent":1596},".  Scope",{"type":464,"textContent":1598},"\n\n   This document specifies the Internet Message Format (IMF), a syntax\n   for text messages that are sent between computer users, within the\n   framework of \"electronic mail\" messages.  This specification is an\n   update to [",{"type":459,"nodeName":467,"attributes":1600,"children":1601},{"href":469},[1602],{"type":464,"textContent":1603},"RFC2822",{"type":464,"textContent":1605},"], which itself superseded [",{"type":459,"nodeName":467,"attributes":1607,"children":1609},{"href":1608},"\u002Finfo\u002Frfc0822\u002F",[1610],{"type":464,"textContent":1611},"RFC0822",{"type":464,"textContent":1613},"], updating it\n   to reflect current practice and incorporating incremental changes\n   that were specified in other RFCs such as [",{"type":459,"nodeName":467,"attributes":1615,"children":1617},{"href":1616},"\u002Finfo\u002Frfc1123\u002F",[1618],{"type":464,"textContent":1619},"RFC1123",{"type":464,"textContent":1621},"].\n\n   This document specifies a syntax only for text messages.  In\n   particular, it makes no provision for the transmission of images,\n   audio, or other sorts of structured data in electronic mail messages.\n   There are several extensions published, such as the MIME document\n   series ([",{"type":459,"nodeName":467,"attributes":1623,"children":1625},{"href":1624},"\u002Finfo\u002Frfc2045\u002F",[1626],{"type":464,"textContent":1627},"RFC2045",{"type":464,"textContent":1629},"], [",{"type":459,"nodeName":467,"attributes":1631,"children":1633},{"href":1632},"\u002Finfo\u002Frfc2046\u002F",[1634],{"type":464,"textContent":1635},"RFC2046",{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":1638,"children":1640},{"href":1639},"\u002Finfo\u002Frfc2049\u002F",[1641],{"type":464,"textContent":1642},"RFC2049",{"type":464,"textContent":1644},"]), which describe mechanisms\n   for the transmission of such data through electronic mail, either by\n   extending the syntax provided here or by structuring such messages to\n   conform to this syntax.  Those mechanisms are outside of the scope of\n   this specification.\n\n   In the context of electronic mail, messages are viewed as having an\n   envelope and contents.  The envelope contains whatever information is\n   needed to accomplish transmission and delivery.  (See [",{"type":459,"nodeName":467,"attributes":1646,"children":1648},{"href":1647},"\u002Finfo\u002Frfc5321\u002F",[1649],{"type":464,"textContent":1650},"RFC5321",{"type":464,"textContent":1652},"] for a\n   discussion of the envelope.)  The contents comprise the object to be\n   delivered to the recipient.  This specification applies only to the\n   format and some of the semantics of message contents.  It contains no\n   specification of the information in the envelope.\n\n   However, some message systems may use information from the contents\n   to create the envelope.  It is intended that this specification\n   facilitate the acquisition of such information by programs.\n\n   This specification is intended as a definition of what message\n   content format is to be passed between systems.  Though some message\n   systems locally store messages in this format (which eliminates the\n   need for translation between formats) and others use formats that\n   differ from the one specified in this specification, local storage is\n   outside of the scope of this specification.\n\n      Note: This specification is not intended to dictate the internal\n      formats used by sites, the specific message system features that\n      they are expected to support, or any of the characteristics of\n      user interface programs that create or read messages.  In\n      addition, this document does not specify an encoding of the\n      characters for either transport or storage; that is, it does not\n      specify the number of bits used or how those bits are specifically\n      transferred over the wire or stored on disk.\n\n\n\n",{"type":459,"nodeName":484,"attributes":1654,"children":1655},{"class":507},[1656],{"type":464,"textContent":1657},"Resnick                     Standards Track                     [Page 4]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":1660,"children":1661},{"class":516},[],{"type":459,"nodeName":460,"attributes":1663,"children":1664},{"class":520},[1665,1669,1670,1678,1679,1688,1689,1699,1701,1707,1709,1718,1720,1726,1728,1737,1739,1744,1746,1751,1753,1758,1760,1765,1767,1771,1773,1777,1779,1783,1785],{"type":459,"nodeName":484,"attributes":1666,"children":1668},{"id":1667},"page-5",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":1671,"children":1672},{"class":507},[1673,1677],{"type":459,"nodeName":467,"attributes":1674,"children":1675},{"href":532},[1676],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":1680,"children":1681},{"class":1589},[1682,1686],{"type":459,"nodeName":467,"attributes":1683,"children":1684},{"class":1580,"id":110,"href":571},[1685],{"type":464,"textContent":574},{"type":464,"textContent":1687},".  Notational Conventions",{"type":464,"textContent":1586},{"type":459,"nodeName":484,"attributes":1690,"children":1692},{"class":1691},"h4",[1693,1697],{"type":459,"nodeName":467,"attributes":1694,"children":1695},{"class":1580,"id":116,"href":587},[1696],{"type":464,"textContent":590},{"type":464,"textContent":1698},".  Requirements Notation",{"type":464,"textContent":1700},"\n\n   This document occasionally uses terms that appear in capital letters.\n   When the terms \"MUST\", \"SHOULD\", \"RECOMMENDED\", \"MUST NOT\", \"SHOULD\n   NOT\", and \"MAY\" appear capitalized, they are being used to indicate\n   particular requirements of this specification.  A discussion of the\n   meanings of these terms appears in [",{"type":459,"nodeName":467,"attributes":1702,"children":1704},{"href":1703},"\u002Finfo\u002Frfc2119\u002F",[1705],{"type":464,"textContent":1706},"RFC2119",{"type":464,"textContent":1708},"].\n\n",{"type":459,"nodeName":484,"attributes":1710,"children":1711},{"class":1691},[1712,1716],{"type":459,"nodeName":467,"attributes":1713,"children":1714},{"class":1580,"id":121,"href":600},[1715],{"type":464,"textContent":603},{"type":464,"textContent":1717},".  Syntactic Notation",{"type":464,"textContent":1719},"\n\n   This specification uses the Augmented Backus-Naur Form (ABNF)\n   [",{"type":459,"nodeName":467,"attributes":1721,"children":1723},{"href":1722},"\u002Finfo\u002Frfc5234\u002F",[1724],{"type":464,"textContent":1725},"RFC5234",{"type":464,"textContent":1727},"] notation for the formal definitions of the syntax of\n   messages.  Characters will be specified either by a decimal value\n   (e.g., the value %d65 for uppercase A and %d97 for lowercase A) or by\n   a case-insensitive literal value enclosed in quotation marks (e.g.,\n   \"A\" for either uppercase or lowercase A).\n\n",{"type":459,"nodeName":484,"attributes":1729,"children":1730},{"class":1691},[1731,1735],{"type":459,"nodeName":467,"attributes":1732,"children":1733},{"class":1580,"id":126,"href":613},[1734],{"type":464,"textContent":616},{"type":464,"textContent":1736},".  Structure of This Document",{"type":464,"textContent":1738},"\n\n   This document is divided into several sections.\n\n   This section, ",{"type":459,"nodeName":467,"attributes":1740,"children":1741},{"href":542},[1742],{"type":464,"textContent":1743},"section 1",{"type":464,"textContent":1745},", is a short introduction to the document.\n\n   ",{"type":459,"nodeName":467,"attributes":1747,"children":1748},{"href":627},[1749],{"type":464,"textContent":1750},"Section 2",{"type":464,"textContent":1752}," lays out the general description of a message and its\n   constituent parts.  This is an overview to help the reader understand\n   some of the general principles used in the later portions of this\n   document.  Any examples in this section MUST NOT be taken as\n   specification of the formal syntax of any part of a message.\n\n   ",{"type":459,"nodeName":467,"attributes":1754,"children":1755},{"href":739},[1756],{"type":464,"textContent":1757},"Section 3",{"type":464,"textContent":1759}," specifies formal ABNF rules for the structure of each part\n   of a message (the syntax) and describes the relationship between\n   those parts and their meaning in the context of a message (the\n   semantics).  That is, it lays out the actual rules for the structure\n   of each part of a message (the syntax) as well as a description of\n   the parts and instructions for their interpretation (the semantics).\n   This includes analysis of the syntax and semantics of subparts of\n   messages that have specific structure.  The syntax included in\n   ",{"type":459,"nodeName":467,"attributes":1761,"children":1762},{"href":739},[1763],{"type":464,"textContent":1764},"section 3",{"type":464,"textContent":1766}," represents messages as they MUST be created.  There are\n   also notes in ",{"type":459,"nodeName":467,"attributes":1768,"children":1769},{"href":739},[1770],{"type":464,"textContent":1764},{"type":464,"textContent":1772}," to indicate if any of the options specified\n   in the syntax SHOULD be used over any of the others.\n\n   Both sections ",{"type":459,"nodeName":467,"attributes":1774,"children":1775},{"href":627},[1776],{"type":464,"textContent":630},{"type":464,"textContent":1778}," and ",{"type":459,"nodeName":467,"attributes":1780,"children":1781},{"href":739},[1782],{"type":464,"textContent":742},{"type":464,"textContent":1784}," describe messages that are legal to generate\n   for purposes of this specification.\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":1786,"children":1787},{"class":507},[1788],{"type":464,"textContent":1789},"Resnick                     Standards Track                     [Page 5]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":1792,"children":1793},{"class":516},[],{"type":459,"nodeName":460,"attributes":1795,"children":1796},{"class":520},[1797,1801,1802,1810,1812,1817,1819,1823,1825,1830,1832,1836,1838,1842,1844,1848,1850,1859,1860,1869,1871,1877,1879,1883,1885,1889,1890,1896,1897,1901,1902,1908,1909,1915,1917],{"type":459,"nodeName":484,"attributes":1798,"children":1800},{"id":1799},"page-6",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":1803,"children":1804},{"class":507},[1805,1809],{"type":459,"nodeName":467,"attributes":1806,"children":1807},{"href":532},[1808],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1811},"\n\n\n   ",{"type":459,"nodeName":467,"attributes":1813,"children":1814},{"href":1042},[1815],{"type":464,"textContent":1816},"Section 4",{"type":464,"textContent":1818}," of this document specifies an \"obsolete\" syntax.  There are\n   references in ",{"type":459,"nodeName":467,"attributes":1820,"children":1821},{"href":739},[1822],{"type":464,"textContent":1764},{"type":464,"textContent":1824}," to these obsolete syntactic elements.  The\n   rules of the obsolete syntax are elements that have appeared in\n   earlier versions of this specification or have previously been widely\n   used in Internet messages.  As such, these elements MUST be\n   interpreted by parsers of messages in order to be conformant to this\n   specification.  However, since items in this syntax have been\n   determined to be non-interoperable or to cause significant problems\n   for recipients of messages, they MUST NOT be generated by creators of\n   conformant messages.\n\n   ",{"type":459,"nodeName":467,"attributes":1826,"children":1827},{"href":1265},[1828],{"type":464,"textContent":1829},"Section 5",{"type":464,"textContent":1831}," details security considerations to take into account when\n   implementing this specification.\n\n   ",{"type":459,"nodeName":467,"attributes":1833,"children":1834},{"href":1291},[1835],{"type":464,"textContent":1294},{"type":464,"textContent":1837}," lists examples of different sorts of messages.  These\n   examples are not exhaustive of the types of messages that appear on\n   the Internet, but give a broad overview of certain syntactic forms.\n\n   ",{"type":459,"nodeName":467,"attributes":1839,"children":1840},{"href":1478},[1841],{"type":464,"textContent":1481},{"type":464,"textContent":1843}," lists the differences between this specification and\n   earlier specifications for Internet messages.\n\n   ",{"type":459,"nodeName":467,"attributes":1845,"children":1846},{"href":1493},[1847],{"type":464,"textContent":1496},{"type":464,"textContent":1849}," contains acknowledgements.\n\n",{"type":459,"nodeName":484,"attributes":1851,"children":1852},{"class":1576},[1853,1857],{"type":459,"nodeName":467,"attributes":1854,"children":1855},{"class":1580,"id":131,"href":627},[1856],{"type":464,"textContent":630},{"type":464,"textContent":1858},".  Lexical Analysis of Messages",{"type":464,"textContent":1586},{"type":459,"nodeName":484,"attributes":1861,"children":1862},{"class":1589},[1863,1867],{"type":459,"nodeName":467,"attributes":1864,"children":1865},{"class":1580,"id":137,"href":642},[1866],{"type":464,"textContent":645},{"type":464,"textContent":1868},".  General Description",{"type":464,"textContent":1870},"\n\n   At the most basic level, a message is a series of characters.  A\n   message that is conformant with this specification is composed of\n   characters with values in the range of 1 through 127 and interpreted\n   as US-ASCII [",{"type":459,"nodeName":467,"attributes":1872,"children":1874},{"href":1873},"#ref-ANSI.X3-4.1986",[1875],{"type":464,"textContent":1876},"ANSI.X3-4.1986",{"type":464,"textContent":1878},"] characters.  For brevity, this document\n   sometimes refers to this range of characters as simply \"US-ASCII\n   characters\".\n\n      Note: This document specifies that messages are made up of\n      characters in the US-ASCII range of 1 through 127.  There are\n      other documents, specifically the MIME document series ([",{"type":459,"nodeName":467,"attributes":1880,"children":1881},{"href":1624},[1882],{"type":464,"textContent":1627},{"type":464,"textContent":1884},"],\n      [",{"type":459,"nodeName":467,"attributes":1886,"children":1887},{"href":1632},[1888],{"type":464,"textContent":1635},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":1891,"children":1893},{"href":1892},"\u002Finfo\u002Frfc2047\u002F",[1894],{"type":464,"textContent":1895},"RFC2047",{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":1898,"children":1899},{"href":1639},[1900],{"type":464,"textContent":1642},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":1903,"children":1905},{"href":1904},"\u002Finfo\u002Frfc4288\u002F",[1906],{"type":464,"textContent":1907},"RFC4288",{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":1910,"children":1912},{"href":1911},"\u002Finfo\u002Frfc4289\u002F",[1913],{"type":464,"textContent":1914},"RFC4289",{"type":464,"textContent":1916},"]), that\n      extend this specification to allow for values outside of that\n      range.  Discussion of those mechanisms is not within the scope of\n      this specification.\n\n   Messages are divided into lines of characters.  A line is a series of\n   characters that is delimited with the two characters carriage-return\n   and line-feed; that is, the carriage return (CR) character (ASCII\n   value 13) followed immediately by the line feed (LF) character (ASCII\n   value 10).  (The carriage return\u002Fline feed pair is usually written in\n   this document as \"CRLF\".)\n\n\n\n",{"type":459,"nodeName":484,"attributes":1918,"children":1919},{"class":507},[1920],{"type":464,"textContent":1921},"Resnick                     Standards Track                     [Page 6]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":1924,"children":1925},{"class":516},[],{"type":459,"nodeName":460,"attributes":1927,"children":1928},{"class":520},[1929,1933,1934,1942,1944,1953,1955,1959,1961,1965,1967],{"type":459,"nodeName":484,"attributes":1930,"children":1932},{"id":1931},"page-7",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":1935,"children":1936},{"class":507},[1937,1941],{"type":459,"nodeName":467,"attributes":1938,"children":1939},{"href":532},[1940],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1943},"\n\n\n   A message consists of header fields (collectively called \"the header\n   section of the message\") followed, optionally, by a body.  The header\n   section is a sequence of lines of characters with special syntax as\n   defined in this specification.  The body is simply a sequence of\n   characters that follows the header section and is separated from the\n   header section by an empty line (i.e., a line with nothing preceding\n   the CRLF).\n\n      Note: Common parlance and earlier versions of this specification\n      use the term \"header\" to either refer to the entire header section\n      or to refer to an individual header field.  To avoid ambiguity,\n      this document does not use the terms \"header\" or \"headers\" in\n      isolation, but instead always uses \"header field\" to refer to the\n      individual field and \"header section\" to refer to the entire\n      collection.\n\n",{"type":459,"nodeName":484,"attributes":1945,"children":1946},{"class":1691},[1947,1951],{"type":459,"nodeName":467,"attributes":1948,"children":1949},{"class":1580,"id":143,"href":655},[1950],{"type":464,"textContent":658},{"type":464,"textContent":1952},".  Line Length Limits",{"type":464,"textContent":1954},"\n\n   There are two limits that this specification places on the number of\n   characters in a line.  Each line of characters MUST be no more than\n   998 characters, and SHOULD be no more than 78 characters, excluding\n   the CRLF.\n\n   The 998 character limit is due to limitations in many implementations\n   that send, receive, or store IMF messages which simply cannot handle\n   more than 998 characters on a line.  Receiving implementations would\n   do well to handle an arbitrarily large number of characters in a line\n   for robustness sake.  However, there are so many implementations that\n   (in compliance with the transport requirements of [",{"type":459,"nodeName":467,"attributes":1956,"children":1957},{"href":1647},[1958],{"type":464,"textContent":1650},{"type":464,"textContent":1960},"]) do not\n   accept messages containing more than 1000 characters including the CR\n   and LF per line, it is important for implementations not to create\n   such messages.\n\n   The more conservative 78 character recommendation is to accommodate\n   the many implementations of user interfaces that display these\n   messages which may truncate, or disastrously wrap, the display of\n   more than 78 characters per line, in spite of the fact that such\n   implementations are non-conformant to the intent of this\n   specification (and that of [",{"type":459,"nodeName":467,"attributes":1962,"children":1963},{"href":1647},[1964],{"type":464,"textContent":1650},{"type":464,"textContent":1966},"] if they actually cause\n   information to be lost).  Again, even though this limitation is put\n   on messages, it is incumbent upon implementations that display\n   messages to handle an arbitrarily large number of characters in a\n   line (certainly at least up to the 998 character limit) for the sake\n   of robustness.\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":1968,"children":1969},{"class":507},[1970],{"type":464,"textContent":1971},"Resnick                     Standards Track                     [Page 7]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":1974,"children":1975},{"class":516},[],{"type":459,"nodeName":460,"attributes":1977,"children":1978},{"class":520},[1979,1983,1984,1992,1993,2002,2004,2009,2010,2014,2016,2020,2021,2025,2027,2036,2038,2043,2045,2050,2052,2061,2063,2067,2068,2072,2074,2079,2081,2085,2087,2096,2098],{"type":459,"nodeName":484,"attributes":1980,"children":1982},{"id":1981},"page-8",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":1985,"children":1986},{"class":507},[1987,1991],{"type":459,"nodeName":467,"attributes":1988,"children":1989},{"href":532},[1990],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":1994,"children":1995},{"class":1589},[1996,2000],{"type":459,"nodeName":467,"attributes":1997,"children":1998},{"class":1580,"id":148,"href":670},[1999],{"type":464,"textContent":673},{"type":464,"textContent":2001},".  Header Fields",{"type":464,"textContent":2003},"\n\n   Header fields are lines beginning with a field name, followed by a\n   colon (\":\"), followed by a field body, and terminated by CRLF.  A\n   field name MUST be composed of printable US-ASCII characters (i.e.,\n   characters that have values between 33 and 126, inclusive), except\n   colon.  A field body may be composed of printable US-ASCII characters\n   as well as the space (SP, ASCII value 32) and horizontal tab (HTAB,\n   ASCII value 9) characters (together known as the white space\n   characters, WSP).  A field body MUST NOT include CR and LF except\n   when used in \"folding\" and \"unfolding\", as described in ",{"type":459,"nodeName":467,"attributes":2005,"children":2006},{"href":711},[2007],{"type":464,"textContent":2008},"section",{"type":464,"textContent":624},{"type":459,"nodeName":467,"attributes":2011,"children":2012},{"href":711},[2013],{"type":464,"textContent":714},{"type":464,"textContent":2015},".  All field bodies MUST conform to the syntax described in\n   sections ",{"type":459,"nodeName":467,"attributes":2017,"children":2018},{"href":739},[2019],{"type":464,"textContent":742},{"type":464,"textContent":1778},{"type":459,"nodeName":467,"attributes":2022,"children":2023},{"href":1042},[2024],{"type":464,"textContent":553},{"type":464,"textContent":2026}," of this specification.\n\n",{"type":459,"nodeName":484,"attributes":2028,"children":2029},{"class":1691},[2030,2034],{"type":459,"nodeName":467,"attributes":2031,"children":2032},{"class":1580,"id":154,"href":685},[2033],{"type":464,"textContent":688},{"type":464,"textContent":2035},".  Unstructured Header Field Bodies",{"type":464,"textContent":2037},"\n\n   Some field bodies in this specification are defined simply as\n   \"unstructured\" (which is specified in ",{"type":459,"nodeName":467,"attributes":2039,"children":2040},{"href":838},[2041],{"type":464,"textContent":2042},"section 3.2.5",{"type":464,"textContent":2044}," as any printable\n   US-ASCII characters plus white space characters) with no further\n   restrictions.  These are referred to as unstructured field bodies.\n   Semantically, unstructured field bodies are simply to be treated as a\n   single line of characters with no further processing (except for\n   \"folding\" and \"unfolding\" as described in ",{"type":459,"nodeName":467,"attributes":2046,"children":2047},{"href":711},[2048],{"type":464,"textContent":2049},"section 2.2.3",{"type":464,"textContent":2051},").\n\n",{"type":459,"nodeName":484,"attributes":2053,"children":2054},{"class":1691},[2055,2059],{"type":459,"nodeName":467,"attributes":2056,"children":2057},{"class":1580,"id":159,"href":698},[2058],{"type":464,"textContent":701},{"type":464,"textContent":2060},".  Structured Header Field Bodies",{"type":464,"textContent":2062},"\n\n   Some field bodies in this specification have a syntax that is more\n   restrictive than the unstructured field bodies described above.\n   These are referred to as \"structured\" field bodies.  Structured field\n   bodies are sequences of specific lexical tokens as described in\n   sections ",{"type":459,"nodeName":467,"attributes":2064,"children":2065},{"href":739},[2066],{"type":464,"textContent":742},{"type":464,"textContent":1778},{"type":459,"nodeName":467,"attributes":2069,"children":2070},{"href":1042},[2071],{"type":464,"textContent":553},{"type":464,"textContent":2073}," of this specification.  Many of these tokens are\n   allowed (according to their syntax) to be introduced or end with\n   comments (as described in ",{"type":459,"nodeName":467,"attributes":2075,"children":2076},{"href":793},[2077],{"type":464,"textContent":2078},"section 3.2.2",{"type":464,"textContent":2080},") as well as the white space\n   characters, and those white space characters are subject to \"folding\"\n   and \"unfolding\" as described in ",{"type":459,"nodeName":467,"attributes":2082,"children":2083},{"href":711},[2084],{"type":464,"textContent":2049},{"type":464,"textContent":2086},".  Semantic analysis of\n   structured field bodies is given along with their syntax.\n\n",{"type":459,"nodeName":484,"attributes":2088,"children":2089},{"class":1691},[2090,2094],{"type":459,"nodeName":467,"attributes":2091,"children":2092},{"class":1580,"id":164,"href":711},[2093],{"type":464,"textContent":714},{"type":464,"textContent":2095},".  Long Header Fields",{"type":464,"textContent":2097},"\n\n   Each header field is logically a single line of characters comprising\n   the field name, the colon, and the field body.  For convenience\n   however, and to deal with the 998\u002F78 character limitations per line,\n   the field body portion of a header field can be split into a\n   multiple-line representation; this is called \"folding\".  The general\n   rule is that wherever this specification allows for folding white\n   space (not simply WSP characters), a CRLF may be inserted before any\n   WSP.\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2099,"children":2100},{"class":507},[2101],{"type":464,"textContent":2102},"Resnick                     Standards Track                     [Page 8]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2105,"children":2106},{"class":516},[],{"type":459,"nodeName":460,"attributes":2108,"children":2109},{"class":520},[2110,2114,2115,2123,2125,2134,2136,2140,2141,2145,2146,2150,2151,2155,2156,2160,2162],{"type":459,"nodeName":484,"attributes":2111,"children":2113},{"id":2112},"page-9",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2116,"children":2117},{"class":507},[2118,2122],{"type":459,"nodeName":467,"attributes":2119,"children":2120},{"href":532},[2121],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2124},"\n\n\n   For example, the header field:\n\n   Subject: This is a test\n\n   can be represented as:\n\n   Subject: This\n    is a test\n\n      Note: Though structured field bodies are defined in such a way\n      that folding can take place between many of the lexical tokens\n      (and even within some of the lexical tokens), folding SHOULD be\n      limited to placing the CRLF at higher-level syntactic breaks.  For\n      instance, if a field body is defined as comma-separated values, it\n      is recommended that folding occur after the comma separating the\n      structured items in preference to other places where the field\n      could be folded, even if it is allowed elsewhere.\n\n   The process of moving from this folded multiple-line representation\n   of a header field to its single line representation is called\n   \"unfolding\".  Unfolding is accomplished by simply removing any CRLF\n   that is immediately followed by WSP.  Each header field should be\n   treated in its unfolded form for further syntactic and semantic\n   evaluation.  An unfolded header field has no length restriction and\n   therefore may be indeterminately long.\n\n",{"type":459,"nodeName":484,"attributes":2126,"children":2127},{"class":1589},[2128,2132],{"type":459,"nodeName":467,"attributes":2129,"children":2130},{"class":1580,"id":169,"href":724},[2131],{"type":464,"textContent":727},{"type":464,"textContent":2133},".  Body",{"type":464,"textContent":2135},"\n\n   The body of a message is simply lines of US-ASCII characters.  The\n   only two limitations on the body are as follows:\n\n   o  CR and LF MUST only occur together as CRLF; they MUST NOT appear\n      independently in the body.\n   o  Lines of characters in the body MUST be limited to 998 characters,\n      and SHOULD be limited to 78 characters, excluding the CRLF.\n\n      Note: As was stated earlier, there are other documents,\n      specifically the MIME documents ([",{"type":459,"nodeName":467,"attributes":2137,"children":2138},{"href":1624},[2139],{"type":464,"textContent":1627},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":2142,"children":2143},{"href":1632},[2144],{"type":464,"textContent":1635},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":2147,"children":2148},{"href":1639},[2149],{"type":464,"textContent":1642},{"type":464,"textContent":1884},{"type":459,"nodeName":467,"attributes":2152,"children":2153},{"href":1904},[2154],{"type":464,"textContent":1907},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":2157,"children":2158},{"href":1911},[2159],{"type":464,"textContent":1914},{"type":464,"textContent":2161},"]), that extend (and limit) this specification\n      to allow for different sorts of message bodies.  Again, these\n      mechanisms are beyond the scope of this document.\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2163,"children":2164},{"class":507},[2165],{"type":464,"textContent":2166},"Resnick                     Standards Track                     [Page 9]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2169,"children":2170},{"class":516},[],{"type":459,"nodeName":460,"attributes":2172,"children":2173},{"class":520},[2174,2178,2179,2187,2188,2197,2198,2206,2208,2212,2214,2220,2221,2226,2228,2233,2235,2239,2241,2245,2247,2256,2258,2262,2264,2273,2275],{"type":459,"nodeName":484,"attributes":2175,"children":2177},{"id":2176},"page-10",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2180,"children":2181},{"class":507},[2182,2186],{"type":459,"nodeName":467,"attributes":2183,"children":2184},{"href":532},[2185],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":2189,"children":2190},{"class":1576},[2191,2195],{"type":459,"nodeName":467,"attributes":2192,"children":2193},{"class":1580,"id":174,"href":739},[2194],{"type":464,"textContent":742},{"type":464,"textContent":2196},".  Syntax",{"type":464,"textContent":1586},{"type":459,"nodeName":484,"attributes":2199,"children":2200},{"class":1589},[2201,2205],{"type":459,"nodeName":467,"attributes":2202,"children":2203},{"class":1580,"id":180,"href":754},[2204],{"type":464,"textContent":757},{"type":464,"textContent":1584},{"type":464,"textContent":2207},"\n\n   The syntax as given in this section defines the legal syntax of\n   Internet messages.  Messages that are conformant to this\n   specification MUST conform to the syntax in this section.  If there\n   are options in this section where one option SHOULD be generated,\n   that is indicated either in the prose or in a comment next to the\n   syntax.\n\n   For the defined expressions, a short description of the syntax and\n   use is given, followed by the syntax in ABNF, followed by a semantic\n   analysis.  The following primitive tokens that are used but otherwise\n   unspecified are taken from the \"Core Rules\" of [",{"type":459,"nodeName":467,"attributes":2209,"children":2210},{"href":1722},[2211],{"type":464,"textContent":1725},{"type":464,"textContent":2213},"], ",{"type":459,"nodeName":467,"attributes":2215,"children":2217},{"href":2216},"#appendix-B.1",[2218],{"type":464,"textContent":2219},"Appendix",{"type":464,"textContent":624},{"type":459,"nodeName":467,"attributes":2222,"children":2223},{"href":2216},[2224],{"type":464,"textContent":2225},"B.1",{"type":464,"textContent":2227},": CR, LF, CRLF, HTAB, SP, WSP, DQUOTE, DIGIT, ALPHA, and VCHAR.\n\n   In some of the definitions, there will be non-terminals whose names\n   start with \"obs-\".  These \"obs-\" elements refer to tokens defined in\n   the obsolete syntax in ",{"type":459,"nodeName":467,"attributes":2229,"children":2230},{"href":1042},[2231],{"type":464,"textContent":2232},"section 4",{"type":464,"textContent":2234},".  In all cases, these productions\n   are to be ignored for the purposes of generating legal Internet\n   messages and MUST NOT be used as part of such a message.  However,\n   when interpreting messages, these tokens MUST be honored as part of\n   the legal syntax.  In this sense, ",{"type":459,"nodeName":467,"attributes":2236,"children":2237},{"href":739},[2238],{"type":464,"textContent":1764},{"type":464,"textContent":2240}," defines a grammar for the\n   generation of messages, with \"obs-\" elements that are to be ignored,\n   while ",{"type":459,"nodeName":467,"attributes":2242,"children":2243},{"href":1042},[2244],{"type":464,"textContent":2232},{"type":464,"textContent":2246}," adds grammar for the interpretation of messages.\n\n",{"type":459,"nodeName":484,"attributes":2248,"children":2249},{"class":1589},[2250,2254],{"type":459,"nodeName":467,"attributes":2251,"children":2252},{"class":1580,"id":185,"href":767},[2253],{"type":464,"textContent":770},{"type":464,"textContent":2255},".  Lexical Tokens",{"type":464,"textContent":2257},"\n\n   The following rules are used to define an underlying lexical\n   analyzer, which feeds tokens to the higher-level parsers.  This\n   section defines the tokens used in structured header field bodies.\n\n      Note: Readers of this specification need to pay special attention\n      to how these lexical tokens are used in both the lower-level and\n      higher-level syntax later in the document.  Particularly, the\n      white space tokens and the comment tokens defined in ",{"type":459,"nodeName":467,"attributes":2259,"children":2260},{"href":793},[2261],{"type":464,"textContent":2078},{"type":464,"textContent":2263},"\n      get used in the lower-level tokens defined here, and those lower-\n      level tokens are in turn used as parts of the higher-level tokens\n      defined later.  Therefore, white space and comments may be allowed\n      in the higher-level tokens even though they may not explicitly\n      appear in a particular definition.\n\n",{"type":459,"nodeName":484,"attributes":2265,"children":2266},{"class":1691},[2267,2271],{"type":459,"nodeName":467,"attributes":2268,"children":2269},{"class":1580,"id":191,"href":780},[2270],{"type":464,"textContent":783},{"type":464,"textContent":2272},".  Quoted characters",{"type":464,"textContent":2274},"\n\n   Some characters are reserved for special interpretation, such as\n   delimiting lexical tokens.  To permit use of these characters as\n   uninterpreted data, a quoting mechanism is provided.\n\n\n\n",{"type":459,"nodeName":484,"attributes":2276,"children":2277},{"class":507},[2278],{"type":464,"textContent":2279},"Resnick                     Standards Track                    [Page 10]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2282,"children":2283},{"class":516},[],{"type":459,"nodeName":460,"attributes":2285,"children":2286},{"class":520},[2287,2291,2292,2300,2302,2306,2308,2317,2319,2323,2325,2330,2332],{"type":459,"nodeName":484,"attributes":2288,"children":2290},{"id":2289},"page-11",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2293,"children":2294},{"class":507},[2295,2299],{"type":459,"nodeName":467,"attributes":2296,"children":2297},{"href":532},[2298],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2301},"\n\n\n   quoted-pair     =   (\"\\\" (VCHAR \u002F WSP)) \u002F obs-qp\n\n   Where any quoted-pair appears, it is to be interpreted as the\n   character alone.  That is to say, the \"\\\" character that appears as\n   part of a quoted-pair is semantically \"invisible\".\n\n      Note: The \"\\\" character may appear in a message where it is not\n      part of a quoted-pair.  A \"\\\" character that does not appear in a\n      quoted-pair is not semantically invisible.  The only places in\n      this specification where quoted-pair currently appears are\n      ccontent, qcontent, and in obs-dtext in ",{"type":459,"nodeName":467,"attributes":2303,"children":2304},{"href":1042},[2305],{"type":464,"textContent":2232},{"type":464,"textContent":2307},".\n\n",{"type":459,"nodeName":484,"attributes":2309,"children":2310},{"class":1691},[2311,2315],{"type":459,"nodeName":467,"attributes":2312,"children":2313},{"class":1580,"id":196,"href":793},[2314],{"type":464,"textContent":796},{"type":464,"textContent":2316},".  Folding White Space and Comments",{"type":464,"textContent":2318},"\n\n   White space characters, including white space used in folding\n   (described in ",{"type":459,"nodeName":467,"attributes":2320,"children":2321},{"href":711},[2322],{"type":464,"textContent":2049},{"type":464,"textContent":2324},"), may appear between many elements in\n   header field bodies.  Also, strings of characters that are treated as\n   comments may be included in structured field bodies as characters\n   enclosed in parentheses.  The following defines the folding white\n   space (FWS) and comment constructs.\n\n   Strings of characters enclosed in parentheses are considered comments\n   so long as they do not appear within a \"quoted-string\", as defined in\n   ",{"type":459,"nodeName":467,"attributes":2326,"children":2327},{"href":823},[2328],{"type":464,"textContent":2329},"section 3.2.4",{"type":464,"textContent":2331},".  Comments may nest.\n\n   There are several places in this specification where comments and FWS\n   may be freely inserted.  To accommodate that syntax, an additional\n   token for \"CFWS\" is defined for places where comments and\u002For FWS can\n   occur.  However, where CFWS occurs in this specification, it MUST NOT\n   be inserted in such a way that any line of a folded header field is\n   made up entirely of WSP characters and nothing else.\n\n   FWS             =   ([*WSP CRLF] 1*WSP) \u002F  obs-FWS\n                                          ; Folding white space\n\n   ctext           =   %d33-39 \u002F          ; Printable US-ASCII\n                       %d42-91 \u002F          ;  characters not including\n                       %d93-126 \u002F         ;  \"(\", \")\", or \"\\\"\n                       obs-ctext\n\n   ccontent        =   ctext \u002F quoted-pair \u002F comment\n\n   comment         =   \"(\" *([FWS] ccontent) [FWS] \")\"\n\n   CFWS            =   (1*([FWS] comment) [FWS]) \u002F FWS\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2333,"children":2334},{"class":507},[2335],{"type":464,"textContent":2336},"Resnick                     Standards Track                    [Page 11]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2339,"children":2340},{"class":516},[],{"type":459,"nodeName":460,"attributes":2342,"children":2343},{"class":520},[2344,2348,2349,2357,2359,2363,2365,2374,2376],{"type":459,"nodeName":484,"attributes":2345,"children":2347},{"id":2346},"page-12",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2350,"children":2351},{"class":507},[2352,2356],{"type":459,"nodeName":467,"attributes":2353,"children":2354},{"href":532},[2355],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2358},"\n\n\n   Throughout this specification, where FWS (the folding white space\n   token) appears, it indicates a place where folding, as discussed in\n   ",{"type":459,"nodeName":467,"attributes":2360,"children":2361},{"href":711},[2362],{"type":464,"textContent":2049},{"type":464,"textContent":2364},", may take place.  Wherever folding appears in a message\n   (that is, a header field body containing a CRLF followed by any WSP),\n   unfolding (removal of the CRLF) is performed before any further\n   semantic analysis is performed on that header field according to this\n   specification.  That is to say, any CRLF that appears in FWS is\n   semantically \"invisible\".\n\n   A comment is normally used in a structured field body to provide some\n   human-readable informational text.  Since a comment is allowed to\n   contain FWS, folding is permitted within the comment.  Also note that\n   since quoted-pair is allowed in a comment, the parentheses and\n   backslash characters may appear in a comment, so long as they appear\n   as a quoted-pair.  Semantically, the enclosing parentheses are not\n   part of the comment; the comment is what is contained between the two\n   parentheses.  As stated earlier, the \"\\\" in any quoted-pair and the\n   CRLF in any FWS that appears within the comment are semantically\n   \"invisible\" and therefore not part of the comment either.\n\n   Runs of FWS, comment, or CFWS that occur between lexical tokens in a\n   structured header field are semantically interpreted as a single\n   space character.\n\n",{"type":459,"nodeName":484,"attributes":2366,"children":2367},{"class":1691},[2368,2372],{"type":459,"nodeName":467,"attributes":2369,"children":2370},{"class":1580,"id":201,"href":808},[2371],{"type":464,"textContent":811},{"type":464,"textContent":2373},".  Atom",{"type":464,"textContent":2375},"\n\n   Several productions in structured header field bodies are simply\n   strings of certain basic characters.  Such productions are called\n   atoms.\n\n   Some of the structured header field bodies also allow the period\n   character (\".\", ASCII value 46) within runs of atext.  An additional\n   \"dot-atom\" token is defined for those purposes.\n\n      Note: The \"specials\" token does not appear anywhere else in this\n      specification.  It is simply the visible (i.e., non-control, non-\n      white space) characters that do not appear in atext.  It is\n      provided only because it is useful for implementers who use tools\n      that lexically analyze messages.  Each of the characters in\n      specials can be used to indicate a tokenization point in lexical\n      analysis.\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2377,"children":2378},{"class":507},[2379],{"type":464,"textContent":2380},"Resnick                     Standards Track                    [Page 12]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2383,"children":2384},{"class":516},[],{"type":459,"nodeName":460,"attributes":2386,"children":2387},{"class":520},[2388,2392,2393,2401,2403,2412,2414],{"type":459,"nodeName":484,"attributes":2389,"children":2391},{"id":2390},"page-13",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2394,"children":2395},{"class":507},[2396,2400],{"type":459,"nodeName":467,"attributes":2397,"children":2398},{"href":532},[2399],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2402},"\n\n\n   atext           =   ALPHA \u002F DIGIT \u002F    ; Printable US-ASCII\n                       \"!\" \u002F \"#\" \u002F        ;  characters not including\n                       \"$\" \u002F \"%\" \u002F        ;  specials.  Used for atoms.\n                       \"&\" \u002F \"'\" \u002F\n                       \"*\" \u002F \"+\" \u002F\n                       \"-\" \u002F \"\u002F\" \u002F\n                       \"=\" \u002F \"?\" \u002F\n                       \"^\" \u002F \"_\" \u002F\n                       \"`\" \u002F \"{\" \u002F\n                       \"|\" \u002F \"}\" \u002F\n                       \"~\"\n\n   atom            =   [CFWS] 1*atext [CFWS]\n\n   dot-atom-text   =   1*atext *(\".\" 1*atext)\n\n   dot-atom        =   [CFWS] dot-atom-text [CFWS]\n\n   specials        =   \"(\" \u002F \")\" \u002F        ; Special characters that do\n                       \"\u003C\" \u002F \">\" \u002F        ;  not appear in atext\n                       \"[\" \u002F \"]\" \u002F\n                       \":\" \u002F \";\" \u002F\n                       \"@\" \u002F \"\\\" \u002F\n                       \",\" \u002F \".\" \u002F\n                       DQUOTE\n\n   Both atom and dot-atom are interpreted as a single unit, comprising\n   the string of characters that make it up.  Semantically, the optional\n   comments and FWS surrounding the rest of the characters are not part\n   of the atom; the atom is only the run of atext characters in an atom,\n   or the atext and \".\" characters in a dot-atom.\n\n",{"type":459,"nodeName":484,"attributes":2404,"children":2405},{"class":1691},[2406,2410],{"type":459,"nodeName":467,"attributes":2407,"children":2408},{"class":1580,"id":206,"href":823},[2409],{"type":464,"textContent":826},{"type":464,"textContent":2411},".  Quoted Strings",{"type":464,"textContent":2413},"\n\n   Strings of characters that include characters other than those\n   allowed in atoms can be represented in a quoted string format, where\n   the characters are surrounded by quote (DQUOTE, ASCII value 34)\n   characters.\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2415,"children":2416},{"class":507},[2417],{"type":464,"textContent":2418},"Resnick                     Standards Track                    [Page 13]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2421,"children":2422},{"class":516},[],{"type":459,"nodeName":460,"attributes":2424,"children":2425},{"class":520},[2426,2430,2431,2439,2441,2450,2452,2461,2463],{"type":459,"nodeName":484,"attributes":2427,"children":2429},{"id":2428},"page-14",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2432,"children":2433},{"class":507},[2434,2438],{"type":459,"nodeName":467,"attributes":2435,"children":2436},{"href":532},[2437],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2440},"\n\n\n   qtext           =   %d33 \u002F             ; Printable US-ASCII\n                       %d35-91 \u002F          ;  characters not including\n                       %d93-126 \u002F         ;  \"\\\" or the quote character\n                       obs-qtext\n\n   qcontent        =   qtext \u002F quoted-pair\n\n   quoted-string   =   [CFWS]\n                       DQUOTE *([FWS] qcontent) [FWS] DQUOTE\n                       [CFWS]\n\n   A quoted-string is treated as a unit.  That is, quoted-string is\n   identical to atom, semantically.  Since a quoted-string is allowed to\n   contain FWS, folding is permitted.  Also note that since quoted-pair\n   is allowed in a quoted-string, the quote and backslash characters may\n   appear in a quoted-string so long as they appear as a quoted-pair.\n\n   Semantically, neither the optional CFWS outside of the quote\n   characters nor the quote characters themselves are part of the\n   quoted-string; the quoted-string is what is contained between the two\n   quote characters.  As stated earlier, the \"\\\" in any quoted-pair and\n   the CRLF in any FWS\u002FCFWS that appears within the quoted-string are\n   semantically \"invisible\" and therefore not part of the quoted-string\n   either.\n\n",{"type":459,"nodeName":484,"attributes":2442,"children":2443},{"class":1691},[2444,2448],{"type":459,"nodeName":467,"attributes":2445,"children":2446},{"class":1580,"id":211,"href":838},[2447],{"type":464,"textContent":841},{"type":464,"textContent":2449},".  Miscellaneous Tokens",{"type":464,"textContent":2451},"\n\n   Three additional tokens are defined: word and phrase for combinations\n   of atoms and\u002For quoted-strings, and unstructured for use in\n   unstructured header fields and in some places within structured\n   header fields.\n\n   word            =   atom \u002F quoted-string\n\n   phrase          =   1*word \u002F obs-phrase\n\n   unstructured    =   (*([FWS] VCHAR) *WSP) \u002F obs-unstruct\n\n",{"type":459,"nodeName":484,"attributes":2453,"children":2454},{"class":1589},[2455,2459],{"type":459,"nodeName":467,"attributes":2456,"children":2457},{"class":1580,"id":216,"href":853},[2458],{"type":464,"textContent":856},{"type":464,"textContent":2460},".  Date and Time Specification",{"type":464,"textContent":2462},"\n\n   Date and time values occur in several header fields.  This section\n   specifies the syntax for a full date and time specification.  Though\n   folding white space is permitted throughout the date-time\n   specification, it is RECOMMENDED that a single space be used in each\n   place that FWS appears (whether it is required or optional); some\n   older implementations will not interpret longer sequences of folding\n   white space correctly.\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2464,"children":2465},{"class":507},[2466],{"type":464,"textContent":2467},"Resnick                     Standards Track                    [Page 14]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2470,"children":2471},{"class":516},[],{"type":459,"nodeName":460,"attributes":2473,"children":2474},{"class":520},[2475,2479,2480,2488,2490],{"type":459,"nodeName":484,"attributes":2476,"children":2478},{"id":2477},"page-15",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2481,"children":2482},{"class":507},[2483,2487],{"type":459,"nodeName":467,"attributes":2484,"children":2485},{"href":532},[2486],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2489},"\n\n\n   date-time       =   [ day-of-week \",\" ] date time [CFWS]\n\n   day-of-week     =   ([FWS] day-name) \u002F obs-day-of-week\n\n   day-name        =   \"Mon\" \u002F \"Tue\" \u002F \"Wed\" \u002F \"Thu\" \u002F\n                       \"Fri\" \u002F \"Sat\" \u002F \"Sun\"\n\n   date            =   day month year\n\n   day             =   ([FWS] 1*2DIGIT FWS) \u002F obs-day\n\n   month           =   \"Jan\" \u002F \"Feb\" \u002F \"Mar\" \u002F \"Apr\" \u002F\n                       \"May\" \u002F \"Jun\" \u002F \"Jul\" \u002F \"Aug\" \u002F\n                       \"Sep\" \u002F \"Oct\" \u002F \"Nov\" \u002F \"Dec\"\n\n   year            =   (FWS 4*DIGIT FWS) \u002F obs-year\n\n   time            =   time-of-day zone\n\n   time-of-day     =   hour \":\" minute [ \":\" second ]\n\n   hour            =   2DIGIT \u002F obs-hour\n\n   minute          =   2DIGIT \u002F obs-minute\n\n   second          =   2DIGIT \u002F obs-second\n\n   zone            =   (FWS ( \"+\" \u002F \"-\" ) 4DIGIT) \u002F obs-zone\n\n   The day is the numeric day of the month.  The year is any numeric\n   year 1900 or later.\n\n   The time-of-day specifies the number of hours, minutes, and\n   optionally seconds since midnight of the date indicated.\n\n   The date and time-of-day SHOULD express local time.\n\n   The zone specifies the offset from Coordinated Universal Time (UTC,\n   formerly referred to as \"Greenwich Mean Time\") that the date and\n   time-of-day represent.  The \"+\" or \"-\" indicates whether the time-of-\n   day is ahead of (i.e., east of) or behind (i.e., west of) Universal\n   Time.  The first two digits indicate the number of hours difference\n   from Universal Time, and the last two digits indicate the number of\n   additional minutes difference from Universal Time.  (Hence, +hhmm\n   means +(hh * 60 + mm) minutes, and -hhmm means -(hh * 60 + mm)\n   minutes).  The form \"+0000\" SHOULD be used to indicate a time zone at\n   Universal Time.  Though \"-0000\" also indicates Universal Time, it is\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2491,"children":2492},{"class":507},[2493],{"type":464,"textContent":2494},"Resnick                     Standards Track                    [Page 15]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2497,"children":2498},{"class":516},[],{"type":459,"nodeName":460,"attributes":2500,"children":2501},{"class":520},[2502,2506,2507,2515,2517,2523,2525,2534,2536],{"type":459,"nodeName":484,"attributes":2503,"children":2505},{"id":2504},"page-16",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2508,"children":2509},{"class":507},[2510,2514],{"type":459,"nodeName":467,"attributes":2511,"children":2512},{"href":532},[2513],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2516},"\n\n\n   used to indicate that the time was generated on a system that may be\n   in a local time zone other than Universal Time and that the date-time\n   contains no information about the local time zone.\n\n   A date-time specification MUST be semantically valid.  That is, the\n   day-of-week (if included) MUST be the day implied by the date, the\n   numeric day-of-month MUST be between 1 and the number of days allowed\n   for the specified month (in the specified year), the time-of-day MUST\n   be in the range 00:00:00 through 23:59:60 (the number of seconds\n   allowing for a leap second; see [",{"type":459,"nodeName":467,"attributes":2518,"children":2520},{"href":2519},"\u002Finfo\u002Frfc1305\u002F",[2521],{"type":464,"textContent":2522},"RFC1305",{"type":464,"textContent":2524},"]), and the last two digits\n   of the zone MUST be within the range 00 through 59.\n\n",{"type":459,"nodeName":484,"attributes":2526,"children":2527},{"class":1589},[2528,2532],{"type":459,"nodeName":467,"attributes":2529,"children":2530},{"class":1580,"id":221,"href":866},[2531],{"type":464,"textContent":869},{"type":464,"textContent":2533},".  Address Specification",{"type":464,"textContent":2535},"\n\n   Addresses occur in several message header fields to indicate senders\n   and recipients of messages.  An address may either be an individual\n   mailbox, or a group of mailboxes.\n\n   address         =   mailbox \u002F group\n\n   mailbox         =   name-addr \u002F addr-spec\n\n   name-addr       =   [display-name] angle-addr\n\n   angle-addr      =   [CFWS] \"\u003C\" addr-spec \">\" [CFWS] \u002F\n                       obs-angle-addr\n\n   group           =   display-name \":\" [group-list] \";\" [CFWS]\n\n   display-name    =   phrase\n\n   mailbox-list    =   (mailbox *(\",\" mailbox)) \u002F obs-mbox-list\n\n   address-list    =   (address *(\",\" address)) \u002F obs-addr-list\n\n   group-list      =   mailbox-list \u002F CFWS \u002F obs-group-list\n\n   A mailbox receives mail.  It is a conceptual entity that does not\n   necessarily pertain to file storage.  For example, some sites may\n   choose to print mail on a printer and deliver the output to the\n   addressee's desk.\n\n   Normally, a mailbox is composed of two parts: (1) an optional display\n   name that indicates the name of the recipient (which can be a person\n   or a system) that could be displayed to the user of a mail\n   application, and (2) an addr-spec address enclosed in angle brackets\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2537,"children":2538},{"class":507},[2539],{"type":464,"textContent":2540},"Resnick                     Standards Track                    [Page 16]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2543,"children":2544},{"class":516},[],{"type":459,"nodeName":460,"attributes":2546,"children":2547},{"class":520},[2548,2552,2553,2561,2563,2568,2570,2579,2581,2587,2588,2594,2595,2599,2600,2604,2606],{"type":459,"nodeName":484,"attributes":2549,"children":2551},{"id":2550},"page-17",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2554,"children":2555},{"class":507},[2556,2560],{"type":459,"nodeName":467,"attributes":2557,"children":2558},{"href":532},[2559],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2562},"\n\n\n   (\"\u003C\" and \">\").  There is an alternate simple form of a mailbox where\n   the addr-spec address appears alone, without the recipient's name or\n   the angle brackets.  The Internet addr-spec address is described in\n   ",{"type":459,"nodeName":467,"attributes":2564,"children":2565},{"href":881},[2566],{"type":464,"textContent":2567},"section 3.4.1",{"type":464,"textContent":2569},".\n\n      Note: Some legacy implementations used the simple form where the\n      addr-spec appears without the angle brackets, but included the\n      name of the recipient in parentheses as a comment following the\n      addr-spec.  Since the meaning of the information in a comment is\n      unspecified, implementations SHOULD use the full name-addr form of\n      the mailbox, instead of the legacy form, to specify the display\n      name associated with a mailbox.  Also, because some legacy\n      implementations interpret the comment, comments generally SHOULD\n      NOT be used in address fields to avoid confusing such\n      implementations.\n\n   When it is desirable to treat several mailboxes as a single unit\n   (i.e., in a distribution list), the group construct can be used.  The\n   group construct allows the sender to indicate a named group of\n   recipients.  This is done by giving a display name for the group,\n   followed by a colon, followed by a comma-separated list of any number\n   of mailboxes (including zero and one), and ending with a semicolon.\n   Because the list of mailboxes can be empty, using the group construct\n   is also a simple way to communicate to recipients that the message\n   was sent to one or more named sets of recipients, without actually\n   providing the individual mailbox address for any of those recipients.\n\n",{"type":459,"nodeName":484,"attributes":2571,"children":2572},{"class":1691},[2573,2577],{"type":459,"nodeName":467,"attributes":2574,"children":2575},{"class":1580,"id":227,"href":881},[2576],{"type":464,"textContent":884},{"type":464,"textContent":2578},".  Addr-Spec Specification",{"type":464,"textContent":2580},"\n\n   An addr-spec is a specific Internet identifier that contains a\n   locally interpreted string followed by the at-sign character (\"@\",\n   ASCII value 64) followed by an Internet domain.  The locally\n   interpreted string is either a quoted-string or a dot-atom.  If the\n   string can be represented as a dot-atom (that is, it contains no\n   characters other than atext characters or \".\" surrounded by atext\n   characters), then the dot-atom form SHOULD be used and the quoted-\n   string form SHOULD NOT be used.  Comments and folding white space\n   SHOULD NOT be used around the \"@\" in the addr-spec.\n\n      Note: A liberal syntax for the domain portion of addr-spec is\n      given here.  However, the domain portion contains addressing\n      information specified by and used in other protocols (e.g.,\n      [",{"type":459,"nodeName":467,"attributes":2582,"children":2584},{"href":2583},"\u002Finfo\u002Frfc1034\u002F",[2585],{"type":464,"textContent":2586},"RFC1034",{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":2589,"children":2591},{"href":2590},"\u002Finfo\u002Frfc1035\u002F",[2592],{"type":464,"textContent":2593},"RFC1035",{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":2596,"children":2597},{"href":1616},[2598],{"type":464,"textContent":1619},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":2601,"children":2602},{"href":1647},[2603],{"type":464,"textContent":1650},{"type":464,"textContent":2605},"]).  It is therefore\n      incumbent upon implementations to conform to the syntax of\n      addresses for the context in which they are used.\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2607,"children":2608},{"class":507},[2609],{"type":464,"textContent":2610},"Resnick                     Standards Track                    [Page 17]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2613,"children":2614},{"class":516},[],{"type":459,"nodeName":460,"attributes":2616,"children":2617},{"class":520},[2618,2622,2623,2631,2633,2637,2638,2642,2644,2648,2650,2654,2656,2665,2667,2672,2674],{"type":459,"nodeName":484,"attributes":2619,"children":2621},{"id":2620},"page-18",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2624,"children":2625},{"class":507},[2626,2630],{"type":459,"nodeName":467,"attributes":2627,"children":2628},{"href":532},[2629],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2632},"\n\n\n   addr-spec       =   local-part \"@\" domain\n\n   local-part      =   dot-atom \u002F quoted-string \u002F obs-local-part\n\n   domain          =   dot-atom \u002F domain-literal \u002F obs-domain\n\n   domain-literal  =   [CFWS] \"[\" *([FWS] dtext) [FWS] \"]\" [CFWS]\n\n   dtext           =   %d33-90 \u002F          ; Printable US-ASCII\n                       %d94-126 \u002F         ;  characters not including\n                       obs-dtext          ;  \"[\", \"]\", or \"\\\"\n\n   The domain portion identifies the point to which the mail is\n   delivered.  In the dot-atom form, this is interpreted as an Internet\n   domain name (either a host name or a mail exchanger name) as\n   described in [",{"type":459,"nodeName":467,"attributes":2634,"children":2635},{"href":2583},[2636],{"type":464,"textContent":2586},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":2639,"children":2640},{"href":2590},[2641],{"type":464,"textContent":2593},{"type":464,"textContent":2643},"], and [",{"type":459,"nodeName":467,"attributes":2645,"children":2646},{"href":1616},[2647],{"type":464,"textContent":1619},{"type":464,"textContent":2649},"].  In the domain-\n   literal form, the domain is interpreted as the literal Internet\n   address of the particular host.  In both cases, how addressing is\n   used and how messages are transported to a particular host is covered\n   in separate documents, such as [",{"type":459,"nodeName":467,"attributes":2651,"children":2652},{"href":1647},[2653],{"type":464,"textContent":1650},{"type":464,"textContent":2655},"].  These mechanisms are\n   outside of the scope of this document.\n\n   The local-part portion is a domain-dependent string.  In addresses,\n   it is simply interpreted on the particular host as a name of a\n   particular mailbox.\n\n",{"type":459,"nodeName":484,"attributes":2657,"children":2658},{"class":1589},[2659,2663],{"type":459,"nodeName":467,"attributes":2660,"children":2661},{"class":1580,"id":232,"href":896},[2662],{"type":464,"textContent":899},{"type":464,"textContent":2664},".  Overall Message Syntax",{"type":464,"textContent":2666},"\n\n   A message consists of header fields, optionally followed by a message\n   body.  Lines in a message MUST be a maximum of 998 characters\n   excluding the CRLF, but it is RECOMMENDED that lines be limited to 78\n   characters excluding the CRLF.  (See ",{"type":459,"nodeName":467,"attributes":2668,"children":2669},{"href":655},[2670],{"type":464,"textContent":2671},"section 2.1.1",{"type":464,"textContent":2673}," for explanation.)\n   In a message body, though all of the characters listed in the text\n   rule MAY be used, the use of US-ASCII control characters (values 1\n   through 8, 11, 12, and 14 through 31) is discouraged since their\n   interpretation by receivers for display is not guaranteed.\n\n   message         =   (fields \u002F obs-fields)\n                       [CRLF body]\n\n   body            =   (*(*998text CRLF) *998text) \u002F obs-body\n\n   text            =   %d1-9 \u002F            ; Characters excluding CR\n                       %d11 \u002F             ;  and LF\n                       %d12 \u002F\n                       %d14-127\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2675,"children":2676},{"class":507},[2677],{"type":464,"textContent":2678},"Resnick                     Standards Track                    [Page 18]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2681,"children":2682},{"class":516},[],{"type":459,"nodeName":460,"attributes":2684,"children":2685},{"class":520},[2686,2690,2691,2699,2701,2706,2708,2717,2719,2723,2724,2728,2730],{"type":459,"nodeName":484,"attributes":2687,"children":2689},{"id":2688},"page-19",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2692,"children":2693},{"class":507},[2694,2698],{"type":459,"nodeName":467,"attributes":2695,"children":2696},{"href":532},[2697],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2700},"\n\n\n   The header fields carry most of the semantic information and are\n   defined in ",{"type":459,"nodeName":467,"attributes":2702,"children":2703},{"href":911},[2704],{"type":464,"textContent":2705},"section 3.6",{"type":464,"textContent":2707},".  The body is simply a series of lines of text\n   that are uninterpreted for the purposes of this specification.\n\n",{"type":459,"nodeName":484,"attributes":2709,"children":2710},{"class":1589},[2711,2715],{"type":459,"nodeName":467,"attributes":2712,"children":2713},{"class":1580,"id":237,"href":911},[2714],{"type":464,"textContent":914},{"type":464,"textContent":2716},".  Field Definitions",{"type":464,"textContent":2718},"\n\n   The header fields of a message are defined here.  All header fields\n   have the same general syntactic structure: a field name, followed by\n   a colon, followed by the field body.  The specific syntax for each\n   header field is defined in the subsequent sections.\n\n      Note: In the ABNF syntax for each field in subsequent sections,\n      each field name is followed by the required colon.  However, for\n      brevity, sometimes the colon is not referred to in the textual\n      description of the syntax.  It is, nonetheless, required.\n\n   It is important to note that the header fields are not guaranteed to\n   be in a particular order.  They may appear in any order, and they\n   have been known to be reordered occasionally when transported over\n   the Internet.  However, for the purposes of this specification,\n   header fields SHOULD NOT be reordered when a message is transported\n   or transformed.  More importantly, the trace header fields and resent\n   header fields MUST NOT be reordered, and SHOULD be kept in blocks\n   prepended to the message.  See sections ",{"type":459,"nodeName":467,"attributes":2720,"children":2721},{"href":999},[2722],{"type":464,"textContent":1002},{"type":464,"textContent":1778},{"type":459,"nodeName":467,"attributes":2725,"children":2726},{"href":1014},[2727],{"type":464,"textContent":1017},{"type":464,"textContent":2729}," for more\n   information.\n\n   The only required header fields are the origination date field and\n   the originator address field(s).  All other header fields are\n   syntactically optional.  More information is contained in the table\n   following this definition.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2731,"children":2732},{"class":507},[2733],{"type":464,"textContent":2734},"Resnick                     Standards Track                    [Page 19]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2737,"children":2738},{"class":516},[],{"type":459,"nodeName":460,"attributes":2740,"children":2741},{"class":520},[2742,2746,2747,2755,2757],{"type":459,"nodeName":484,"attributes":2743,"children":2745},{"id":2744},"page-20",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2748,"children":2749},{"class":507},[2750,2754],{"type":459,"nodeName":467,"attributes":2751,"children":2752},{"href":532},[2753],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2756},"\n\n\n   fields          =   *(trace\n                         *optional-field \u002F\n                         *(resent-date \u002F\n                          resent-from \u002F\n                          resent-sender \u002F\n                          resent-to \u002F\n                          resent-cc \u002F\n                          resent-bcc \u002F\n                          resent-msg-id))\n                       *(orig-date \u002F\n                       from \u002F\n                       sender \u002F\n                       reply-to \u002F\n                       to \u002F\n                       cc \u002F\n                       bcc \u002F\n                       message-id \u002F\n                       in-reply-to \u002F\n                       references \u002F\n                       subject \u002F\n                       comments \u002F\n                       keywords \u002F\n                       optional-field)\n\n   The following table indicates limits on the number of times each\n   field may occur in the header section of a message as well as any\n   special limitations on the use of those fields.  An asterisk (\"*\")\n   next to a value in the minimum or maximum column indicates that a\n   special restriction appears in the Notes column.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2758,"children":2759},{"class":507},[2760],{"type":464,"textContent":2761},"Resnick                     Standards Track                    [Page 20]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2764,"children":2765},{"class":516},[],{"type":459,"nodeName":460,"attributes":2767,"children":2768},{"class":520},[2769,2773,2774,2782,2784],{"type":459,"nodeName":484,"attributes":2770,"children":2772},{"id":2771},"page-21",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2775,"children":2776},{"class":507},[2777,2781],{"type":459,"nodeName":467,"attributes":2778,"children":2779},{"href":532},[2780],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2783},"\n\n\n   +----------------+--------+------------+----------------------------+\n   | Field          | Min    | Max number | Notes                      |\n   |                | number |            |                            |\n   +----------------+--------+------------+----------------------------+\n   | trace          | 0      | unlimited  | Block prepended - see      |\n   |                |        |            | 3.6.7                      |\n   | resent-date    | 0*     | unlimited* | One per block, required if |\n   |                |        |            | other resent fields are    |\n   |                |        |            | present - see 3.6.6        |\n   | resent-from    | 0      | unlimited* | One per block - see 3.6.6  |\n   | resent-sender  | 0*     | unlimited* | One per block, MUST occur  |\n   |                |        |            | with multi-address         |\n   |                |        |            | resent-from - see 3.6.6    |\n   | resent-to      | 0      | unlimited* | One per block - see 3.6.6  |\n   | resent-cc      | 0      | unlimited* | One per block - see 3.6.6  |\n   | resent-bcc     | 0      | unlimited* | One per block - see 3.6.6  |\n   | resent-msg-id  | 0      | unlimited* | One per block - see 3.6.6  |\n   | orig-date      | 1      | 1          |                            |\n   | from           | 1      | 1          | See sender and 3.6.2       |\n   | sender         | 0*     | 1          | MUST occur with            |\n   |                |        |            | multi-address from - see   |\n   |                |        |            | 3.6.2                      |\n   | reply-to       | 0      | 1          |                            |\n   | to             | 0      | 1          |                            |\n   | cc             | 0      | 1          |                            |\n   | bcc            | 0      | 1          |                            |\n   | message-id     | 0*     | 1          | SHOULD be present - see    |\n   |                |        |            | 3.6.4                      |\n   | in-reply-to    | 0*     | 1          | SHOULD occur in some       |\n   |                |        |            | replies - see 3.6.4        |\n   | references     | 0*     | 1          | SHOULD occur in some       |\n   |                |        |            | replies - see 3.6.4        |\n   | subject        | 0      | 1          |                            |\n   | comments       | 0      | unlimited  |                            |\n   | keywords       | 0      | unlimited  |                            |\n   | optional-field | 0      | unlimited  |                            |\n   +----------------+--------+------------+----------------------------+\n\n   The exact interpretation of each field is described in subsequent\n   sections.\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2785,"children":2786},{"class":507},[2787],{"type":464,"textContent":2788},"Resnick                     Standards Track                    [Page 21]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2791,"children":2792},{"class":516},[],{"type":459,"nodeName":460,"attributes":2794,"children":2795},{"class":520},[2796,2800,2801,2809,2810,2819,2821,2830,2832],{"type":459,"nodeName":484,"attributes":2797,"children":2799},{"id":2798},"page-22",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2802,"children":2803},{"class":507},[2804,2808],{"type":459,"nodeName":467,"attributes":2805,"children":2806},{"href":532},[2807],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":2811,"children":2812},{"class":1691},[2813,2817],{"type":459,"nodeName":467,"attributes":2814,"children":2815},{"class":1580,"id":243,"href":926},[2816],{"type":464,"textContent":929},{"type":464,"textContent":2818},".  The Origination Date Field",{"type":464,"textContent":2820},"\n\n   The origination date field consists of the field name \"Date\" followed\n   by a date-time specification.\n\n   orig-date       =   \"Date:\" date-time CRLF\n\n   The origination date specifies the date and time at which the creator\n   of the message indicated that the message was complete and ready to\n   enter the mail delivery system.  For instance, this might be the time\n   that a user pushes the \"send\" or \"submit\" button in an application\n   program.  In any case, it is specifically not intended to convey the\n   time that the message is actually transported, but rather the time at\n   which the human or other creator of the message has put the message\n   into its final form, ready for transport.  (For example, a portable\n   computer user who is not connected to a network might queue a message\n   for delivery.  The origination date is intended to contain the date\n   and time that the user queued the message, not the time when the user\n   connected to the network to send the message.)\n\n",{"type":459,"nodeName":484,"attributes":2822,"children":2823},{"class":1691},[2824,2828],{"type":459,"nodeName":467,"attributes":2825,"children":2826},{"class":1580,"id":248,"href":941},[2827],{"type":464,"textContent":944},{"type":464,"textContent":2829},".  Originator Fields",{"type":464,"textContent":2831},"\n\n   The originator fields of a message consist of the from field, the\n   sender field (when applicable), and optionally the reply-to field.\n   The from field consists of the field name \"From\" and a comma-\n   separated list of one or more mailbox specifications.  If the from\n   field contains more than one mailbox specification in the mailbox-\n   list, then the sender field, containing the field name \"Sender\" and a\n   single mailbox specification, MUST appear in the message.  In either\n   case, an optional reply-to field MAY also be included, which contains\n   the field name \"Reply-To\" and a comma-separated list of one or more\n   addresses.\n\n   from            =   \"From:\" mailbox-list CRLF\n\n   sender          =   \"Sender:\" mailbox CRLF\n\n   reply-to        =   \"Reply-To:\" address-list CRLF\n\n   The originator fields indicate the mailbox(es) of the source of the\n   message.  The \"From:\" field specifies the author(s) of the message,\n   that is, the mailbox(es) of the person(s) or system(s) responsible\n   for the writing of the message.  The \"Sender:\" field specifies the\n   mailbox of the agent responsible for the actual transmission of the\n   message.  For example, if a secretary were to send a message for\n   another person, the mailbox of the secretary would appear in the\n   \"Sender:\" field and the mailbox of the actual author would appear in\n   the \"From:\" field.  If the originator of the message can be indicated\n\n\n\n",{"type":459,"nodeName":484,"attributes":2833,"children":2834},{"class":507},[2835],{"type":464,"textContent":2836},"Resnick                     Standards Track                    [Page 22]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2839,"children":2840},{"class":516},[],{"type":459,"nodeName":460,"attributes":2842,"children":2843},{"class":520},[2844,2848,2849,2857,2859,2863,2864,2868,2870,2879,2881],{"type":459,"nodeName":484,"attributes":2845,"children":2847},{"id":2846},"page-23",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2850,"children":2851},{"class":507},[2852,2856],{"type":459,"nodeName":467,"attributes":2853,"children":2854},{"href":532},[2855],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2858},"\n\n\n   by a single mailbox and the author and transmitter are identical, the\n   \"Sender:\" field SHOULD NOT be used.  Otherwise, both fields SHOULD\n   appear.\n\n      Note: The transmitter information is always present.  The absence\n      of the \"Sender:\" field is sometimes mistakenly taken to mean that\n      the agent responsible for transmission of the message has not been\n      specified.  This absence merely means that the transmitter is\n      identical to the author and is therefore not redundantly placed\n      into the \"Sender:\" field.\n\n   The originator fields also provide the information required when\n   replying to a message.  When the \"Reply-To:\" field is present, it\n   indicates the address(es) to which the author of the message suggests\n   that replies be sent.  In the absence of the \"Reply-To:\" field,\n   replies SHOULD by default be sent to the mailbox(es) specified in the\n   \"From:\" field unless otherwise specified by the person composing the\n   reply.\n\n   In all cases, the \"From:\" field SHOULD NOT contain any mailbox that\n   does not belong to the author(s) of the message.  See also ",{"type":459,"nodeName":467,"attributes":2860,"children":2861},{"href":954},[2862],{"type":464,"textContent":2008},{"type":464,"textContent":624},{"type":459,"nodeName":467,"attributes":2865,"children":2866},{"href":954},[2867],{"type":464,"textContent":957},{"type":464,"textContent":2869}," for more information on forming the destination addresses for a\n   reply.\n\n",{"type":459,"nodeName":484,"attributes":2871,"children":2872},{"class":1691},[2873,2877],{"type":459,"nodeName":467,"attributes":2874,"children":2875},{"class":1580,"id":253,"href":954},[2876],{"type":464,"textContent":957},{"type":464,"textContent":2878},".  Destination Address Fields",{"type":464,"textContent":2880},"\n\n   The destination fields of a message consist of three possible fields,\n   each of the same form: the field name, which is either \"To\", \"Cc\", or\n   \"Bcc\", followed by a comma-separated list of one or more addresses\n   (either mailbox or group syntax).\n\n   to              =   \"To:\" address-list CRLF\n\n   cc              =   \"Cc:\" address-list CRLF\n\n   bcc             =   \"Bcc:\" [address-list \u002F CFWS] CRLF\n\n   The destination fields specify the recipients of the message.  Each\n   destination field may have one or more addresses, and the addresses\n   indicate the intended recipients of the message.  The only difference\n   between the three fields is how each is used.\n\n   The \"To:\" field contains the address(es) of the primary recipient(s)\n   of the message.\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2882,"children":2883},{"class":507},[2884],{"type":464,"textContent":2885},"Resnick                     Standards Track                    [Page 23]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2888,"children":2889},{"class":516},[],{"type":459,"nodeName":460,"attributes":2891,"children":2892},{"class":520},[2893,2897,2898,2906,2908],{"type":459,"nodeName":484,"attributes":2894,"children":2896},{"id":2895},"page-24",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2899,"children":2900},{"class":507},[2901,2905],{"type":459,"nodeName":467,"attributes":2902,"children":2903},{"href":532},[2904],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2907},"\n\n\n   The \"Cc:\" field (where the \"Cc\" means \"Carbon Copy\" in the sense of\n   making a copy on a typewriter using carbon paper) contains the\n   addresses of others who are to receive the message, though the\n   content of the message may not be directed at them.\n\n   The \"Bcc:\" field (where the \"Bcc\" means \"Blind Carbon Copy\") contains\n   addresses of recipients of the message whose addresses are not to be\n   revealed to other recipients of the message.  There are three ways in\n   which the \"Bcc:\" field is used.  In the first case, when a message\n   containing a \"Bcc:\" field is prepared to be sent, the \"Bcc:\" line is\n   removed even though all of the recipients (including those specified\n   in the \"Bcc:\" field) are sent a copy of the message.  In the second\n   case, recipients specified in the \"To:\" and \"Cc:\" lines each are sent\n   a copy of the message with the \"Bcc:\" line removed as above, but the\n   recipients on the \"Bcc:\" line get a separate copy of the message\n   containing a \"Bcc:\" line.  (When there are multiple recipient\n   addresses in the \"Bcc:\" field, some implementations actually send a\n   separate copy of the message to each recipient with a \"Bcc:\"\n   containing only the address of that particular recipient.)  Finally,\n   since a \"Bcc:\" field may contain no addresses, a \"Bcc:\" field can be\n   sent without any addresses indicating to the recipients that blind\n   copies were sent to someone.  Which method to use with \"Bcc:\" fields\n   is implementation dependent, but refer to the \"Security\n   Considerations\" section of this document for a discussion of each.\n\n   When a message is a reply to another message, the mailboxes of the\n   authors of the original message (the mailboxes in the \"From:\" field)\n   or mailboxes specified in the \"Reply-To:\" field (if it exists) MAY\n   appear in the \"To:\" field of the reply since these would normally be\n   the primary recipients of the reply.  If a reply is sent to a message\n   that has destination fields, it is often desirable to send a copy of\n   the reply to all of the recipients of the message, in addition to the\n   author.  When such a reply is formed, addresses in the \"To:\" and\n   \"Cc:\" fields of the original message MAY appear in the \"Cc:\" field of\n   the reply, since these are normally secondary recipients of the\n   reply.  If a \"Bcc:\" field is present in the original message,\n   addresses in that field MAY appear in the \"Bcc:\" field of the reply,\n   but they SHOULD NOT appear in the \"To:\" or \"Cc:\" fields.\n\n      Note: Some mail applications have automatic reply commands that\n      include the destination addresses of the original message in the\n      destination addresses of the reply.  How those reply commands\n      behave is implementation dependent and is beyond the scope of this\n      document.  In particular, whether or not to include the original\n      destination addresses when the original message had a \"Reply-To:\"\n      field is not addressed here.\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":2909,"children":2910},{"class":507},[2911],{"type":464,"textContent":2912},"Resnick                     Standards Track                    [Page 24]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2915,"children":2916},{"class":516},[],{"type":459,"nodeName":460,"attributes":2918,"children":2919},{"class":520},[2920,2924,2925,2933,2934,2943,2945,2949,2951,2955,2956,2960,2961,2965,2966,2970,2972],{"type":459,"nodeName":484,"attributes":2921,"children":2923},{"id":2922},"page-25",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2926,"children":2927},{"class":507},[2928,2932],{"type":459,"nodeName":467,"attributes":2929,"children":2930},{"href":532},[2931],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":2935,"children":2936},{"class":1691},[2937,2941],{"type":459,"nodeName":467,"attributes":2938,"children":2939},{"class":1580,"id":258,"href":969},[2940],{"type":464,"textContent":972},{"type":464,"textContent":2942},".  Identification Fields",{"type":464,"textContent":2944},"\n\n   Though listed as optional in the table in ",{"type":459,"nodeName":467,"attributes":2946,"children":2947},{"href":911},[2948],{"type":464,"textContent":2705},{"type":464,"textContent":2950},", every message\n   SHOULD have a \"Message-ID:\" field.  Furthermore, reply messages\n   SHOULD have \"In-Reply-To:\" and \"References:\" fields as appropriate\n   and as described below.\n\n   The \"Message-ID:\" field contains a single unique message identifier.\n   The \"References:\" and \"In-Reply-To:\" fields each contain one or more\n   unique message identifiers, optionally separated by CFWS.\n\n   The message identifier (msg-id) syntax is a limited version of the\n   addr-spec construct enclosed in the angle bracket characters, \"\u003C\" and\n   \">\".  Unlike addr-spec, this syntax only permits the dot-atom-text\n   form on the left-hand side of the \"@\" and does not have internal CFWS\n   anywhere in the message identifier.\n\n      Note: As with addr-spec, a liberal syntax is given for the right-\n      hand side of the \"@\" in a msg-id.  However, later in this section,\n      the use of a domain for the right-hand side of the \"@\" is\n      RECOMMENDED.  Again, the syntax of domain constructs is specified\n      by and used in other protocols (e.g., [",{"type":459,"nodeName":467,"attributes":2952,"children":2953},{"href":2583},[2954],{"type":464,"textContent":2586},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":2957,"children":2958},{"href":2590},[2959],{"type":464,"textContent":2593},{"type":464,"textContent":1884},{"type":459,"nodeName":467,"attributes":2962,"children":2963},{"href":1616},[2964],{"type":464,"textContent":1619},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":2967,"children":2968},{"href":1647},[2969],{"type":464,"textContent":1650},{"type":464,"textContent":2971},"]).  It is therefore incumbent upon\n      implementations to conform to the syntax of addresses for the\n      context in which they are used.\n\n   message-id      =   \"Message-ID:\" msg-id CRLF\n\n   in-reply-to     =   \"In-Reply-To:\" 1*msg-id CRLF\n\n   references      =   \"References:\" 1*msg-id CRLF\n\n   msg-id          =   [CFWS] \"\u003C\" id-left \"@\" id-right \">\" [CFWS]\n\n   id-left         =   dot-atom-text \u002F obs-id-left\n\n   id-right        =   dot-atom-text \u002F no-fold-literal \u002F obs-id-right\n\n   no-fold-literal =   \"[\" *dtext \"]\"\n\n   The \"Message-ID:\" field provides a unique message identifier that\n   refers to a particular version of a particular message.  The\n   uniqueness of the message identifier is guaranteed by the host that\n   generates it (see below).  This message identifier is intended to be\n   machine readable and not necessarily meaningful to humans.  A message\n   identifier pertains to exactly one version of a particular message;\n   subsequent revisions to the message each receive new message\n   identifiers.\n\n\n\n",{"type":459,"nodeName":484,"attributes":2973,"children":2974},{"class":507},[2975],{"type":464,"textContent":2976},"Resnick                     Standards Track                    [Page 25]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":2979,"children":2980},{"class":516},[],{"type":459,"nodeName":460,"attributes":2982,"children":2983},{"class":520},[2984,2988,2989,2997,2999,3004,3006,3011,3013],{"type":459,"nodeName":484,"attributes":2985,"children":2987},{"id":2986},"page-26",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":2990,"children":2991},{"class":507},[2992,2996],{"type":459,"nodeName":467,"attributes":2993,"children":2994},{"href":532},[2995],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":2998},"\n\n\n      Note: There are many instances when messages are \"changed\", but\n      those changes do not constitute a new instantiation of that\n      message, and therefore the message would not get a new message\n      identifier.  For example, when messages are introduced into the\n      transport system, they are often prepended with additional header\n      fields such as trace fields (described in ",{"type":459,"nodeName":467,"attributes":3000,"children":3001},{"href":1014},[3002],{"type":464,"textContent":3003},"section 3.6.7",{"type":464,"textContent":3005},") and\n      resent fields (described in ",{"type":459,"nodeName":467,"attributes":3007,"children":3008},{"href":999},[3009],{"type":464,"textContent":3010},"section 3.6.6",{"type":464,"textContent":3012},").  The addition of such\n      header fields does not change the identity of the message and\n      therefore the original \"Message-ID:\" field is retained.  In all\n      cases, it is the meaning that the sender of the message wishes to\n      convey (i.e., whether this is the same message or a different\n      message) that determines whether or not the \"Message-ID:\" field\n      changes, not any particular syntactic difference that appears (or\n      does not appear) in the message.\n\n   The \"In-Reply-To:\" and \"References:\" fields are used when creating a\n   reply to a message.  They hold the message identifier of the original\n   message and the message identifiers of other messages (for example,\n   in the case of a reply to a message that was itself a reply).  The\n   \"In-Reply-To:\" field may be used to identify the message (or\n   messages) to which the new message is a reply, while the\n   \"References:\" field may be used to identify a \"thread\" of\n   conversation.\n\n   When creating a reply to a message, the \"In-Reply-To:\" and\n   \"References:\" fields of the resultant message are constructed as\n   follows:\n\n   The \"In-Reply-To:\" field will contain the contents of the\n   \"Message-ID:\" field of the message to which this one is a reply (the\n   \"parent message\").  If there is more than one parent message, then\n   the \"In-Reply-To:\" field will contain the contents of all of the\n   parents' \"Message-ID:\" fields.  If there is no \"Message-ID:\" field in\n   any of the parent messages, then the new message will have no \"In-\n   Reply-To:\" field.\n\n   The \"References:\" field will contain the contents of the parent's\n   \"References:\" field (if any) followed by the contents of the parent's\n   \"Message-ID:\" field (if any).  If the parent message does not contain\n   a \"References:\" field but does have an \"In-Reply-To:\" field\n   containing a single message identifier, then the \"References:\" field\n   will contain the contents of the parent's \"In-Reply-To:\" field\n   followed by the contents of the parent's \"Message-ID:\" field (if\n   any).  If the parent has none of the \"References:\", \"In-Reply-To:\",\n   or \"Message-ID:\" fields, then the new message will have no\n   \"References:\" field.\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":3014,"children":3015},{"class":507},[3016],{"type":464,"textContent":3017},"Resnick                     Standards Track                    [Page 26]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3020,"children":3021},{"class":516},[],{"type":459,"nodeName":460,"attributes":3023,"children":3024},{"class":520},[3025,3029,3030,3038,3040,3049,3051,3055,3056,3060,3062],{"type":459,"nodeName":484,"attributes":3026,"children":3028},{"id":3027},"page-27",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3031,"children":3032},{"class":507},[3033,3037],{"type":459,"nodeName":467,"attributes":3034,"children":3035},{"href":532},[3036],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":3039},"\n\n\n      Note: Some implementations parse the \"References:\" field to\n      display the \"thread of the discussion\".  These implementations\n      assume that each new message is a reply to a single parent and\n      hence that they can walk backwards through the \"References:\" field\n      to find the parent of each message listed there.  Therefore,\n      trying to form a \"References:\" field for a reply that has multiple\n      parents is discouraged; how to do so is not defined in this\n      document.\n\n   The message identifier (msg-id) itself MUST be a globally unique\n   identifier for a message.  The generator of the message identifier\n   MUST guarantee that the msg-id is unique.  There are several\n   algorithms that can be used to accomplish this.  Since the msg-id has\n   a similar syntax to addr-spec (identical except that quoted strings,\n   comments, and folding white space are not allowed), a good method is\n   to put the domain name (or a domain literal IP address) of the host\n   on which the message identifier was created on the right-hand side of\n   the \"@\" (since domain names and IP addresses are normally unique),\n   and put a combination of the current absolute date and time along\n   with some other currently unique (perhaps sequential) identifier\n   available on the system (for example, a process id number) on the\n   left-hand side.  Though other algorithms will work, it is RECOMMENDED\n   that the right-hand side contain some domain identifier (either of\n   the host itself or otherwise) such that the generator of the message\n   identifier can guarantee the uniqueness of the left-hand side within\n   the scope of that domain.\n\n   Semantically, the angle bracket characters are not part of the\n   msg-id; the msg-id is what is contained between the two angle bracket\n   characters.\n\n",{"type":459,"nodeName":484,"attributes":3041,"children":3042},{"class":1691},[3043,3047],{"type":459,"nodeName":467,"attributes":3044,"children":3045},{"class":1580,"id":263,"href":984},[3046],{"type":464,"textContent":987},{"type":464,"textContent":3048},".  Informational Fields",{"type":464,"textContent":3050},"\n\n   The informational fields are all optional.  The \"Subject:\" and\n   \"Comments:\" fields are unstructured fields as defined in ",{"type":459,"nodeName":467,"attributes":3052,"children":3053},{"href":685},[3054],{"type":464,"textContent":2008},{"type":464,"textContent":624},{"type":459,"nodeName":467,"attributes":3057,"children":3058},{"href":685},[3059],{"type":464,"textContent":688},{"type":464,"textContent":3061},", and therefore may contain text or folding white space.  The\n   \"Keywords:\" field contains a comma-separated list of one or more\n   words or quoted-strings.\n\n   subject         =   \"Subject:\" unstructured CRLF\n\n   comments        =   \"Comments:\" unstructured CRLF\n\n   keywords        =   \"Keywords:\" phrase *(\",\" phrase) CRLF\n\n   These three fields are intended to have only human-readable content\n   with information about the message.  The \"Subject:\" field is the most\n   common and contains a short string identifying the topic of the\n\n\n\n",{"type":459,"nodeName":484,"attributes":3063,"children":3064},{"class":507},[3065],{"type":464,"textContent":3066},"Resnick                     Standards Track                    [Page 27]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3069,"children":3070},{"class":516},[],{"type":459,"nodeName":460,"attributes":3072,"children":3073},{"class":520},[3074,3078,3079,3087,3089,3098,3100],{"type":459,"nodeName":484,"attributes":3075,"children":3077},{"id":3076},"page-28",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3080,"children":3081},{"class":507},[3082,3086],{"type":459,"nodeName":467,"attributes":3083,"children":3084},{"href":532},[3085],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":3088},"\n\n\n   message.  When used in a reply, the field body MAY start with the\n   string \"Re: \" (an abbreviation of the Latin \"in re\", meaning \"in the\n   matter of\") followed by the contents of the \"Subject:\" field body of\n   the original message.  If this is done, only one instance of the\n   literal string \"Re: \" ought to be used since use of other strings or\n   more than one instance can lead to undesirable consequences.  The\n   \"Comments:\" field contains any additional comments on the text of the\n   body of the message.  The \"Keywords:\" field contains a comma-\n   separated list of important words and phrases that might be useful\n   for the recipient.\n\n",{"type":459,"nodeName":484,"attributes":3090,"children":3091},{"class":1691},[3092,3096],{"type":459,"nodeName":467,"attributes":3093,"children":3094},{"class":1580,"id":268,"href":999},[3095],{"type":464,"textContent":1002},{"type":464,"textContent":3097},".  Resent Fields",{"type":464,"textContent":3099},"\n\n   Resent fields SHOULD be added to any message that is reintroduced by\n   a user into the transport system.  A separate set of resent fields\n   SHOULD be added each time this is done.  All of the resent fields\n   corresponding to a particular resending of the message SHOULD be\n   grouped together.  Each new set of resent fields is prepended to the\n   message; that is, the most recent set of resent fields appears\n   earlier in the message.  No other fields in the message are changed\n   when resent fields are added.\n\n   Each of the resent fields corresponds to a particular field elsewhere\n   in the syntax.  For instance, the \"Resent-Date:\" field corresponds to\n   the \"Date:\" field and the \"Resent-To:\" field corresponds to the \"To:\"\n   field.  In each case, the syntax for the field body is identical to\n   the syntax given previously for the corresponding field.\n\n   When resent fields are used, the \"Resent-From:\" and \"Resent-Date:\"\n   fields MUST be sent.  The \"Resent-Message-ID:\" field SHOULD be sent.\n   \"Resent-Sender:\" SHOULD NOT be used if \"Resent-Sender:\" would be\n   identical to \"Resent-From:\".\n\n   resent-date     =   \"Resent-Date:\" date-time CRLF\n\n   resent-from     =   \"Resent-From:\" mailbox-list CRLF\n\n   resent-sender   =   \"Resent-Sender:\" mailbox CRLF\n\n   resent-to       =   \"Resent-To:\" address-list CRLF\n\n   resent-cc       =   \"Resent-Cc:\" address-list CRLF\n\n   resent-bcc      =   \"Resent-Bcc:\" [address-list \u002F CFWS] CRLF\n\n   resent-msg-id   =   \"Resent-Message-ID:\" msg-id CRLF\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":3101,"children":3102},{"class":507},[3103],{"type":464,"textContent":3104},"Resnick                     Standards Track                    [Page 28]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3107,"children":3108},{"class":516},[],{"type":459,"nodeName":460,"attributes":3110,"children":3111},{"class":520},[3112,3116,3117,3125,3127],{"type":459,"nodeName":484,"attributes":3113,"children":3115},{"id":3114},"page-29",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3118,"children":3119},{"class":507},[3120,3124],{"type":459,"nodeName":467,"attributes":3121,"children":3122},{"href":532},[3123],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":3126},"\n\n\n   Resent fields are used to identify a message as having been\n   reintroduced into the transport system by a user.  The purpose of\n   using resent fields is to have the message appear to the final\n   recipient as if it were sent directly by the original sender, with\n   all of the original fields remaining the same.  Each set of resent\n   fields correspond to a particular resending event.  That is, if a\n   message is resent multiple times, each set of resent fields gives\n   identifying information for each individual time.  Resent fields are\n   strictly informational.  They MUST NOT be used in the normal\n   processing of replies or other such automatic actions on messages.\n\n      Note: Reintroducing a message into the transport system and using\n      resent fields is a different operation from \"forwarding\".\n      \"Forwarding\" has two meanings: One sense of forwarding is that a\n      mail reading program can be told by a user to forward a copy of a\n      message to another person, making the forwarded message the body\n      of the new message.  A forwarded message in this sense does not\n      appear to have come from the original sender, but is an entirely\n      new message from the forwarder of the message.  Forwarding may\n      also mean that a mail transport program gets a message and\n      forwards it on to a different destination for final delivery.\n      Resent header fields are not intended for use with either type of\n      forwarding.\n\n   The resent originator fields indicate the mailbox of the person(s) or\n   system(s) that resent the message.  As with the regular originator\n   fields, there are two forms: a simple \"Resent-From:\" form, which\n   contains the mailbox of the individual doing the resending, and the\n   more complex form, when one individual (identified in the \"Resent-\n   Sender:\" field) resends a message on behalf of one or more others\n   (identified in the \"Resent-From:\" field).\n\n      Note: When replying to a resent message, replies behave just as\n      they would with any other message, using the original \"From:\",\n      \"Reply-To:\", \"Message-ID:\", and other fields.  The resent fields\n      are only informational and MUST NOT be used in the normal\n      processing of replies.\n\n   The \"Resent-Date:\" indicates the date and time at which the resent\n   message is dispatched by the resender of the message.  Like the\n   \"Date:\" field, it is not the date and time that the message was\n   actually transported.\n\n   The \"Resent-To:\", \"Resent-Cc:\", and \"Resent-Bcc:\" fields function\n   identically to the \"To:\", \"Cc:\", and \"Bcc:\" fields, respectively,\n   except that they indicate the recipients of the resent message, not\n   the recipients of the original message.\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":3128,"children":3129},{"class":507},[3130],{"type":464,"textContent":3131},"Resnick                     Standards Track                    [Page 29]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3134,"children":3135},{"class":516},[],{"type":459,"nodeName":460,"attributes":3137,"children":3138},{"class":520},[3139,3143,3144,3152,3154,3163,3165,3169,3171,3175,3177,3186,3188],{"type":459,"nodeName":484,"attributes":3140,"children":3142},{"id":3141},"page-30",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3145,"children":3146},{"class":507},[3147,3151],{"type":459,"nodeName":467,"attributes":3148,"children":3149},{"href":532},[3150],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":3153},"\n\n\n   The \"Resent-Message-ID:\" field provides a unique identifier for the\n   resent message.\n\n",{"type":459,"nodeName":484,"attributes":3155,"children":3156},{"class":1691},[3157,3161],{"type":459,"nodeName":467,"attributes":3158,"children":3159},{"class":1580,"id":273,"href":1014},[3160],{"type":464,"textContent":1017},{"type":464,"textContent":3162},".  Trace Fields",{"type":464,"textContent":3164},"\n\n   The trace fields are a group of header fields consisting of an\n   optional \"Return-Path:\" field, and one or more \"Received:\" fields.\n   The \"Return-Path:\" header field contains a pair of angle brackets\n   that enclose an optional addr-spec.  The \"Received:\" field contains a\n   (possibly empty) list of tokens followed by a semicolon and a date-\n   time specification.  Each token must be a word, angle-addr, addr-\n   spec, or a domain.  Further restrictions are applied to the syntax of\n   the trace fields by specifications that provide for their use, such\n   as [",{"type":459,"nodeName":467,"attributes":3166,"children":3167},{"href":1647},[3168],{"type":464,"textContent":1650},{"type":464,"textContent":3170},"].\n\n   trace           =   [return]\n                       1*received\n\n   return          =   \"Return-Path:\" path CRLF\n\n   path            =   angle-addr \u002F ([CFWS] \"\u003C\" [CFWS] \">\" [CFWS])\n\n   received        =   \"Received:\" *received-token \";\" date-time CRLF\n\n   received-token  =   word \u002F angle-addr \u002F addr-spec \u002F domain\n\n   A full discussion of the Internet mail use of trace fields is\n   contained in [",{"type":459,"nodeName":467,"attributes":3172,"children":3173},{"href":1647},[3174],{"type":464,"textContent":1650},{"type":464,"textContent":3176},"].  For the purposes of this specification, the\n   trace fields are strictly informational, and any formal\n   interpretation of them is outside of the scope of this document.\n\n",{"type":459,"nodeName":484,"attributes":3178,"children":3179},{"class":1691},[3180,3184],{"type":459,"nodeName":467,"attributes":3181,"children":3182},{"class":1580,"id":278,"href":1029},[3183],{"type":464,"textContent":1032},{"type":464,"textContent":3185},".  Optional Fields",{"type":464,"textContent":3187},"\n\n   Fields may appear in messages that are otherwise unspecified in this\n   document.  They MUST conform to the syntax of an optional-field.\n   This is a field name, made up of the printable US-ASCII characters\n   except SP and colon, followed by a colon, followed by any text that\n   conforms to the unstructured syntax.\n\n   The field names of any optional field MUST NOT be identical to any\n   field name specified elsewhere in this document.\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":3189,"children":3190},{"class":507},[3191],{"type":464,"textContent":3192},"Resnick                     Standards Track                    [Page 30]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3195,"children":3196},{"class":516},[],{"type":459,"nodeName":460,"attributes":3198,"children":3199},{"class":520},[3200,3204,3205,3213,3215,3224,3226,3230,3232,3236,3238,3242,3244,3249,3251],{"type":459,"nodeName":484,"attributes":3201,"children":3203},{"id":3202},"page-31",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3206,"children":3207},{"class":507},[3208,3212],{"type":459,"nodeName":467,"attributes":3209,"children":3210},{"href":532},[3211],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":3214},"\n\n\n   optional-field  =   field-name \":\" unstructured CRLF\n\n   field-name      =   1*ftext\n\n   ftext           =   %d33-57 \u002F          ; Printable US-ASCII\n                       %d59-126           ;  characters not including\n                                          ;  \":\".\n\n   For the purposes of this specification, any optional field is\n   uninterpreted.\n\n",{"type":459,"nodeName":484,"attributes":3216,"children":3217},{"class":1576},[3218,3222],{"type":459,"nodeName":467,"attributes":3219,"children":3220},{"class":1580,"id":283,"href":1042},[3221],{"type":464,"textContent":553},{"type":464,"textContent":3223},".  Obsolete Syntax",{"type":464,"textContent":3225},"\n\n   Earlier versions of this specification allowed for different (usually\n   more liberal) syntax than is allowed in this version.  Also, there\n   have been syntactic elements used in messages on the Internet whose\n   interpretations have never been documented.  Though these syntactic\n   forms MUST NOT be generated according to the grammar in ",{"type":459,"nodeName":467,"attributes":3227,"children":3228},{"href":739},[3229],{"type":464,"textContent":1764},{"type":464,"textContent":3231},",\n   they MUST be accepted and parsed by a conformant receiver.  This\n   section documents many of these syntactic elements.  Taking the\n   grammar in ",{"type":459,"nodeName":467,"attributes":3233,"children":3234},{"href":739},[3235],{"type":464,"textContent":1764},{"type":464,"textContent":3237}," and adding the definitions presented in this\n   section will result in the grammar to use for the interpretation of\n   messages.\n\n      Note: This section identifies syntactic forms that any\n      implementation MUST reasonably interpret.  However, there are\n      certainly Internet messages that do not conform to even the\n      additional syntax given in this section.  The fact that a\n      particular form does not appear in any section of this document is\n      not justification for computer programs to crash or for malformed\n      data to be irretrievably lost by any implementation.  It is up to\n      the implementation to deal with messages robustly.\n\n   One important difference between the obsolete (interpreting) and the\n   current (generating) syntax is that in structured header field bodies\n   (i.e., between the colon and the CRLF of any structured header\n   field), white space characters, including folding white space, and\n   comments could be freely inserted between any syntactic tokens.  This\n   allowed many complex forms that have proven difficult for some\n   implementations to parse.\n\n   Another key difference between the obsolete and the current syntax is\n   that the rule in ",{"type":459,"nodeName":467,"attributes":3239,"children":3240},{"href":793},[3241],{"type":464,"textContent":2078},{"type":464,"textContent":3243}," regarding lines composed entirely of\n   white space in comments and folding white space does not apply.  See\n   the discussion of folding white space in ",{"type":459,"nodeName":467,"attributes":3245,"children":3246},{"href":1071},[3247],{"type":464,"textContent":3248},"section 4.2",{"type":464,"textContent":3250}," below.\n\n   Finally, certain characters that were formerly allowed in messages\n   appear in this section.  The NUL character (ASCII value 0) was once\n\n\n\n",{"type":459,"nodeName":484,"attributes":3252,"children":3253},{"class":507},[3254],{"type":464,"textContent":3255},"Resnick                     Standards Track                    [Page 31]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3258,"children":3259},{"class":516},[],{"type":459,"nodeName":460,"attributes":3261,"children":3262},{"class":520},[3263,3267,3268,3276,3278,3287,3289,3294,3296],{"type":459,"nodeName":484,"attributes":3264,"children":3266},{"id":3265},"page-32",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3269,"children":3270},{"class":507},[3271,3275],{"type":459,"nodeName":467,"attributes":3272,"children":3273},{"href":532},[3274],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":3277},"\n\n\n   allowed, but is no longer for compatibility reasons.  Similarly, US-\n   ASCII control characters other than CR, LF, SP, and HTAB (ASCII\n   values 1 through 8, 11, 12, 14 through 31, and 127) were allowed to\n   appear in header field bodies.  CR and LF were allowed to appear in\n   messages other than as CRLF; this use is also shown here.\n\n   Other differences in syntax and semantics are noted in the following\n   sections.\n\n",{"type":459,"nodeName":484,"attributes":3279,"children":3280},{"class":1589},[3281,3285],{"type":459,"nodeName":467,"attributes":3282,"children":3283},{"class":1580,"id":289,"href":1056},[3284],{"type":464,"textContent":1059},{"type":464,"textContent":3286},".  Miscellaneous Obsolete Tokens",{"type":464,"textContent":3288},"\n\n   These syntactic elements are used elsewhere in the obsolete syntax or\n   in the main syntax.  Bare CR, bare LF, and NUL are added to obs-qp,\n   obs-body, and obs-unstruct.  US-ASCII control characters are added to\n   obs-qp, obs-unstruct, obs-ctext, and obs-qtext.  The period character\n   is added to obs-phrase.  The obs-phrase-list provides for a\n   (potentially empty) comma-separated list of phrases that may include\n   \"null\" elements.  That is, there could be two or more commas in such\n   a list with nothing in between them, or commas at the beginning or\n   end of the list.\n\n      Note: The \"period\" (or \"full stop\") character (\".\") in obs-phrase\n      is not a form that was allowed in earlier versions of this or any\n      other specification.  Period (nor any other character from\n      specials) was not allowed in phrase because it introduced a\n      parsing difficulty distinguishing between phrases and portions of\n      an addr-spec (see ",{"type":459,"nodeName":467,"attributes":3290,"children":3291},{"href":1099},[3292],{"type":464,"textContent":3293},"section 4.4",{"type":464,"textContent":3295},").  It appears here because the\n      period character is currently used in many messages in the\n      display-name portion of addresses, especially for initials in\n      names, and therefore must be interpreted properly.\n\n   obs-NO-WS-CTL   =   %d1-8 \u002F            ; US-ASCII control\n                       %d11 \u002F             ;  characters that do not\n                       %d12 \u002F             ;  include the carriage\n                       %d14-31 \u002F          ;  return, line feed, and\n                       %d127              ;  white space characters\n\n   obs-ctext       =   obs-NO-WS-CTL\n\n   obs-qtext       =   obs-NO-WS-CTL\n\n   obs-utext       =   %d0 \u002F obs-NO-WS-CTL \u002F VCHAR\n\n   obs-qp          =   \"\\\" (%d0 \u002F obs-NO-WS-CTL \u002F LF \u002F CR)\n\n   obs-body        =   *((*LF *CR *((%d0 \u002F text) *LF *CR)) \u002F CRLF)\n\n   obs-unstruct    =   *((*LF *CR *(obs-utext *LF *CR)) \u002F FWS)\n\n\n\n",{"type":459,"nodeName":484,"attributes":3297,"children":3298},{"class":507},[3299],{"type":464,"textContent":3300},"Resnick                     Standards Track                    [Page 32]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3303,"children":3304},{"class":516},[],{"type":459,"nodeName":460,"attributes":3306,"children":3307},{"class":520},[3308,3312,3313,3321,3323,3332,3334,3343,3345],{"type":459,"nodeName":484,"attributes":3309,"children":3311},{"id":3310},"page-33",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3314,"children":3315},{"class":507},[3316,3320],{"type":459,"nodeName":467,"attributes":3317,"children":3318},{"href":532},[3319],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":3322},"\n\n\n   obs-phrase      =   word *(word \u002F \".\" \u002F CFWS)\n\n   obs-phrase-list =   [phrase \u002F CFWS] *(\",\" [phrase \u002F CFWS])\n\n   Bare CR and bare LF appear in messages with two different meanings.\n   In many cases, bare CR or bare LF are used improperly instead of CRLF\n   to indicate line separators.  In other cases, bare CR and bare LF are\n   used simply as US-ASCII control characters with their traditional\n   ASCII meanings.\n\n",{"type":459,"nodeName":484,"attributes":3324,"children":3325},{"class":1589},[3326,3330],{"type":459,"nodeName":467,"attributes":3327,"children":3328},{"class":1580,"id":294,"href":1071},[3329],{"type":464,"textContent":1074},{"type":464,"textContent":3331},".  Obsolete Folding White Space",{"type":464,"textContent":3333},"\n\n   In the obsolete syntax, any amount of folding white space MAY be\n   inserted where the obs-FWS rule is allowed.  This creates the\n   possibility of having two consecutive \"folds\" in a line, and\n   therefore the possibility that a line which makes up a folded header\n   field could be composed entirely of white space.\n\n   obs-FWS         =   1*WSP *(CRLF 1*WSP)\n\n",{"type":459,"nodeName":484,"attributes":3335,"children":3336},{"class":1589},[3337,3341],{"type":459,"nodeName":467,"attributes":3338,"children":3339},{"class":1580,"id":299,"href":1086},[3340],{"type":464,"textContent":1089},{"type":464,"textContent":3342},".  Obsolete Date and Time",{"type":464,"textContent":3344},"\n\n   The syntax for the obsolete date format allows a 2 digit year in the\n   date field and allows for a list of alphabetic time zone specifiers\n   that were used in earlier versions of this specification.  It also\n   permits comments and folding white space between many of the tokens.\n\n   obs-day-of-week =   [CFWS] day-name [CFWS]\n\n   obs-day         =   [CFWS] 1*2DIGIT [CFWS]\n\n   obs-year        =   [CFWS] 2*DIGIT [CFWS]\n\n   obs-hour        =   [CFWS] 2DIGIT [CFWS]\n\n   obs-minute      =   [CFWS] 2DIGIT [CFWS]\n\n   obs-second      =   [CFWS] 2DIGIT [CFWS]\n\n   obs-zone        =   \"UT\" \u002F \"GMT\" \u002F     ; Universal Time\n                                          ; North American UT\n                                          ; offsets\n                       \"EST\" \u002F \"EDT\" \u002F    ; Eastern:  - 5\u002F - 4\n                       \"CST\" \u002F \"CDT\" \u002F    ; Central:  - 6\u002F - 5\n                       \"MST\" \u002F \"MDT\" \u002F    ; Mountain: - 7\u002F - 6\n                       \"PST\" \u002F \"PDT\" \u002F    ; Pacific:  - 8\u002F - 7\n                                          ;\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":3346,"children":3347},{"class":507},[3348],{"type":464,"textContent":3349},"Resnick                     Standards Track                    [Page 33]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3352,"children":3353},{"class":516},[],{"type":459,"nodeName":460,"attributes":3355,"children":3356},{"class":520},[3357,3361,3362,3370,3372,3376,3378,3382,3384],{"type":459,"nodeName":484,"attributes":3358,"children":3360},{"id":3359},"page-34",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3363,"children":3364},{"class":507},[3365,3369],{"type":459,"nodeName":467,"attributes":3366,"children":3367},{"href":532},[3368],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":3371},"\n\n\n                       %d65-73 \u002F          ; Military zones - \"A\"\n                       %d75-90 \u002F          ; through \"I\" and \"K\"\n                       %d97-105 \u002F         ; through \"Z\", both\n                       %d107-122          ; upper and lower case\n\n   Where a two or three digit year occurs in a date, the year is to be\n   interpreted as follows: If a two digit year is encountered whose\n   value is between 00 and 49, the year is interpreted by adding 2000,\n   ending up with a value between 2000 and 2049.  If a two digit year is\n   encountered with a value between 50 and 99, or any three digit year\n   is encountered, the year is interpreted by adding 1900.\n\n   In the obsolete time zone, \"UT\" and \"GMT\" are indications of\n   \"Universal Time\" and \"Greenwich Mean Time\", respectively, and are\n   both semantically identical to \"+0000\".\n\n   The remaining three character zones are the US time zones.  The first\n   letter, \"E\", \"C\", \"M\", or \"P\" stands for \"Eastern\", \"Central\",\n   \"Mountain\", and \"Pacific\".  The second letter is either \"S\" for\n   \"Standard\" time, or \"D\" for \"Daylight Savings\" (or summer) time.\n   Their interpretations are as follows:\n\n      EDT is semantically equivalent to -0400\n      EST is semantically equivalent to -0500\n      CDT is semantically equivalent to -0500\n      CST is semantically equivalent to -0600\n      MDT is semantically equivalent to -0600\n      MST is semantically equivalent to -0700\n      PDT is semantically equivalent to -0700\n      PST is semantically equivalent to -0800\n\n   The 1 character military time zones were defined in a non-standard\n   way in [",{"type":459,"nodeName":467,"attributes":3373,"children":3374},{"href":1608},[3375],{"type":464,"textContent":1611},{"type":464,"textContent":3377},"] and are therefore unpredictable in their meaning.\n   The original definitions of the military zones \"A\" through \"I\" are\n   equivalent to \"+0100\" through \"+0900\", respectively; \"K\", \"L\", and\n   \"M\" are equivalent to \"+1000\", \"+1100\", and \"+1200\", respectively;\n   \"N\" through \"Y\" are equivalent to \"-0100\" through \"-1200\".\n   respectively; and \"Z\" is equivalent to \"+0000\".  However, because of\n   the error in [",{"type":459,"nodeName":467,"attributes":3379,"children":3380},{"href":1608},[3381],{"type":464,"textContent":1611},{"type":464,"textContent":3383},"], they SHOULD all be considered equivalent to\n   \"-0000\" unless there is out-of-band information confirming their\n   meaning.\n\n   Other multi-character (usually between 3 and 5) alphabetic time zones\n   have been used in Internet messages.  Any such time zone whose\n   meaning is not known SHOULD be considered equivalent to \"-0000\"\n   unless there is out-of-band information confirming their meaning.\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":3385,"children":3386},{"class":507},[3387],{"type":464,"textContent":3388},"Resnick                     Standards Track                    [Page 34]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3391,"children":3392},{"class":516},[],{"type":459,"nodeName":460,"attributes":3394,"children":3395},{"class":520},[3396,3400,3401,3409,3410,3419,3421,3430,3432],{"type":459,"nodeName":484,"attributes":3397,"children":3399},{"id":3398},"page-35",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3402,"children":3403},{"class":507},[3404,3408],{"type":459,"nodeName":467,"attributes":3405,"children":3406},{"href":532},[3407],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":3411,"children":3412},{"class":1589},[3413,3417],{"type":459,"nodeName":467,"attributes":3414,"children":3415},{"class":1580,"id":304,"href":1099},[3416],{"type":464,"textContent":1102},{"type":464,"textContent":3418},".  Obsolete Addressing",{"type":464,"textContent":3420},"\n\n   There are four primary differences in addressing.  First, mailbox\n   addresses were allowed to have a route portion before the addr-spec\n   when enclosed in \"\u003C\" and \">\".  The route is simply a comma-separated\n   list of domain names, each preceded by \"@\", and the list terminated\n   by a colon.  Second, CFWS were allowed between the period-separated\n   elements of local-part and domain (i.e., dot-atom was not used).  In\n   addition, local-part is allowed to contain quoted-string in addition\n   to just atom.  Third, mailbox-list and address-list were allowed to\n   have \"null\" members.  That is, there could be two or more commas in\n   such a list with nothing in between them, or commas at the beginning\n   or end of the list.  Finally, US-ASCII control characters and quoted-\n   pairs were allowed in domain literals and are added here.\n\n   obs-angle-addr  =   [CFWS] \"\u003C\" obs-route addr-spec \">\" [CFWS]\n\n   obs-route       =   obs-domain-list \":\"\n\n   obs-domain-list =   *(CFWS \u002F \",\") \"@\" domain\n                       *(\",\" [CFWS] [\"@\" domain])\n\n   obs-mbox-list   =   *([CFWS] \",\") mailbox *(\",\" [mailbox \u002F CFWS])\n\n   obs-addr-list   =   *([CFWS] \",\") address *(\",\" [address \u002F CFWS])\n\n   obs-group-list  =   1*([CFWS] \",\") [CFWS]\n\n   obs-local-part  =   word *(\".\" word)\n\n   obs-domain      =   atom *(\".\" atom)\n\n   obs-dtext       =   obs-NO-WS-CTL \u002F quoted-pair\n\n   When interpreting addresses, the route portion SHOULD be ignored.\n\n",{"type":459,"nodeName":484,"attributes":3422,"children":3423},{"class":1589},[3424,3428],{"type":459,"nodeName":467,"attributes":3425,"children":3426},{"class":1580,"id":309,"href":1114},[3427],{"type":464,"textContent":1117},{"type":464,"textContent":3429},".  Obsolete Header Fields",{"type":464,"textContent":3431},"\n\n   Syntactically, the primary difference in the obsolete field syntax is\n   that it allows multiple occurrences of any of the fields and they may\n   occur in any order.  Also, any amount of white space is allowed\n   before the \":\" at the end of the field name.\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":3433,"children":3434},{"class":507},[3435],{"type":464,"textContent":3436},"Resnick                     Standards Track                    [Page 35]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3439,"children":3440},{"class":516},[],{"type":459,"nodeName":460,"attributes":3442,"children":3443},{"class":520},[3444,3448,3449,3457,3459,3464,3466,3470,3471,3480,3482,3491,3493],{"type":459,"nodeName":484,"attributes":3445,"children":3447},{"id":3446},"page-36",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3450,"children":3451},{"class":507},[3452,3456],{"type":459,"nodeName":467,"attributes":3453,"children":3454},{"href":532},[3455],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":3458},"\n\n\n   obs-fields      =   *(obs-return \u002F\n                       obs-received \u002F\n                       obs-orig-date \u002F\n                       obs-from \u002F\n                       obs-sender \u002F\n                       obs-reply-to \u002F\n                       obs-to \u002F\n                       obs-cc \u002F\n                       obs-bcc \u002F\n                       obs-message-id \u002F\n                       obs-in-reply-to \u002F\n                       obs-references \u002F\n                       obs-subject \u002F\n                       obs-comments \u002F\n                       obs-keywords \u002F\n                       obs-resent-date \u002F\n                       obs-resent-from \u002F\n                       obs-resent-send \u002F\n                       obs-resent-rply \u002F\n                       obs-resent-to \u002F\n                       obs-resent-cc \u002F\n                       obs-resent-bcc \u002F\n                       obs-resent-mid \u002F\n                       obs-optional)\n\n   Except for destination address fields (described in ",{"type":459,"nodeName":467,"attributes":3460,"children":3461},{"href":1155},[3462],{"type":464,"textContent":3463},"section 4.5.3",{"type":464,"textContent":3465},"),\n   the interpretation of multiple occurrences of fields is unspecified.\n   Also, the interpretation of trace fields and resent fields that do\n   not occur in blocks prepended to the message is unspecified as well.\n   Unless otherwise noted in the following sections, interpretation of\n   other fields is identical to the interpretation of their non-obsolete\n   counterparts in ",{"type":459,"nodeName":467,"attributes":3467,"children":3468},{"href":739},[3469],{"type":464,"textContent":1764},{"type":464,"textContent":2307},{"type":459,"nodeName":484,"attributes":3472,"children":3473},{"class":1691},[3474,3478],{"type":459,"nodeName":467,"attributes":3475,"children":3476},{"class":1580,"id":315,"href":1127},[3477],{"type":464,"textContent":1130},{"type":464,"textContent":3479},".  Obsolete Origination Date Field",{"type":464,"textContent":3481},"\n\n   obs-orig-date   =   \"Date\" *WSP \":\" date-time CRLF\n\n",{"type":459,"nodeName":484,"attributes":3483,"children":3484},{"class":1691},[3485,3489],{"type":459,"nodeName":467,"attributes":3486,"children":3487},{"class":1580,"id":320,"href":1142},[3488],{"type":464,"textContent":1145},{"type":464,"textContent":3490},".  Obsolete Originator Fields",{"type":464,"textContent":3492},"\n\n   obs-from        =   \"From\" *WSP \":\" mailbox-list CRLF\n\n   obs-sender      =   \"Sender\" *WSP \":\" mailbox CRLF\n\n   obs-reply-to    =   \"Reply-To\" *WSP \":\" address-list CRLF\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":3494,"children":3495},{"class":507},[3496],{"type":464,"textContent":3497},"Resnick                     Standards Track                    [Page 36]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3500,"children":3501},{"class":516},[],{"type":459,"nodeName":460,"attributes":3503,"children":3504},{"class":520},[3505,3509,3510,3518,3519,3528,3530,3539,3541,3550,3552],{"type":459,"nodeName":484,"attributes":3506,"children":3508},{"id":3507},"page-37",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3511,"children":3512},{"class":507},[3513,3517],{"type":459,"nodeName":467,"attributes":3514,"children":3515},{"href":532},[3516],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":3520,"children":3521},{"class":1691},[3522,3526],{"type":459,"nodeName":467,"attributes":3523,"children":3524},{"class":1580,"id":325,"href":1155},[3525],{"type":464,"textContent":1158},{"type":464,"textContent":3527},".  Obsolete Destination Address Fields",{"type":464,"textContent":3529},"\n\n   obs-to          =   \"To\" *WSP \":\" address-list CRLF\n\n   obs-cc          =   \"Cc\" *WSP \":\" address-list CRLF\n\n   obs-bcc         =   \"Bcc\" *WSP \":\"\n                       (address-list \u002F (*([CFWS] \",\") [CFWS])) CRLF\n\n   When multiple occurrences of destination address fields occur in a\n   message, they SHOULD be treated as if the address list in the first\n   occurrence of the field is combined with the address lists of the\n   subsequent occurrences by adding a comma and concatenating.\n\n",{"type":459,"nodeName":484,"attributes":3531,"children":3532},{"class":1691},[3533,3537],{"type":459,"nodeName":467,"attributes":3534,"children":3535},{"class":1580,"id":330,"href":1170},[3536],{"type":464,"textContent":1173},{"type":464,"textContent":3538},".  Obsolete Identification Fields",{"type":464,"textContent":3540},"\n\n   The obsolete \"In-Reply-To:\" and \"References:\" fields differ from the\n   current syntax in that they allow phrase (words or quoted strings) to\n   appear.  The obsolete forms of the left and right sides of msg-id\n   allow interspersed CFWS, making them syntactically identical to\n   local-part and domain, respectively.\n\n   obs-message-id  =   \"Message-ID\" *WSP \":\" msg-id CRLF\n\n   obs-in-reply-to =   \"In-Reply-To\" *WSP \":\" *(phrase \u002F msg-id) CRLF\n\n   obs-references  =   \"References\" *WSP \":\" *(phrase \u002F msg-id) CRLF\n\n   obs-id-left     =   local-part\n\n   obs-id-right    =   domain\n\n   For purposes of interpretation, the phrases in the \"In-Reply-To:\" and\n   \"References:\" fields are ignored.\n\n   Semantically, none of the optional CFWS in the local-part and the\n   domain is part of the obs-id-left and obs-id-right, respectively.\n\n",{"type":459,"nodeName":484,"attributes":3542,"children":3543},{"class":1691},[3544,3548],{"type":459,"nodeName":467,"attributes":3545,"children":3546},{"class":1580,"id":335,"href":1183},[3547],{"type":464,"textContent":1186},{"type":464,"textContent":3549},".  Obsolete Informational Fields",{"type":464,"textContent":3551},"\n\n   obs-subject     =   \"Subject\" *WSP \":\" unstructured CRLF\n\n   obs-comments    =   \"Comments\" *WSP \":\" unstructured CRLF\n\n   obs-keywords    =   \"Keywords\" *WSP \":\" obs-phrase-list CRLF\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":3553,"children":3554},{"class":507},[3555],{"type":464,"textContent":3556},"Resnick                     Standards Track                    [Page 37]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3559,"children":3560},{"class":516},[],{"type":459,"nodeName":460,"attributes":3562,"children":3563},{"class":520},[3564,3568,3569,3577,3578,3587,3589,3598,3600,3604,3606,3610,3612,3621,3623,3632,3634],{"type":459,"nodeName":484,"attributes":3565,"children":3567},{"id":3566},"page-38",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3570,"children":3571},{"class":507},[3572,3576],{"type":459,"nodeName":467,"attributes":3573,"children":3574},{"href":532},[3575],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":3579,"children":3580},{"class":1691},[3581,3585],{"type":459,"nodeName":467,"attributes":3582,"children":3583},{"class":1580,"id":340,"href":1224},[3584],{"type":464,"textContent":1227},{"type":464,"textContent":3586},".  Obsolete Resent Fields",{"type":464,"textContent":3588},"\n\n   The obsolete syntax adds a \"Resent-Reply-To:\" field, which consists\n   of the field name, the optional comments and folding white space, the\n   colon, and a comma separated list of addresses.\n\n   obs-resent-from =   \"Resent-From\" *WSP \":\" mailbox-list CRLF\n\n   obs-resent-send =   \"Resent-Sender\" *WSP \":\" mailbox CRLF\n\n   obs-resent-date =   \"Resent-Date\" *WSP \":\" date-time CRLF\n\n   obs-resent-to   =   \"Resent-To\" *WSP \":\" address-list CRLF\n\n   obs-resent-cc   =   \"Resent-Cc\" *WSP \":\" address-list CRLF\n\n   obs-resent-bcc  =   \"Resent-Bcc\" *WSP \":\"\n                       (address-list \u002F (*([CFWS] \",\") [CFWS])) CRLF\n\n   obs-resent-mid  =   \"Resent-Message-ID\" *WSP \":\" msg-id CRLF\n\n   obs-resent-rply =   \"Resent-Reply-To\" *WSP \":\" address-list CRLF\n\n   As with other resent fields, the \"Resent-Reply-To:\" field is to be\n   treated as trace information only.\n\n",{"type":459,"nodeName":484,"attributes":3590,"children":3591},{"class":1691},[3592,3596],{"type":459,"nodeName":467,"attributes":3593,"children":3594},{"class":1580,"id":345,"href":1239},[3595],{"type":464,"textContent":1242},{"type":464,"textContent":3597},".  Obsolete Trace Fields",{"type":464,"textContent":3599},"\n\n   The obs-return and obs-received are again given here as template\n   definitions, just as return and received are in ",{"type":459,"nodeName":467,"attributes":3601,"children":3602},{"href":739},[3603],{"type":464,"textContent":1764},{"type":464,"textContent":3605},".  Their\n   full syntax is given in [",{"type":459,"nodeName":467,"attributes":3607,"children":3608},{"href":1647},[3609],{"type":464,"textContent":1650},{"type":464,"textContent":3611},"].\n\n   obs-return      =   \"Return-Path\" *WSP \":\" path CRLF\n\n   obs-received    =   \"Received\" *WSP \":\" *received-token CRLF\n\n",{"type":459,"nodeName":484,"attributes":3613,"children":3614},{"class":1691},[3615,3619],{"type":459,"nodeName":467,"attributes":3616,"children":3617},{"class":1580,"id":350,"href":1252},[3618],{"type":464,"textContent":1255},{"type":464,"textContent":3620},".  Obsolete optional fields",{"type":464,"textContent":3622},"\n\n   obs-optional    =   field-name *WSP \":\" unstructured CRLF\n\n",{"type":459,"nodeName":484,"attributes":3624,"children":3625},{"class":1576},[3626,3630],{"type":459,"nodeName":467,"attributes":3627,"children":3628},{"class":1580,"id":355,"href":1265},[3629],{"type":464,"textContent":582},{"type":464,"textContent":3631},".  Security Considerations",{"type":464,"textContent":3633},"\n\n   Care needs to be taken when displaying messages on a terminal or\n   terminal emulator.  Powerful terminals may act on escape sequences\n   and other combinations of US-ASCII control characters with a variety\n   of consequences.  They can remap the keyboard or permit other\n   modifications to the terminal that could lead to denial of service or\n   even damaged data.  They can trigger (sometimes programmable)\n\n\n\n",{"type":459,"nodeName":484,"attributes":3635,"children":3636},{"class":507},[3637],{"type":464,"textContent":3638},"Resnick                     Standards Track                    [Page 38]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3641,"children":3642},{"class":516},[],{"type":459,"nodeName":460,"attributes":3644,"children":3645},{"class":520},[3646,3650,3651,3659,3661,3667,3668,3672,3674,3678,3679,3683,3684,3688,3689,3693,3694,3698,3700,3704,3705,3709,3710,3714,3715,3719,3720,3724,3725,3729,3731,3736,3738,3742,3744,3748,3750,3754,3756,3765,3767,3772,3774,3778,3780,3786,3788,3793,3795],{"type":459,"nodeName":484,"attributes":3647,"children":3649},{"id":3648},"page-39",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3652,"children":3653},{"class":507},[3654,3658],{"type":459,"nodeName":467,"attributes":3655,"children":3656},{"href":532},[3657],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":3660},"\n\n\n   answerback messages that can allow a message to cause commands to be\n   issued on the recipient's behalf.  They can also affect the operation\n   of terminal attached devices such as printers.  Message viewers may\n   wish to strip potentially dangerous terminal escape sequences from\n   the message prior to display.  However, other escape sequences appear\n   in messages for useful purposes (cf. [",{"type":459,"nodeName":467,"attributes":3662,"children":3664},{"href":3663},"#ref-ISO.2022.1994",[3665],{"type":464,"textContent":3666},"ISO.2022.1994",{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":3669,"children":3670},{"href":1624},[3671],{"type":464,"textContent":1627},{"type":464,"textContent":3673},"],\n   [",{"type":459,"nodeName":467,"attributes":3675,"children":3676},{"href":1632},[3677],{"type":464,"textContent":1635},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":3680,"children":3681},{"href":1892},[3682],{"type":464,"textContent":1895},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":3685,"children":3686},{"href":1639},[3687],{"type":464,"textContent":1642},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":3690,"children":3691},{"href":1904},[3692],{"type":464,"textContent":1907},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":3695,"children":3696},{"href":1911},[3697],{"type":464,"textContent":1914},{"type":464,"textContent":3699},"]) and therefore\n   should not be stripped indiscriminately.\n\n   Transmission of non-text objects in messages raises additional\n   security issues.  These issues are discussed in [",{"type":459,"nodeName":467,"attributes":3701,"children":3702},{"href":1624},[3703],{"type":464,"textContent":1627},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":3706,"children":3707},{"href":1632},[3708],{"type":464,"textContent":1635},{"type":464,"textContent":3673},{"type":459,"nodeName":467,"attributes":3711,"children":3712},{"href":1892},[3713],{"type":464,"textContent":1895},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":3716,"children":3717},{"href":1639},[3718],{"type":464,"textContent":1642},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":3721,"children":3722},{"href":1904},[3723],{"type":464,"textContent":1907},{"type":464,"textContent":2643},{"type":459,"nodeName":467,"attributes":3726,"children":3727},{"href":1911},[3728],{"type":464,"textContent":1914},{"type":464,"textContent":3730},"].\n\n   Many implementations use the \"Bcc:\" (blind carbon copy) field,\n   described in ",{"type":459,"nodeName":467,"attributes":3732,"children":3733},{"href":954},[3734],{"type":464,"textContent":3735},"section 3.6.3",{"type":464,"textContent":3737},", to facilitate sending messages to\n   recipients without revealing the addresses of one or more of the\n   addressees to the other recipients.  Mishandling this use of \"Bcc:\"\n   may disclose confidential information that could eventually lead to\n   security problems through knowledge of even the existence of a\n   particular mail address.  For example, if using the first method\n   described in ",{"type":459,"nodeName":467,"attributes":3739,"children":3740},{"href":954},[3741],{"type":464,"textContent":3735},{"type":464,"textContent":3743},", where the \"Bcc:\" line is removed from the\n   message, blind recipients have no explicit indication that they have\n   been sent a blind copy, except insofar as their address does not\n   appear in the header section of a message.  Because of this, one of\n   the blind addressees could potentially send a reply to all of the\n   shown recipients and accidentally reveal that the message went to the\n   blind recipient.  When the second method from ",{"type":459,"nodeName":467,"attributes":3745,"children":3746},{"href":954},[3747],{"type":464,"textContent":3735},{"type":464,"textContent":3749}," is used,\n   the blind recipient's address appears in the \"Bcc:\" field of a\n   separate copy of the message.  If the \"Bcc:\" field sent contains all\n   of the blind addressees, all of the \"Bcc:\" recipients will be seen by\n   each \"Bcc:\" recipient.  Even if a separate message is sent to each\n   \"Bcc:\" recipient with only the individual's address, implementations\n   still need to be careful to process replies to the message as per\n   ",{"type":459,"nodeName":467,"attributes":3751,"children":3752},{"href":954},[3753],{"type":464,"textContent":3735},{"type":464,"textContent":3755}," so as not to accidentally reveal the blind recipient to\n   other recipients.\n\n",{"type":459,"nodeName":484,"attributes":3757,"children":3758},{"class":1576},[3759,3763],{"type":459,"nodeName":467,"attributes":3760,"children":3761},{"class":1580,"id":360,"href":1277},[3762],{"type":464,"textContent":638},{"type":464,"textContent":3764},".  IANA Considerations",{"type":464,"textContent":3766},"\n\n   This document updates the registrations that appeared in [",{"type":459,"nodeName":467,"attributes":3768,"children":3769},{"href":477},[3770],{"type":464,"textContent":3771},"RFC4021",{"type":464,"textContent":3773},"]\n   that referred to the definitions in [",{"type":459,"nodeName":467,"attributes":3775,"children":3776},{"href":469},[3777],{"type":464,"textContent":1603},{"type":464,"textContent":3779},"].  IANA has updated the\n   Permanent Message Header Field Repository with the following header\n   fields, in accordance with the procedures set out in [",{"type":459,"nodeName":467,"attributes":3781,"children":3783},{"href":3782},"\u002Finfo\u002Frfc3864\u002F",[3784],{"type":464,"textContent":3785},"RFC3864",{"type":464,"textContent":3787},"].\n\n   Header field name:  Date\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3789,"children":3790},{"href":926},[3791],{"type":464,"textContent":3792},"section 3.6.1",{"type":464,"textContent":3794},")\n\n\n\n",{"type":459,"nodeName":484,"attributes":3796,"children":3797},{"class":507},[3798],{"type":464,"textContent":3799},"Resnick                     Standards Track                    [Page 39]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3802,"children":3803},{"class":516},[],{"type":459,"nodeName":460,"attributes":3805,"children":3806},{"class":520},[3807,3811,3812,3820,3822,3827,3829,3833,3835,3839,3841,3845,3847,3851,3853,3857,3859,3864,3866,3870,3872],{"type":459,"nodeName":484,"attributes":3808,"children":3810},{"id":3809},"page-40",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3813,"children":3814},{"class":507},[3815,3819],{"type":459,"nodeName":467,"attributes":3816,"children":3817},{"href":532},[3818],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":3821},"\n\n\n   Header field name:  From\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3823,"children":3824},{"href":941},[3825],{"type":464,"textContent":3826},"section 3.6.2",{"type":464,"textContent":3828},")\n\n   Header field name:  Sender\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3830,"children":3831},{"href":941},[3832],{"type":464,"textContent":3826},{"type":464,"textContent":3834},")\n\n   Header field name:  Reply-To\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3836,"children":3837},{"href":941},[3838],{"type":464,"textContent":3826},{"type":464,"textContent":3840},")\n\n   Header field name:  To\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3842,"children":3843},{"href":954},[3844],{"type":464,"textContent":3735},{"type":464,"textContent":3846},")\n\n   Header field name:  Cc\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3848,"children":3849},{"href":954},[3850],{"type":464,"textContent":3735},{"type":464,"textContent":3852},")\n\n   Header field name:  Bcc\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3854,"children":3855},{"href":954},[3856],{"type":464,"textContent":3735},{"type":464,"textContent":3858},")\n\n   Header field name:  Message-ID\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3860,"children":3861},{"href":969},[3862],{"type":464,"textContent":3863},"section 3.6.4",{"type":464,"textContent":3865},")\n\n   Header field name:  In-Reply-To\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3867,"children":3868},{"href":969},[3869],{"type":464,"textContent":3863},{"type":464,"textContent":3871},")\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":3873,"children":3874},{"class":507},[3875],{"type":464,"textContent":3876},"Resnick                     Standards Track                    [Page 40]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3879,"children":3880},{"class":516},[],{"type":459,"nodeName":460,"attributes":3882,"children":3883},{"class":520},[3884,3888,3889,3897,3899,3903,3905,3910,3912,3916,3918,3922,3924,3928,3930,3934,3936,3940,3942,3946,3947],{"type":459,"nodeName":484,"attributes":3885,"children":3887},{"id":3886},"page-41",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3890,"children":3891},{"class":507},[3892,3896],{"type":459,"nodeName":467,"attributes":3893,"children":3894},{"href":532},[3895],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":3898},"\n\n\n   Header field name:  References\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3900,"children":3901},{"href":969},[3902],{"type":464,"textContent":3863},{"type":464,"textContent":3904},")\n\n   Header field name:  Subject\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3906,"children":3907},{"href":984},[3908],{"type":464,"textContent":3909},"section 3.6.5",{"type":464,"textContent":3911},")\n\n   Header field name:  Comments\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3913,"children":3914},{"href":984},[3915],{"type":464,"textContent":3909},{"type":464,"textContent":3917},")\n\n   Header field name:  Keywords\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3919,"children":3920},{"href":984},[3921],{"type":464,"textContent":3909},{"type":464,"textContent":3923},")\n\n   Header field name:  Resent-Date\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3925,"children":3926},{"href":999},[3927],{"type":464,"textContent":3010},{"type":464,"textContent":3929},")\n\n   Header field name:  Resent-From\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3931,"children":3932},{"href":999},[3933],{"type":464,"textContent":3010},{"type":464,"textContent":3935},")\n\n   Header field name:  Resent-Sender\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3937,"children":3938},{"href":999},[3939],{"type":464,"textContent":3010},{"type":464,"textContent":3941},")\n\n   Header field name:  Resent-To\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3943,"children":3944},{"href":999},[3945],{"type":464,"textContent":3010},{"type":464,"textContent":3871},{"type":459,"nodeName":484,"attributes":3948,"children":3949},{"class":507},[3950],{"type":464,"textContent":3951},"Resnick                     Standards Track                    [Page 41]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":3954,"children":3955},{"class":516},[],{"type":459,"nodeName":460,"attributes":3957,"children":3958},{"class":520},[3959,3963,3964,3972,3974,3978,3980,3984,3986,3991,3993,3997,3999,4003,4005,4009,4011,4015,4017],{"type":459,"nodeName":484,"attributes":3960,"children":3962},{"id":3961},"page-42",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":3965,"children":3966},{"class":507},[3967,3971],{"type":459,"nodeName":467,"attributes":3968,"children":3969},{"href":532},[3970],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":3973},"\n\n\n   Header field name:  Resent-Cc\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3975,"children":3976},{"href":999},[3977],{"type":464,"textContent":3010},{"type":464,"textContent":3979},")\n\n   Header field name:  Resent-Bcc\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3981,"children":3982},{"href":999},[3983],{"type":464,"textContent":3010},{"type":464,"textContent":3985},")\n\n   Header field name:  Resent-Reply-To\n   Applicable protocol:  Mail\n   Status:  obsolete\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3987,"children":3988},{"href":1224},[3989],{"type":464,"textContent":3990},"section 4.5.6",{"type":464,"textContent":3992},")\n\n   Header field name:  Resent-Message-ID\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":3994,"children":3995},{"href":999},[3996],{"type":464,"textContent":3010},{"type":464,"textContent":3998},")\n\n   Header field name:  Return-Path\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":4000,"children":4001},{"href":1014},[4002],{"type":464,"textContent":3003},{"type":464,"textContent":4004},")\n\n   Header field name:  Received\n   Applicable protocol:  Mail\n   Status:  standard\n   Author\u002FChange controller:  IETF\n   Specification document(s):  This document (",{"type":459,"nodeName":467,"attributes":4006,"children":4007},{"href":1014},[4008],{"type":464,"textContent":3003},{"type":464,"textContent":4010},")\n   Related information:  [",{"type":459,"nodeName":467,"attributes":4012,"children":4013},{"href":1647},[4014],{"type":464,"textContent":1650},{"type":464,"textContent":4016},"]\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":4018,"children":4019},{"class":507},[4020],{"type":464,"textContent":4021},"Resnick                     Standards Track                    [Page 42]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4024,"children":4025},{"class":516},[],{"type":459,"nodeName":460,"attributes":4027,"children":4028},{"class":520},[4029,4033,4034,4042,4043,4052,4054,4058,4059,4063,4065],{"type":459,"nodeName":484,"attributes":4030,"children":4032},{"id":4031},"page-43",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4035,"children":4036},{"class":507},[4037,4041],{"type":459,"nodeName":467,"attributes":4038,"children":4039},{"href":532},[4040],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":4044,"children":4045},{"class":1576},[4046,4050],{"type":459,"nodeName":467,"attributes":4047,"children":4048},{"class":1580,"id":365,"href":1291},[4049],{"type":464,"textContent":1294},{"type":464,"textContent":4051},".  Example Messages",{"type":464,"textContent":4053},"\n\n   This section presents a selection of messages.  These are intended to\n   assist in the implementation of this specification, but should not be\n   taken as normative; that is to say, although the examples in this\n   section were carefully reviewed, if there happens to be a conflict\n   between these examples and the syntax described in sections ",{"type":459,"nodeName":467,"attributes":4055,"children":4056},{"href":739},[4057],{"type":464,"textContent":742},{"type":464,"textContent":1778},{"type":459,"nodeName":467,"attributes":4060,"children":4061},{"href":1042},[4062],{"type":464,"textContent":553},{"type":464,"textContent":4064},"\n   of this document, the syntax in those sections is to be taken as\n   correct.\n\n   In the text version of this document, messages in this section are\n   delimited between lines of \"----\".  The \"----\" lines are not part of\n   the message itself.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":4066,"children":4067},{"class":507},[4068],{"type":464,"textContent":4069},"Resnick                     Standards Track                    [Page 43]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4072,"children":4073},{"class":516},[],{"type":459,"nodeName":460,"attributes":4075,"children":4076},{"class":520},[4077,4081,4082,4090,4091,4100,4102,4111,4113],{"type":459,"nodeName":484,"attributes":4078,"children":4080},{"id":4079},"page-44",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4083,"children":4084},{"class":507},[4085,4089],{"type":459,"nodeName":467,"attributes":4086,"children":4087},{"href":532},[4088],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":4092,"children":4093},{"class":1589},[4094,4098],{"type":459,"nodeName":467,"attributes":4095,"children":4096},{"class":1580,"id":371,"href":1306},[4097],{"type":464,"textContent":1309},{"type":464,"textContent":4099},".  Addressing Examples",{"type":464,"textContent":4101},"\n\n   The following are examples of messages that might be sent between two\n   individuals.\n\n",{"type":459,"nodeName":484,"attributes":4103,"children":4104},{"class":1691},[4105,4109],{"type":459,"nodeName":467,"attributes":4106,"children":4107},{"class":1580,"id":377,"href":1321},[4108],{"type":464,"textContent":1324},{"type":464,"textContent":4110},".  A Message from One Person to Another with Simple",{"type":464,"textContent":4112},"\n                 Addressing\n\n   This could be called a canonical message.  It has a single author,\n   John Doe, a single recipient, Mary Smith, a subject, the date, a\n   message identifier, and a textual message in the body.\n\n   ----\n   From: John Doe \u003Cjdoe@machine.example>\n   To: Mary Smith \u003Cmary@example.net>\n   Subject: Saying Hello\n   Date: Fri, 21 Nov 1997 09:55:06 -0600\n   Message-ID: \u003C1234@local.machine.example>\n\n   This is a message just to say hello.\n   So, \"Hello\".\n   ----\n\n   If John's secretary Michael actually sent the message, even though\n   John was the author and replies to this message should go back to\n   him, the sender field would be used:\n\n   ----\n   From: John Doe \u003Cjdoe@machine.example>\n   Sender: Michael Jones \u003Cmjones@machine.example>\n   To: Mary Smith \u003Cmary@example.net>\n   Subject: Saying Hello\n   Date: Fri, 21 Nov 1997 09:55:06 -0600\n   Message-ID: \u003C1234@local.machine.example>\n\n   This is a message just to say hello.\n   So, \"Hello\".\n   ----\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":4114,"children":4115},{"class":507},[4116],{"type":464,"textContent":4117},"Resnick                     Standards Track                    [Page 44]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4120,"children":4121},{"class":516},[],{"type":459,"nodeName":460,"attributes":4123,"children":4124},{"class":520},[4125,4129,4130,4138,4139,4148,4150,4159,4161],{"type":459,"nodeName":484,"attributes":4126,"children":4128},{"id":4127},"page-45",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4131,"children":4132},{"class":507},[4133,4137],{"type":459,"nodeName":467,"attributes":4134,"children":4135},{"href":532},[4136],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":4140,"children":4141},{"class":1691},[4142,4146],{"type":459,"nodeName":467,"attributes":4143,"children":4144},{"class":1580,"id":382,"href":1334},[4145],{"type":464,"textContent":1337},{"type":464,"textContent":4147},".  Different Types of Mailboxes",{"type":464,"textContent":4149},"\n\n   This message includes multiple addresses in the destination fields\n   and also uses several different forms of addresses.\n\n   ----\n   From: \"Joe Q. Public\" \u003Cjohn.q.public@example.com>\n   To: Mary Smith \u003Cmary@x.test>, jdoe@example.org, Who? \u003Cone@y.test>\n   Cc: \u003Cboss@nil.test>, \"Giant; \\\"Big\\\" Box\" \u003Csysservices@example.net>\n   Date: Tue, 1 Jul 2003 10:52:37 +0200\n   Message-ID: \u003C5678.21-Nov-1997@example.com>\n\n   Hi everyone.\n   ----\n\n   Note that the display names for Joe Q. Public and Giant; \"Big\" Box\n   needed to be enclosed in double-quotes because the former contains\n   the period and the latter contains both semicolon and double-quote\n   characters (the double-quote characters appearing as quoted-pair\n   constructs).  Conversely, the display name for Who? could appear\n   without them because the question mark is legal in an atom.  Notice\n   also that jdoe@example.org and boss@nil.test have no display names\n   associated with them at all, and jdoe@example.org uses the simpler\n   address form without the angle brackets.\n\n",{"type":459,"nodeName":484,"attributes":4151,"children":4152},{"class":1691},[4153,4157],{"type":459,"nodeName":467,"attributes":4154,"children":4155},{"class":1580,"id":387,"href":1349},[4156],{"type":464,"textContent":1352},{"type":464,"textContent":4158},".  Group Addresses",{"type":464,"textContent":4160},"\n\n   ----\n   From: Pete \u003Cpete@silly.example>\n   To: A Group:Ed Jones \u003Cc@a.test>,joe@where.test,John \u003Cjdoe@one.test>;\n   Cc: Undisclosed recipients:;\n   Date: Thu, 13 Feb 1969 23:32:54 -0330\n   Message-ID: \u003Ctestabcd.1234@silly.example>\n\n   Testing.\n   ----\n\n   In this message, the \"To:\" field has a single group recipient named\n   \"A Group\", which contains 3 addresses, and a \"Cc:\" field with an\n   empty group recipient named Undisclosed recipients.\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":4162,"children":4163},{"class":507},[4164],{"type":464,"textContent":4165},"Resnick                     Standards Track                    [Page 45]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4168,"children":4169},{"class":516},[],{"type":459,"nodeName":460,"attributes":4171,"children":4172},{"class":520},[4173,4177,4178,4186,4187,4196,4198,4202,4204],{"type":459,"nodeName":484,"attributes":4174,"children":4176},{"id":4175},"page-46",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4179,"children":4180},{"class":507},[4181,4185],{"type":459,"nodeName":467,"attributes":4182,"children":4183},{"href":532},[4184],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":4188,"children":4189},{"class":1589},[4190,4194],{"type":459,"nodeName":467,"attributes":4191,"children":4192},{"class":1580,"id":392,"href":1362},[4193],{"type":464,"textContent":1365},{"type":464,"textContent":4195},".  Reply Messages",{"type":464,"textContent":4197},"\n\n   The following is a series of three messages that make up a\n   conversation thread between John and Mary.  John first sends a\n   message to Mary, Mary then replies to John's message, and then John\n   replies to Mary's reply message.\n\n   Note especially the \"Message-ID:\", \"References:\", and \"In-Reply-To:\"\n   fields in each message.\n\n   ----\n   From: John Doe \u003Cjdoe@machine.example>\n   To: Mary Smith \u003Cmary@example.net>\n   Subject: Saying Hello\n   Date: Fri, 21 Nov 1997 09:55:06 -0600\n   Message-ID: \u003C1234@local.machine.example>\n\n   This is a message just to say hello.\n   So, \"Hello\".\n   ----\n\n   When sending replies, the Subject field is often retained, though\n   prepended with \"Re: \" as described in ",{"type":459,"nodeName":467,"attributes":4199,"children":4200},{"href":984},[4201],{"type":464,"textContent":3909},{"type":464,"textContent":4203},".\n\n   ----\n   From: Mary Smith \u003Cmary@example.net>\n   To: John Doe \u003Cjdoe@machine.example>\n   Reply-To: \"Mary Smith: Personal Account\" \u003Csmith@home.example>\n   Subject: Re: Saying Hello\n   Date: Fri, 21 Nov 1997 10:01:10 -0600\n   Message-ID: \u003C3456@example.net>\n   In-Reply-To: \u003C1234@local.machine.example>\n   References: \u003C1234@local.machine.example>\n\n   This is a reply to your hello.\n   ----\n\n   Note the \"Reply-To:\" field in the above message.  When John replies\n   to Mary's message above, the reply should go to the address in the\n   \"Reply-To:\" field instead of the address in the \"From:\" field.\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":4205,"children":4206},{"class":507},[4207],{"type":464,"textContent":4208},"Resnick                     Standards Track                    [Page 46]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4211,"children":4212},{"class":516},[],{"type":459,"nodeName":460,"attributes":4214,"children":4215},{"class":520},[4216,4220,4221,4229,4231,4240,4242],{"type":459,"nodeName":484,"attributes":4217,"children":4219},{"id":4218},"page-47",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4222,"children":4223},{"class":507},[4224,4228],{"type":459,"nodeName":467,"attributes":4225,"children":4226},{"href":532},[4227],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":4230},"\n\n\n   ----\n   To: \"Mary Smith: Personal Account\" \u003Csmith@home.example>\n   From: John Doe \u003Cjdoe@machine.example>\n   Subject: Re: Saying Hello\n   Date: Fri, 21 Nov 1997 11:00:00 -0600\n   Message-ID: \u003Cabcd.1234@local.machine.test>\n   In-Reply-To: \u003C3456@example.net>\n   References: \u003C1234@local.machine.example> \u003C3456@example.net>\n\n   This is a reply to your reply.\n   ----\n\n",{"type":459,"nodeName":484,"attributes":4232,"children":4233},{"class":1589},[4234,4238],{"type":459,"nodeName":467,"attributes":4235,"children":4236},{"class":1580,"id":397,"href":1377},[4237],{"type":464,"textContent":1380},{"type":464,"textContent":4239},".  Resent Messages",{"type":464,"textContent":4241},"\n\n   Start with the message that has been used as an example several\n   times:\n\n   ----\n   From: John Doe \u003Cjdoe@machine.example>\n   To: Mary Smith \u003Cmary@example.net>\n   Subject: Saying Hello\n   Date: Fri, 21 Nov 1997 09:55:06 -0600\n   Message-ID: \u003C1234@local.machine.example>\n\n   This is a message just to say hello.\n   So, \"Hello\".\n   ----\n\n   Say that Mary, upon receiving this message, wishes to send a copy of\n   the message to Jane such that (a) the message would appear to have\n   come straight from John; (b) if Jane replies to the message, the\n   reply should go back to John; and (c) all of the original\n   information, like the date the message was originally sent to Mary,\n   the message identifier, and the original addressee, is preserved.  In\n   this case, resent fields are prepended to the message:\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":4243,"children":4244},{"class":507},[4245],{"type":464,"textContent":4246},"Resnick                     Standards Track                    [Page 47]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4249,"children":4250},{"class":516},[],{"type":459,"nodeName":460,"attributes":4252,"children":4253},{"class":520},[4254,4258,4259,4267,4269,4278,4280,4284,4286],{"type":459,"nodeName":484,"attributes":4255,"children":4257},{"id":4256},"page-48",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4260,"children":4261},{"class":507},[4262,4266],{"type":459,"nodeName":467,"attributes":4263,"children":4264},{"href":532},[4265],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":4268},"\n\n\n   ----\n   Resent-From: Mary Smith \u003Cmary@example.net>\n   Resent-To: Jane Brown \u003Cj-brown@other.example>\n   Resent-Date: Mon, 24 Nov 1997 14:22:01 -0800\n   Resent-Message-ID: \u003C78910@example.net>\n   From: John Doe \u003Cjdoe@machine.example>\n   To: Mary Smith \u003Cmary@example.net>\n   Subject: Saying Hello\n   Date: Fri, 21 Nov 1997 09:55:06 -0600\n   Message-ID: \u003C1234@local.machine.example>\n\n   This is a message just to say hello.\n   So, \"Hello\".\n   ----\n\n   If Jane, in turn, wished to resend this message to another person,\n   she would prepend her own set of resent header fields to the above\n   and send that.  (Note that for brevity, trace fields are not shown.)\n\n",{"type":459,"nodeName":484,"attributes":4270,"children":4271},{"class":1589},[4272,4276],{"type":459,"nodeName":467,"attributes":4273,"children":4274},{"class":1580,"id":402,"href":1392},[4275],{"type":464,"textContent":1395},{"type":464,"textContent":4277},".  Messages with Trace Fields",{"type":464,"textContent":4279},"\n\n   As messages are sent through the transport system as described in\n   [",{"type":459,"nodeName":467,"attributes":4281,"children":4282},{"href":1647},[4283],{"type":464,"textContent":1650},{"type":464,"textContent":4285},"], trace fields are prepended to the message.  The following\n   is an example of what those trace fields might look like.  Note that\n   there is some folding white space in the first one since these lines\n   can be long.\n\n   ----\n   Received: from x.y.test\n      by example.net\n      via TCP\n      with ESMTP\n      id ABC12345\n      for \u003Cmary@example.net>;  21 Nov 1997 10:05:43 -0600\n   Received: from node.example by x.y.test; 21 Nov 1997 10:01:22 -0600\n   From: John Doe \u003Cjdoe@node.example>\n   To: Mary Smith \u003Cmary@example.net>\n   Subject: Saying Hello\n   Date: Fri, 21 Nov 1997 09:55:06 -0600\n   Message-ID: \u003C1234@local.node.example>\n\n   This is a message just to say hello.\n   So, \"Hello\".\n   ----\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":4287,"children":4288},{"class":507},[4289],{"type":464,"textContent":4290},"Resnick                     Standards Track                    [Page 48]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4293,"children":4294},{"class":516},[],{"type":459,"nodeName":460,"attributes":4296,"children":4297},{"class":520},[4298,4302,4303,4311,4312,4321,4323],{"type":459,"nodeName":484,"attributes":4299,"children":4301},{"id":4300},"page-49",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4304,"children":4305},{"class":507},[4306,4310],{"type":459,"nodeName":467,"attributes":4307,"children":4308},{"href":532},[4309],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":4313,"children":4314},{"class":1589},[4315,4319],{"type":459,"nodeName":467,"attributes":4316,"children":4317},{"class":1580,"id":407,"href":1407},[4318],{"type":464,"textContent":1410},{"type":464,"textContent":4320},".  White Space, Comments, and Other Oddities",{"type":464,"textContent":4322},"\n\n   White space, including folding white space, and comments can be\n   inserted between many of the tokens of fields.  Taking the example\n   from A.1.3, white space and comments can be inserted into all of the\n   fields.\n\n   ----\n   From: Pete(A nice \\) chap) \u003Cpete(his account)@silly.test(his host)>\n   To:A Group(Some people)\n        :Chris Jones \u003Cc@(Chris's host.)public.example>,\n            joe@example.org,\n     John \u003Cjdoe@one.test> (my dear friend); (the end of the group)\n   Cc:(Empty list)(start)Hidden recipients  :(nobody(that I know))  ;\n   Date: Thu,\n         13\n           Feb\n             1969\n         23:32\n                  -0330 (Newfoundland Time)\n   Message-ID:              \u003Ctestabcd.1234@silly.test>\n\n   Testing.\n   ----\n\n   The above example is aesthetically displeasing, but perfectly legal.\n   Note particularly (1) the comments in the \"From:\" field (including\n   one that has a \")\" character appearing as part of a quoted-pair); (2)\n   the white space absent after the \":\" in the \"To:\" field as well as\n   the comment and folding white space after the group name, the special\n   character (\".\") in the comment in Chris Jones's address, and the\n   folding white space before and after \"joe@example.org,\"; (3) the\n   multiple and nested comments in the \"Cc:\" field as well as the\n   comment immediately following the \":\" after \"Cc\"; (4) the folding\n   white space (but no comments except at the end) and the missing\n   seconds in the time of the date field; and (5) the white space before\n   (but not within) the identifier in the \"Message-ID:\" field.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":4324,"children":4325},{"class":507},[4326],{"type":464,"textContent":4327},"Resnick                     Standards Track                    [Page 49]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4330,"children":4331},{"class":516},[],{"type":459,"nodeName":460,"attributes":4333,"children":4334},{"class":520},[4335,4339,4340,4348,4349,4358,4360,4364,4366,4374,4376,4385,4387],{"type":459,"nodeName":484,"attributes":4336,"children":4338},{"id":4337},"page-50",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4341,"children":4342},{"class":507},[4343,4347],{"type":459,"nodeName":467,"attributes":4344,"children":4345},{"href":532},[4346],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":4350,"children":4351},{"class":1589},[4352,4356],{"type":459,"nodeName":467,"attributes":4353,"children":4354},{"class":1580,"id":412,"href":1422},[4355],{"type":464,"textContent":1425},{"type":464,"textContent":4357},".  Obsoleted Forms",{"type":464,"textContent":4359},"\n\n   The following are examples of obsolete (that is, the \"MUST NOT\n   generate\") syntactic elements described in ",{"type":459,"nodeName":467,"attributes":4361,"children":4362},{"href":1042},[4363],{"type":464,"textContent":2232},{"type":464,"textContent":4365}," of this\n   document.\n\n",{"type":459,"nodeName":484,"attributes":4367,"children":4368},{"class":1691},[4369,4373],{"type":459,"nodeName":467,"attributes":4370,"children":4371},{"class":1580,"id":418,"href":1437},[4372],{"type":464,"textContent":1440},{"type":464,"textContent":3418},{"type":464,"textContent":4375},"\n\n   Note in the example below the lack of quotes around Joe Q. Public,\n   the route that appears in the address for Mary Smith, the two commas\n   that appear in the \"To:\" field, and the spaces that appear around the\n   \".\" in the jdoe address.\n\n   ----\n   From: Joe Q. Public \u003Cjohn.q.public@example.com>\n   To: Mary Smith \u003C@node.test:mary@example.net>, , jdoe@test  . example\n   Date: Tue, 1 Jul 2003 10:52:37 +0200\n   Message-ID: \u003C5678.21-Nov-1997@example.com>\n\n   Hi everyone.\n   ----\n\n",{"type":459,"nodeName":484,"attributes":4377,"children":4378},{"class":1691},[4379,4383],{"type":459,"nodeName":467,"attributes":4380,"children":4381},{"class":1580,"id":423,"href":1450},[4382],{"type":464,"textContent":1453},{"type":464,"textContent":4384},".  Obsolete Dates",{"type":464,"textContent":4386},"\n\n   The following message uses an obsolete date format, including a non-\n   numeric time zone and a two digit year.  Note that although the day-\n   of-week is missing, that is not specific to the obsolete syntax; it\n   is optional in the current syntax as well.\n\n   ----\n   From: John Doe \u003Cjdoe@machine.example>\n   To: Mary Smith \u003Cmary@example.net>\n   Subject: Saying Hello\n   Date: 21 Nov 97 09:55:06 GMT\n   Message-ID: \u003C1234@local.machine.example>\n\n   This is a message just to say hello.\n   So, \"Hello\".\n   ----\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":4388,"children":4389},{"class":507},[4390],{"type":464,"textContent":4391},"Resnick                     Standards Track                    [Page 50]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4394,"children":4395},{"class":516},[],{"type":459,"nodeName":460,"attributes":4397,"children":4398},{"class":520},[4399,4403,4404,4412,4413,4422,4424,4428,4430],{"type":459,"nodeName":484,"attributes":4400,"children":4402},{"id":4401},"page-51",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4405,"children":4406},{"class":507},[4407,4411],{"type":459,"nodeName":467,"attributes":4408,"children":4409},{"href":532},[4410],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":4414,"children":4415},{"class":1691},[4416,4420],{"type":459,"nodeName":467,"attributes":4417,"children":4418},{"class":1580,"id":428,"href":1463},[4419],{"type":464,"textContent":1466},{"type":464,"textContent":4421},".  Obsolete White Space and Comments",{"type":464,"textContent":4423},"\n\n   White space and comments can appear between many more elements than\n   in the current syntax.  Also, folding lines that are made up entirely\n   of white space are legal.\n\n   ----\n   From  : John Doe \u003Cjdoe@machine(comment).  example>\n   To    : Mary Smith\n   __\n             \u003Cmary@example.net>\n   Subject     : Saying Hello\n   Date  : Fri, 21 Nov 1997 09(comment):   55  :  06 -0600\n   Message-ID  : \u003C1234   @   local(blah)  .machine .example>\n\n   This is a message just to say hello.\n   So, \"Hello\".\n   ----\n\n   Note especially the second line of the \"To:\" field.  It starts with\n   two space characters.  (Note that \"__\" represent blank spaces.)\n   Therefore, it is considered part of the folding, as described in\n   ",{"type":459,"nodeName":467,"attributes":4425,"children":4426},{"href":1071},[4427],{"type":464,"textContent":3248},{"type":464,"textContent":4429},".  Also, the comments and white space throughout\n   addresses, dates, and message identifiers are all part of the\n   obsolete syntax.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":4431,"children":4432},{"class":507},[4433],{"type":464,"textContent":4434},"Resnick                     Standards Track                    [Page 51]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4437,"children":4438},{"class":516},[],{"type":459,"nodeName":460,"attributes":4440,"children":4441},{"class":520},[4442,4446,4447,4455,4456,4465,4467,4471,4472,4476,4477,4481,4483,4487,4489,4493,4495,4499,4501,4505,4507,4511,4513],{"type":459,"nodeName":484,"attributes":4443,"children":4445},{"id":4444},"page-52",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4448,"children":4449},{"class":507},[4450,4454],{"type":459,"nodeName":467,"attributes":4451,"children":4452},{"href":532},[4453],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":4457,"children":4458},{"class":1576},[4459,4463],{"type":459,"nodeName":467,"attributes":4460,"children":4461},{"class":1580,"id":433,"href":1478},[4462],{"type":464,"textContent":1481},{"type":464,"textContent":4464},".  Differences from Earlier Specifications",{"type":464,"textContent":4466},"\n\n   This appendix contains a list of changes that have been made in the\n   Internet Message Format from earlier specifications, specifically\n   [",{"type":459,"nodeName":467,"attributes":4468,"children":4469},{"href":1608},[4470],{"type":464,"textContent":1611},{"type":464,"textContent":1629},{"type":459,"nodeName":467,"attributes":4473,"children":4474},{"href":1616},[4475],{"type":464,"textContent":1619},{"type":464,"textContent":2643},{"type":459,"nodeName":467,"attributes":4478,"children":4479},{"href":469},[4480],{"type":464,"textContent":1603},{"type":464,"textContent":4482},"].  Items marked with an asterisk\n   (*) below are items which appear in ",{"type":459,"nodeName":467,"attributes":4484,"children":4485},{"href":1042},[4486],{"type":464,"textContent":2232},{"type":464,"textContent":4488}," of this document and\n   therefore can no longer be generated.\n\n   The following are the changes made from [",{"type":459,"nodeName":467,"attributes":4490,"children":4491},{"href":1608},[4492],{"type":464,"textContent":1611},{"type":464,"textContent":4494},"] and [",{"type":459,"nodeName":467,"attributes":4496,"children":4497},{"href":1616},[4498],{"type":464,"textContent":1619},{"type":464,"textContent":4500},"] to\n   [",{"type":459,"nodeName":467,"attributes":4502,"children":4503},{"href":469},[4504],{"type":464,"textContent":1603},{"type":464,"textContent":4506},"] that remain in this document:\n\n   1.   Period allowed in obsolete form of phrase.\n   2.   ABNF moved out of document, now in [",{"type":459,"nodeName":467,"attributes":4508,"children":4509},{"href":1722},[4510],{"type":464,"textContent":1725},{"type":464,"textContent":4512},"].\n   3.   Four or more digits allowed for year.\n   4.   Header field ordering (and lack thereof) made explicit.\n   5.   Encrypted header field removed.\n   6.   Specifically allow and give meaning to \"-0000\" time zone.\n   7.   Folding white space is not allowed between every token.\n   8.   Requirement for destinations removed.\n   9.   Forwarding and resending redefined.\n   10.  Extension header fields no longer specifically called out.\n   11.  ASCII 0 (null) removed.*\n   12.  Folding continuation lines cannot contain only white space.*\n   13.  Free insertion of comments not allowed in date.*\n   14.  Non-numeric time zones not allowed.*\n   15.  Two digit years not allowed.*\n   16.  Three digit years interpreted, but not allowed for generation.*\n   17.  Routes in addresses not allowed.*\n   18.  CFWS within local-parts and domains not allowed.*\n   19.  Empty members of address lists not allowed.*\n   20.  Folding white space between field name and colon not allowed.*\n   21.  Comments between field name and colon not allowed.\n   22.  Tightened syntax of in-reply-to and references.*\n   23.  CFWS within msg-id not allowed.*\n   24.  Tightened semantics of resent fields as informational only.\n   25.  Resent-Reply-To not allowed.*\n   26.  No multiple occurrences of fields (except resent and received).*\n   27.  Free CR and LF not allowed.*\n   28.  Line length limits specified.\n   29.  Bcc more clearly specified.\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":4514,"children":4515},{"class":507},[4516],{"type":464,"textContent":4517},"Resnick                     Standards Track                    [Page 52]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4520,"children":4521},{"class":516},[],{"type":459,"nodeName":460,"attributes":4523,"children":4524},{"class":520},[4525,4529,4530,4538,4540,4544,4546,4555,4557,4561,4563],{"type":459,"nodeName":484,"attributes":4526,"children":4528},{"id":4527},"page-53",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4531,"children":4532},{"class":507},[4533,4537],{"type":459,"nodeName":467,"attributes":4534,"children":4535},{"href":532},[4536],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":4539},"\n\n\n   The following are changes from [",{"type":459,"nodeName":467,"attributes":4541,"children":4542},{"href":469},[4543],{"type":464,"textContent":1603},{"type":464,"textContent":4545},"].\n   1.   Assorted typographical\u002Fgrammatical errors fixed and\n        clarifications made.\n   2.   Changed \"standard\" to \"document\" or \"specification\" throughout.\n   3.   Made distinction between \"header field\" and \"header section\".\n   4.   Removed NO-WS-CTL from ctext, qtext, dtext, and unstructured.*\n   5.   Moved discussion of specials to the \"Atom\" section.  Moved text\n        to \"Overall message syntax\" section.\n   6.   Simplified CFWS syntax.\n   7.   Fixed unstructured syntax.\n   8.   Changed date and time syntax to deal with white space in\n        obsolete date syntax.\n   9.   Removed quoted-pair from domain literals and message\n        identifiers.*\n   10.  Clarified that other specifications limit domain syntax.\n   11.  Simplified \"Bcc:\" and \"Resent-Bcc:\" syntax.\n   12.  Allowed optional-field to appear within trace information.\n   13.  Removed no-fold-quote from msg-id.  Clarified syntax\n        limitations.\n   14.  Generalized \"Received:\" syntax to fix bugs and move definition\n        out of this document.\n   15.  Simplified obs-qp.  Fixed and simplified obs-utext (which now\n        only appears in the obsolete syntax).  Removed obs-text and obs-\n        char, adding obs-body.\n   16.  Fixed obsolete date syntax to allow for more (or less) comments\n        and white space.\n   17.  Fixed all obsolete list syntax (obs-domain-list, obs-mbox-list,\n        obs-addr-list, obs-phrase-list, and the newly added obs-group-\n        list).\n   18.  Fixed obs-reply-to syntax.\n   19.  Fixed obs-bcc and obs-resent-bcc to allow empty lists.\n   20.  Removed obs-path.\n\n",{"type":459,"nodeName":484,"attributes":4547,"children":4548},{"class":1576},[4549,4553],{"type":459,"nodeName":467,"attributes":4550,"children":4551},{"class":1580,"id":438,"href":1493},[4552],{"type":464,"textContent":1496},{"type":464,"textContent":4554},".  Acknowledgements",{"type":464,"textContent":4556},"\n\n   Many people contributed to this document.  They included folks who\n   participated in the Detailed Revision and Update of Messaging\n   Standards (DRUMS) Working Group of the Internet Engineering Task\n   Force (IETF), the chair of DRUMS, the Area Directors of the IETF, and\n   people who simply sent their comments in via email.  The editor is\n   deeply indebted to them all and thanks them sincerely.  The below\n   list includes everyone who sent email concerning both this document\n   and [",{"type":459,"nodeName":467,"attributes":4558,"children":4559},{"href":469},[4560],{"type":464,"textContent":1603},{"type":464,"textContent":4562},"].  Hopefully, everyone who contributed is named here:\n\n   +--------------------+----------------------+---------------------+\n   | Matti Aarnio       | Tanaka Akira         | Russ Allbery        |\n   | Eric Allman        | Harald Alvestrand    | Ran Atkinson        |\n   | Jos Backus         | Bruce Balden         | Dave Barr           |\n\n\n\n",{"type":459,"nodeName":484,"attributes":4564,"children":4565},{"class":507},[4566],{"type":464,"textContent":4567},"Resnick                     Standards Track                    [Page 53]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4570,"children":4571},{"class":516},[],{"type":459,"nodeName":460,"attributes":4573,"children":4574},{"class":520},[4575,4579,4580,4588,4590],{"type":459,"nodeName":484,"attributes":4576,"children":4578},{"id":4577},"page-54",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4581,"children":4582},{"class":507},[4583,4587],{"type":459,"nodeName":467,"attributes":4584,"children":4585},{"href":532},[4586],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":4589},"\n\n\n   | Alan Barrett       | John Beck            | J Robert von Behren |\n   | Jos den Bekker     | D J Bernstein        | James Berriman      |\n   | Oliver Block       | Norbert Bollow       | Raj Bose            |\n   | Antony Bowesman    | Scott Bradner        | Randy Bush          |\n   | Tom Byrer          | Bruce Campbell       | Larry Campbell      |\n   | W J Carpenter      | Michael Chapman      | Richard Clayton     |\n   | Maurizio Codogno   | Jim Conklin          | R Kelley Cook       |\n   | Nathan Coulter     | Steve Coya           | Mark Crispin        |\n   | Dave Crocker       | Matt Curtin          | Michael D'Errico    |\n   | Cyrus Daboo        | Michael D Dean       | Jutta Degener       |\n   | Mark Delany        | Steve Dorner         | Harold A Driscoll   |\n   | Michael Elkins     | Frank Ellerman       | Robert Elz          |\n   | Johnny Eriksson    | Erik E Fair          | Roger Fajman        |\n   | Patrik Faltstrom   | Claus Andre Faerber  | Barry Finkel        |\n   | Erik Forsberg      | Chuck Foster         | Paul Fox            |\n   | Klaus M Frank      | Ned Freed            | Jochen Friedrich    |\n   | Randall C Gellens  | Sukvinder Singh Gill | Tim Goodwin         |\n   | Philip Guenther    | Arnt Gulbrandsen     | Eric A Hall         |\n   | Tony Hansen        | John Hawkinson       | Philip Hazel        |\n   | Kai Henningsen     | Robert Herriot       | Paul Hethmon        |\n   | Jim Hill           | Alfred Hoenes        | Paul E Hoffman      |\n   | Steve Hole         | Kari Hurtta          | Marco S Hyman       |\n   | Ofer Inbar         | Olle Jarnefors       | Kevin Johnson       |\n   | Sudish Joseph      | Maynard Kang         | Prabhat Keni        |\n   | John C Klensin     | Graham Klyne         | Brad Knowles        |\n   | Shuhei Kobayashi   | Peter Koch           | Dan Kohn            |\n   | Christian Kuhtz    | Anand Kumria         | Steen Larsen        |\n   | Eliot Lear         | Barry Leiba          | Jay Levitt          |\n   | Bruce Lilly        | Lars-Johan Liman     | Charles Lindsey     |\n   | Pete Loshin        | Simon Lyall          | Bill Manning        |\n   | John Martin        | Mark Martinec        | Larry Masinter      |\n   | Denis McKeon       | William P McQuillan  | Alexey Melnikov     |\n   | Perry E Metzger    | Steven Miller        | S Moonesamy         |\n   | Keith Moore        | John Gardiner Myers  | Chris Newman        |\n   | John W Noerenberg  | Eric Norman          | Mike O'Dell         |\n   | Larry Osterman     | Paul Overell         | Jacob Palme         |\n   | Michael A Patton   | Uzi Paz              | Michael A Quinlan   |\n   | Robert Rapplean    | Eric S Raymond       | Sam Roberts         |\n   | Hugh Sasse         | Bart Schaefer        | Tom Scola           |\n   | Wolfgang Segmuller | Nick Shelness        | John Stanley        |\n   | Einar Stefferud    | Jeff Stephenson      | Bernard Stern       |\n   | Peter Sylvester    | Mark Symons          | Eric Thomas         |\n   | Lee Thompson       | Karel De Vriendt     | Matthew Wall        |\n   | Rolf Weber         | Brent B Welch        | Dan Wing            |\n   | Jack De Winter     | Gregory J Woodhouse  | Greg A Woods        |\n   | Kazu Yamamoto      | Alain Zahm           | Jamie Zawinski      |\n   | Timothy S Zurcher  |                      |                     |\n   +--------------------+----------------------+---------------------+\n\n\n\n",{"type":459,"nodeName":484,"attributes":4591,"children":4592},{"class":507},[4593],{"type":464,"textContent":4594},"Resnick                     Standards Track                    [Page 54]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4597,"children":4598},{"class":516},[],{"type":459,"nodeName":460,"attributes":4600,"children":4601},{"class":520},[4602,4606,4607,4615,4616,4625,4626,4635,4637,4642,4644,4649,4651,4656,4658,4663,4665,4670,4671,4676,4678,4683,4685,4690,4692,4698,4700,4705,4707,4712,4714,4719,4721,4730,4731,4736,4738,4743,4745,4750,4752,4757,4759,4764,4766,4771,4773,4778,4780,4785,4787,4792,4794],{"type":459,"nodeName":484,"attributes":4603,"children":4605},{"id":4604},"page-55",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4608,"children":4609},{"class":507},[4610,4614],{"type":459,"nodeName":467,"attributes":4611,"children":4612},{"href":532},[4613],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":1573},{"type":459,"nodeName":484,"attributes":4617,"children":4618},{"class":1576},[4619,4623],{"type":459,"nodeName":467,"attributes":4620,"children":4621},{"class":1580,"id":443,"href":1508},[4622],{"type":464,"textContent":666},{"type":464,"textContent":4624},".  References",{"type":464,"textContent":1586},{"type":459,"nodeName":484,"attributes":4627,"children":4628},{"class":1589},[4629,4633],{"type":459,"nodeName":467,"attributes":4630,"children":4631},{"class":1580,"id":449,"href":1522},[4632],{"type":464,"textContent":1525},{"type":464,"textContent":4634},".  Normative References",{"type":464,"textContent":4636},"\n\n   [",{"type":459,"nodeName":467,"attributes":4638,"children":4640},{"id":4639},"ref-ANSI.X3-4.1986",[4641],{"type":464,"textContent":1876},{"type":464,"textContent":4643},"]  American National Standards Institute, \"Coded\n                     Character Set - 7-bit American Standard Code for\n                     Information Interchange\", ANSI X3.4, 1986.\n\n   [",{"type":459,"nodeName":467,"attributes":4645,"children":4647},{"id":4646},"ref-RFC1034",[4648],{"type":464,"textContent":2586},{"type":464,"textContent":4650},"]         Mockapetris, P., \"Domain names - concepts and\n                     facilities\", STD 13, ",{"type":459,"nodeName":467,"attributes":4652,"children":4653},{"href":2583},[4654],{"type":464,"textContent":4655},"RFC 1034",{"type":464,"textContent":4657},", November 1987.\n\n   [",{"type":459,"nodeName":467,"attributes":4659,"children":4661},{"id":4660},"ref-RFC1035",[4662],{"type":464,"textContent":2593},{"type":464,"textContent":4664},"]         Mockapetris, P., \"Domain names - implementation and\n                     specification\", STD 13, ",{"type":459,"nodeName":467,"attributes":4666,"children":4667},{"href":2590},[4668],{"type":464,"textContent":4669},"RFC 1035",{"type":464,"textContent":4657},{"type":459,"nodeName":467,"attributes":4672,"children":4674},{"id":4673},"ref-RFC1123",[4675],{"type":464,"textContent":1619},{"type":464,"textContent":4677},"]         Braden, R., \"Requirements for Internet Hosts -\n                     Application and Support\", STD 3, ",{"type":459,"nodeName":467,"attributes":4679,"children":4680},{"href":1616},[4681],{"type":464,"textContent":4682},"RFC 1123",{"type":464,"textContent":4684},",\n                     October 1989.\n\n   [",{"type":459,"nodeName":467,"attributes":4686,"children":4688},{"id":4687},"ref-RFC2119",[4689],{"type":464,"textContent":1706},{"type":464,"textContent":4691},"]         Bradner, S., \"Key words for use in RFCs to Indicate\n                     Requirement Levels\", ",{"type":459,"nodeName":467,"attributes":4693,"children":4695},{"href":4694},"\u002Fbcp\u002Fbcp14",[4696],{"type":464,"textContent":4697},"BCP 14",{"type":464,"textContent":4699},", ",{"type":459,"nodeName":467,"attributes":4701,"children":4702},{"href":1703},[4703],{"type":464,"textContent":4704},"RFC 2119",{"type":464,"textContent":4706},", March 1997.\n\n   [",{"type":459,"nodeName":467,"attributes":4708,"children":4710},{"id":4709},"ref-RFC5234",[4711],{"type":464,"textContent":1725},{"type":464,"textContent":4713},"]         Crocker, D. and P. Overell, \"Augmented BNF for\n                     Syntax Specifications: ABNF\", STD 68, ",{"type":459,"nodeName":467,"attributes":4715,"children":4716},{"href":1722},[4717],{"type":464,"textContent":4718},"RFC 5234",{"type":464,"textContent":4720},",\n                     January 2008.\n\n",{"type":459,"nodeName":484,"attributes":4722,"children":4723},{"class":1589},[4724,4728],{"type":459,"nodeName":467,"attributes":4725,"children":4726},{"class":1580,"id":454,"href":1535},[4727],{"type":464,"textContent":1538},{"type":464,"textContent":4729},".  Informative References",{"type":464,"textContent":4636},{"type":459,"nodeName":467,"attributes":4732,"children":4734},{"id":4733},"ref-RFC0822",[4735],{"type":464,"textContent":1611},{"type":464,"textContent":4737},"]         Crocker, D., \"Standard for the format of ARPA\n                     Internet text messages\", STD 11, ",{"type":459,"nodeName":467,"attributes":4739,"children":4740},{"href":499},[4741],{"type":464,"textContent":4742},"RFC 822",{"type":464,"textContent":4744},",\n                     August 1982.\n\n   [",{"type":459,"nodeName":467,"attributes":4746,"children":4748},{"id":4747},"ref-RFC1305",[4749],{"type":464,"textContent":2522},{"type":464,"textContent":4751},"]         Mills, D., \"Network Time Protocol (Version 3)\n                     Specification, Implementation\", ",{"type":459,"nodeName":467,"attributes":4753,"children":4754},{"href":2519},[4755],{"type":464,"textContent":4756},"RFC 1305",{"type":464,"textContent":4758},",\n                     March 1992.\n\n   [",{"type":459,"nodeName":467,"attributes":4760,"children":4762},{"id":4761},"ref-ISO.2022.1994",[4763],{"type":464,"textContent":3666},{"type":464,"textContent":4765},"]   International Organization for Standardization,\n                     \"Information technology - Character code structure\n                     and extension techniques\", ISO Standard 2022, 1994.\n\n   [",{"type":459,"nodeName":467,"attributes":4767,"children":4769},{"id":4768},"ref-RFC2045",[4770],{"type":464,"textContent":1627},{"type":464,"textContent":4772},"]         Freed, N. and N. Borenstein, \"Multipurpose Internet\n                     Mail Extensions (MIME) Part One: Format of Internet\n                     Message Bodies\", ",{"type":459,"nodeName":467,"attributes":4774,"children":4775},{"href":1624},[4776],{"type":464,"textContent":4777},"RFC 2045",{"type":464,"textContent":4779},", November 1996.\n\n   [",{"type":459,"nodeName":467,"attributes":4781,"children":4783},{"id":4782},"ref-RFC2046",[4784],{"type":464,"textContent":1635},{"type":464,"textContent":4786},"]         Freed, N. and N. Borenstein, \"Multipurpose Internet\n                     Mail Extensions (MIME) Part Two: Media Types\",\n                     ",{"type":459,"nodeName":467,"attributes":4788,"children":4789},{"href":1632},[4790],{"type":464,"textContent":4791},"RFC 2046",{"type":464,"textContent":4793},", November 1996.\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":4795,"children":4796},{"class":507},[4797],{"type":464,"textContent":4798},"Resnick                     Standards Track                    [Page 55]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4801,"children":4802},{"class":516},[],{"type":459,"nodeName":460,"attributes":4804,"children":4805},{"class":520},[4806,4810,4811,4819,4821,4826,4828,4833,4834,4839,4841,4846,4847,4852,4854,4859,4861,4866,4868,4874,4875,4880,4882,4887,4889,4894,4896,4901,4903,4909,4910,4915,4917,4922,4924,4928,4929,4934,4935,4940,4942,4947,4949,4954,4956],{"type":459,"nodeName":484,"attributes":4807,"children":4809},{"id":4808},"page-56",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4812,"children":4813},{"class":507},[4814,4818],{"type":459,"nodeName":467,"attributes":4815,"children":4816},{"href":532},[4817],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":4820},"\n\n\n   [",{"type":459,"nodeName":467,"attributes":4822,"children":4824},{"id":4823},"ref-RFC2047",[4825],{"type":464,"textContent":1895},{"type":464,"textContent":4827},"]         Moore, K., \"MIME (Multipurpose Internet Mail\n                     Extensions) Part Three: Message Header Extensions\n                     for Non-ASCII Text\", ",{"type":459,"nodeName":467,"attributes":4829,"children":4830},{"href":1892},[4831],{"type":464,"textContent":4832},"RFC 2047",{"type":464,"textContent":4779},{"type":459,"nodeName":467,"attributes":4835,"children":4837},{"id":4836},"ref-RFC2049",[4838],{"type":464,"textContent":1642},{"type":464,"textContent":4840},"]         Freed, N. and N. Borenstein, \"Multipurpose Internet\n                     Mail Extensions (MIME) Part Five: Conformance\n                     Criteria and Examples\", ",{"type":459,"nodeName":467,"attributes":4842,"children":4843},{"href":1639},[4844],{"type":464,"textContent":4845},"RFC 2049",{"type":464,"textContent":4779},{"type":459,"nodeName":467,"attributes":4848,"children":4850},{"id":4849},"ref-RFC2822",[4851],{"type":464,"textContent":1603},{"type":464,"textContent":4853},"]         Resnick, P., \"Internet Message Format\", ",{"type":459,"nodeName":467,"attributes":4855,"children":4856},{"href":469},[4857],{"type":464,"textContent":4858},"RFC 2822",{"type":464,"textContent":4860},",\n                     April 2001.\n\n   [",{"type":459,"nodeName":467,"attributes":4862,"children":4864},{"id":4863},"ref-RFC3864",[4865],{"type":464,"textContent":3785},{"type":464,"textContent":4867},"]         Klyne, G., Nottingham, M., and J. Mogul,\n                     \"Registration Procedures for Message Header\n                     Fields\", ",{"type":459,"nodeName":467,"attributes":4869,"children":4871},{"href":4870},"\u002Fbcp\u002Fbcp90",[4872],{"type":464,"textContent":4873},"BCP 90",{"type":464,"textContent":4699},{"type":459,"nodeName":467,"attributes":4876,"children":4877},{"href":3782},[4878],{"type":464,"textContent":4879},"RFC 3864",{"type":464,"textContent":4881},", September 2004.\n\n   [",{"type":459,"nodeName":467,"attributes":4883,"children":4885},{"id":4884},"ref-RFC4021",[4886],{"type":464,"textContent":3771},{"type":464,"textContent":4888},"]         Klyne, G. and J. Palme, \"Registration of Mail and\n                     MIME Header Fields\", ",{"type":459,"nodeName":467,"attributes":4890,"children":4891},{"href":477},[4892],{"type":464,"textContent":4893},"RFC 4021",{"type":464,"textContent":4895},", March 2005.\n\n   [",{"type":459,"nodeName":467,"attributes":4897,"children":4899},{"id":4898},"ref-RFC4288",[4900],{"type":464,"textContent":1907},{"type":464,"textContent":4902},"]         Freed, N. and J. Klensin, \"Media Type\n                     Specifications and Registration Procedures\",\n                     ",{"type":459,"nodeName":467,"attributes":4904,"children":4906},{"href":4905},"\u002Fbcp\u002Fbcp13",[4907],{"type":464,"textContent":4908},"BCP 13",{"type":464,"textContent":4699},{"type":459,"nodeName":467,"attributes":4911,"children":4912},{"href":1904},[4913],{"type":464,"textContent":4914},"RFC 4288",{"type":464,"textContent":4916},", December 2005.\n\n   [",{"type":459,"nodeName":467,"attributes":4918,"children":4920},{"id":4919},"ref-RFC4289",[4921],{"type":464,"textContent":1914},{"type":464,"textContent":4923},"]         Freed, N. and J. Klensin, \"Multipurpose Internet\n                     Mail Extensions (MIME) Part Four: Registration\n                     Procedures\", ",{"type":459,"nodeName":467,"attributes":4925,"children":4926},{"href":4905},[4927],{"type":464,"textContent":4908},{"type":464,"textContent":4699},{"type":459,"nodeName":467,"attributes":4930,"children":4931},{"href":1911},[4932],{"type":464,"textContent":4933},"RFC 4289",{"type":464,"textContent":4916},{"type":459,"nodeName":467,"attributes":4936,"children":4938},{"id":4937},"ref-RFC5321",[4939],{"type":464,"textContent":1650},{"type":464,"textContent":4941},"]         Klensin, J., \"Simple Mail Transfer Protocol\",\n                     ",{"type":459,"nodeName":467,"attributes":4943,"children":4944},{"href":1647},[4945],{"type":464,"textContent":4946},"RFC 5321",{"type":464,"textContent":4948},", October 2008.\n\nAuthor's Address\n\n   Peter W. Resnick (editor)\n   Qualcomm Incorporated\n   5775 Morehouse Drive\n   San Diego, CA  92121-1714\n   US\n\n   Phone: +1 858 651 4478\n   EMail: presnick@qualcomm.com\n   URI:   ",{"type":459,"nodeName":467,"attributes":4950,"children":4952},{"href":4951},"http:\u002F\u002Fwww.qualcomm.com\u002F~presnick\u002F",[4953],{"type":464,"textContent":4951},{"type":464,"textContent":4955},"\n\n\n\n\n\n\n\n\n\n\n\n",{"type":459,"nodeName":484,"attributes":4957,"children":4958},{"class":507},[4959],{"type":464,"textContent":4960},"Resnick                     Standards Track                    [Page 56]",{"type":464,"textContent":512},{"type":459,"nodeName":514,"attributes":4963,"children":4964},{"class":516},[],{"type":459,"nodeName":460,"attributes":4966,"children":4967},{"class":520},[4968,4972,4973,4981,4983,4989,4991,4995,4996,5002,5004,5009],{"type":459,"nodeName":484,"attributes":4969,"children":4971},{"id":4970},"page-57",[],{"type":464,"textContent":512},{"type":459,"nodeName":484,"attributes":4974,"children":4975},{"class":507},[4976,4980],{"type":459,"nodeName":467,"attributes":4977,"children":4978},{"href":532},[4979],{"type":464,"textContent":535},{"type":464,"textContent":537},{"type":464,"textContent":4982},"\n\n\nFull Copyright Statement\n\n   Copyright (C) The IETF Trust (2008).\n\n   This document is subject to the rights, licenses and restrictions\n   contained in ",{"type":459,"nodeName":467,"attributes":4984,"children":4986},{"href":4985},"\u002Fbcp\u002Fbcp78",[4987],{"type":464,"textContent":4988},"BCP 78",{"type":464,"textContent":4990},", and except as set forth therein, the authors\n   retain all their rights.\n\n   This document and the information contained herein are provided on an\n   \"AS IS\" basis and THE CONTRIBUTOR, THE ORGANIZATION HE\u002FSHE REPRESENTS\n   OR IS SPONSORED BY (IF ANY), THE INTERNET SOCIETY, THE IETF TRUST AND\n   THE INTERNET ENGINEERING TASK FORCE DISCLAIM ALL WARRANTIES, EXPRESS\n   OR IMPLIED, INCLUDING BUT NOT LIMITED TO ANY WARRANTY THAT THE USE OF\n   THE INFORMATION HEREIN WILL NOT INFRINGE ANY RIGHTS OR ANY IMPLIED\n   WARRANTIES OF MERCHANTABILITY OR FITNESS FOR A PARTICULAR PURPOSE.\n\nIntellectual Property\n\n   The IETF takes no position regarding the validity or scope of any\n   Intellectual Property Rights or other rights that might be claimed to\n   pertain to the implementation or use of the technology described in\n   this document or the extent to which any license under such rights\n   might or might not be available; nor does it represent that it has\n   made any independent effort to identify any such rights.  Information\n   on the procedures with respect to rights in RFC documents can be\n   found in ",{"type":459,"nodeName":467,"attributes":4992,"children":4993},{"href":4985},[4994],{"type":464,"textContent":4988},{"type":464,"textContent":1778},{"type":459,"nodeName":467,"attributes":4997,"children":4999},{"href":4998},"\u002Fbcp\u002Fbcp79",[5000],{"type":464,"textContent":5001},"BCP 79",{"type":464,"textContent":5003},".\n\n   Copies of IPR disclosures made to the IETF Secretariat and any\n   assurances of licenses to be made available, or the result of an\n   attempt made to obtain a general license or permission for the use of\n   such proprietary rights by implementers or users of this\n   specification can be obtained from the IETF on-line IPR repository at\n   ",{"type":459,"nodeName":467,"attributes":5005,"children":5007},{"href":5006},"http:\u002F\u002Fwww.ietf.org\u002Fipr",[5008],{"type":464,"textContent":5006},{"type":464,"textContent":5010},".\n\n   The IETF invites any interested party to bring to its attention any\n   copyrights, patents or patent applications, or other proprietary\n   rights that may cover technology that may be required to implement\n   this standard.  Please address the information to the IETF at\n   ietf-ipr@ietf.org.\n\n\n\n\n\n\n\n\n\n\n\n\nResnick                     Standards Track                    [Page 57]\n",{"type":464,"textContent":512},{"max":5013},72,[5015,5026,5033,5040,5047,5053,5059,5065,5070,5076,5081,5087,5093,5100,5107,5113,5118,5124,5130,5137,5143,5149,5155,5162,5169,5175,5182,5189,5195,5202,5209],{"errata_id":5016,"doc-id":5017,"errata_status_code":5018,"errata_type_code":5019,"section":5020,"orig_text":5021,"correct_text":5022,"notes":5023,"submit_date":5024,"update_date":5025},"3400","RFC5322","Rejected","Editorial","3.5.","   message         =   (fields \u002F obs-fields)\r\n                       [CRLF body]\r\n\r\n   body            =   (*(*998text CRLF) *998text) \u002F obs-body\r\n","   message         =   (fields \u002F obs-fields)\r\n                       [CRLF body]\r\n\r\n   body            =   (*(*998text CRLF) *998text) \u002F obs-body\r\n\r\nIt is RECOMMENDED that message bodies are terminated by CRLF, though \r\nthis is in principle not necessary (this does not apply to messages \r\nconsisting only of a header section, as header fields are always CRLF\r\nterminated).\r\n\r\nNote however, that when transporting messages via SMTP the last lines \r\nof message bodies MUST be terminated by CRLF as specified int \r\nRFC 5321, section 4.1.1.4.","Hi folks.\r\n\r\nAFAIU, the definition of body allows message bodies (not header sections) that end without CRLF.\r\n\r\nRFC5321 section 4.1.1.4. however states: \"The mail data are terminated by a line containing only a period, that is, the character sequence \"\u003CCRLF>.\u003CCRLF>\", where the first \u003CCRLF> is actually the terminator of the previous line\".\r\n\r\nSo SMTP forbids, what this RFC allows.\r\nI guess the SMTP RFC can't be changed here and it makes no particular sense to restrict RFC5322 on the other hand.\r\n\r\nMy suggestion was to add this clarification.\r\n\r\nPerhaps a similar one should be added to RFC5321, telling that Internet Messages themselves wouldn't need the last CRLF.\n --VERIFIER NOTES-- \nIt is clearly a change from WG consensus to add any normative 2119 text regarding a terminating CRLF. (See archive of the DRUMS WG, 17-18 March 1998 in a thread with a subject of \"Small Clarification to msg-fmt-04\".) The CRLF is not required for the message syntax. There are things other than this that 5321 cannot transport, so  is also unlikely to be in scope for 5321 as an erratum either. Perhaps a discussion of this might be useful for RFC 3030, but again, it is unlikely to be an erratum.","2012-11-06","2019-09-10 16:09:03",{"errata_id":5027,"doc-id":5017,"errata_status_code":5028,"errata_type_code":5019,"section":884,"orig_text":5029,"correct_text":5030,"notes":5031,"submit_date":5032,"update_date":5025},"1766","Verified","If the\r\nstring can be represented as a dot-atom (that is, it contains no\r\ncharacters other than atext characters or \".\" surrounded by atext\r\ncharacters), then the dot-atom form SHOULD be used and the quoted-\r\nstring form SHOULD NOT be used.","If the\r\nstring can be represented as a dot-atom (that is, it contains no \r\ncharacters other than atext characters or one or more of \".\" \r\nsurrounded by atext characters), then the dot-atom form SHOULD \r\nbe used and the quoted-string form SHOULD NOT be used.","Based on sec. 3.2.3 (\"dot-atom = [CFWS] dot-atom-text [CFWS]\" (brackets so in original) & \"dot-atom-text = 1*atext *('.' 1*atext)\") and on appx. A.1.2 (the example \"john.q.public@example.com\").","2009-04-16",{"errata_id":5034,"doc-id":5017,"errata_status_code":5028,"errata_type_code":5035,"section":1059,"orig_text":5036,"correct_text":5037,"notes":5038,"submit_date":5039,"update_date":5025},"1905","Technical","   obs-unstruct    =   *((*LF *CR *(obs-utext *LF *CR)) \u002F FWS)","   obs-unstruct    =   *( (*CR 1*(obs-utext \u002F FWS)) \u002F 1*LF ) *CR","It looks to me, as if the rule for obs-unstruct matches any US_ASCII character sequence, and is, hence, either overly complicated, or simply wrong.  For example: CR LF 'A' is matched by the original rule (loop matches CR first, then LF 'A').  If I understand the accompaying text right, the intention was to allow for reversed sequences LF CR, as well as bare CR and LF sequences, but strictly forbid any occurrence of CR LF (in that order).  This would be expressed by my rule, that basically states that any sequence of CR either is at the end, or is followed by a non-LF, or an FWS\r\n\r\n[Alexey: removed unchanged ABNF rules, corrected an obvious error in the description of the change.]","2009-10-09",{"errata_id":5041,"doc-id":5017,"errata_status_code":5042,"errata_type_code":5035,"section":1059,"orig_text":5043,"correct_text":5044,"notes":5045,"submit_date":5046,"update_date":5025},"1906","Held for Document Update","   obs-body        =   *((*LF *CR *((%d0 \u002F text) *LF *CR)) \u002F CRLF)","   obs-body        =   *(%d0-127)","The regular expression for obs-body is overly complex and can be simplified as suggested. Alternatively, one could use\r\n*(d0 \u002Ftext \u002F LF \u002F CR)\r\nshould the difference to 'text' be emphazised.\r\n\r\n[Alexey: I've edited this to only show 1 issue per erratum.]","2009-10-10",{"errata_id":5048,"doc-id":5017,"errata_status_code":5028,"errata_type_code":5035,"section":1074,"orig_text":5049,"correct_text":5050,"notes":5051,"submit_date":5052,"update_date":5025},"1908","   In the obsolete syntax, any amount of folding white space MAY be\r\n   inserted where the obs-FWS rule is allowed.  This creates the\r\n   possibility of having two consecutive \"folds\" in a line, and\r\n   therefore the possibility that a line which makes up a folded header\r\n   field could be composed entirely of white space.\r\n\r\n   obs-FWS         =   1*WSP *(CRLF 1*WSP)\r\n","   In the obsolete syntax, any amount of folding white space MAY be\r\n   inserted where the obs-FWS rule is allowed.  This creates the\r\n   possibility of having two consecutive \"folds\" in a line, and\r\n   therefore the possibility that a line which makes up a folded header\r\n   field could be composed entirely of white space.\r\n\r\n   obs-FWS         =   1*([CRLF] WSP)\r\n","If I understand the relevant portions of RFC 822 right (notably section 3.1.1\r\n[\"The general rule is that wherever there may be linear-white-space...\r\na CRLF followed by ... LWSP-char(s) may instead be inserted\"], along with\r\nsection 3.1.4, section 3.3), it is permitted to extend a phrase\r\n  atom SPACE atom\r\nby inserting linear-white-space (CRLF SPACE CRLF SPACE) instead, yielding:\r\n  atom CRLF SPACE CRLF SPACE atom\r\nHowever, this is not recognized by the rules of RFC 5322, because the new\r\nsyntax forbids consecutive foldings, whereas obs-FWS requires a leading\r\nwhite-space character at the beginning.","2009-10-11",{"errata_id":5054,"doc-id":5017,"errata_status_code":5018,"errata_type_code":5035,"section":1059,"orig_text":5055,"correct_text":5056,"notes":5057,"submit_date":5058,"update_date":5025},"2104","obs-unstruct    =   *((*LF *CR *(obs-utext *LF *CR)) \u002F FWS)","obs-unstruct    =   *(*LF *CR (obs-utext \u002F FWS)) *LF *CR\r\n                    ;The CR of a following CRLF MUST NOT be consumed.","[I was notified, that errata report 1766 and 1908 has been verified, but apparently, report 1905 was left undecided.  I am a bit concerned, because this report points to a true defect of RFC 5322, so, maybe, a clearer reasoning helps.  This report is meant to replace my former posting 1905.]\r\n\r\nThe \u003Cobs-unstruct> rule covers field bodies of unstructured fields (as declared in section 2.2.1), that conform to obsoleted RFC 2822 or RFC 822.  It is only to be used for downward compatibility when reading messages.  It corresponds to \u003Ctext> in RFC 822 and \u003Cobs-utext> in RFC 2822.  In a conforming message, an unstructured field body is always followed by a field delimiting non-folding CRLF.\r\n\r\n\u003Cobs-unstruct> is equivalent to *(d0-d127), so the CRLF delimiting the field is made part of the field body, as is the rest of the header section.\r\n\r\nSo my proposal refines the rule: Use any, possibly empty, sequence of ASCII characters, as long as it does not contain a CRLF outside of a folding white space.\r\n\r\nThere is a nuisance left: when applied possessively, the CR of the adjacent field delimiter CRLF is consumed as well.  This cannot be overcome, no matter how you rewrite the rule, because the ABNF in RFC 5324 is not rich enough to express something like \"consume all but one CR\".  A higher level construct like \"obs-unstruct CRLF\" must enforce a back-tracking step on the part of \u003Cobs-unstruct> in order to match.  That is why I added the comment.\n --VERIFIER NOTES-- \nDuplicate of erratum 1905, which I believe is correct as stated.   ","2010-04-02",{"errata_id":5060,"doc-id":5017,"errata_status_code":5028,"errata_type_code":5019,"section":1410,"orig_text":5061,"correct_text":5062,"notes":5063,"submit_date":5064,"update_date":5025},"2515","From: Pete(A nice \\) chap) \u003Cpete(his account)@silly.test(his host)>","From: Pete(A nice \\) chap) \u003Cpete@silly.test(his host)>","Section 3.4.1: \"Comments and folding white space SHOULD NOT be used around the \"@\" in the addr-spec.\"","2010-09-10",{"errata_id":5066,"doc-id":5017,"errata_status_code":5028,"errata_type_code":5019,"section":1410,"orig_text":5067,"correct_text":5068,"notes":5063,"submit_date":5069,"update_date":5025},"2579","   To:A Group(Some people)\r\n        :Chris Jones \u003Cc@(Chris's host.)public.example>,\r\n            joe@example.org,\r\n     John \u003Cjdoe@one.test> (my dear friend); (the end of the group)","   To:A Group(Some people)\r\n        :Chris Jones \u003Cc@public.example(Chris's host.)>,\r\n            joe@example.org,\r\n     John \u003Cjdoe@one.test> (my dear friend); (the end of the group)","2010-10-18",{"errata_id":5071,"doc-id":5017,"errata_status_code":5018,"errata_type_code":5019,"section":884,"orig_text":5072,"correct_text":5073,"notes":5074,"submit_date":5075,"update_date":5025},"2619","      It is therefore\r\n      incumbent upon implementations to conform to the syntax of\r\n      addresses for the context in which they are used.","      Implementations MUST conform to the syntax of\r\n      addresses for the context in which they are used.","The phrase \"incumbent upon\" is not defined in RFC 2119. If another RFC defines a standard with the force of \"MUST\", then it is not an option for an implementation to ignore that standard. Therefore, implementations MUST conform to their syntax.\r\n\r\nThis rewording clarifies the recognition that should be given to the RFCs that inform the particular context of the implementation.\n --VERIFIER NOTES-- \nConforming (or failing to conform) to the syntax of another specification does not affect the interoperability of *this* specification. Therefore, RFC 2119 language is not appropriate. However, even if it could be argued that it was, an erratum is not the appropriate place to make such a change.   ","2010-11-10",{"errata_id":5077,"doc-id":5017,"errata_status_code":5018,"errata_type_code":5019,"section":884,"orig_text":5078,"correct_text":5079,"notes":5080,"submit_date":5075,"update_date":5025},"2620","   Comments and folding white space\r\n   SHOULD NOT be used around the \"@\" in the addr-spec.","   Comments and folding white space\r\n   SHOULD NOT be used around the \"@\" in the addr-spec. Comments and\r\n   folding white space at the beginning and end of an addr-spec are\r\n   semantically invisible.","Section 3.2.2 says\r\n\r\n   \"Runs of FWS, comment, or CFWS that occur between lexical tokens in a\r\n   structured header field are semantically interpreted as a single\r\n   space character.\"\r\n\r\nbut a leading or trailing space on an addr-spec would prevent it being interpreted as a valid RFC 5321 Mailbox (see http:\u002F\u002Ftools.ietf.org\u002Fhtml\u002Frfc5321#section-4.1.2).\r\n\r\nThis is important because this section of RFC 5322 also says\r\n\r\n      \"It is therefore\r\n      incumbent upon implementations to conform to the syntax of\r\n      addresses for the context in which they are used.\"\r\n\r\nEither the leading and trailing CFWS should be semantically \"invisible\" or additional logic is required for implementations to transform an RFC 5322 addr-spec into an RFC 5321 Mailbox.\r\n\r\nNote: It may be true that leading and trailing CFWS is not \"between lexical tokens\". If so then it should be made clear what semantic interpretation to put on it in this case.\n --VERIFIER NOTES-- \n1. \"addr-spec\" does not appear in 5321. 5321 and 5322 have two different definitions for \"Mailbox\" and \"mailbox\" respectively, and that is a topic for an update of these documents, not for an erratum.\r\n\r\n2. This report does not want the CFWS to be *semantically* invisible; it wants it to be *syntactically* invisible when moving an addr-spec from a 5322 context to a 5321 context. This document does not discuss this use.",{"errata_id":5082,"doc-id":5017,"errata_status_code":5042,"errata_type_code":5019,"section":856,"orig_text":5083,"correct_text":5084,"notes":5085,"submit_date":5086,"update_date":5025},"2726","   The zone specifies the offset from Coordinated Universal Time (UTC,\r\n   formerly referred to as \"Greenwich Mean Time\") that the date and\r\n   time-of-day represent.  The \"+\" or \"-\" indicates whether the time-of-\r\n   day is ahead of (i.e., east of) or behind (i.e., west of) Universal\r\n   Time.  The first two digits indicate the number of hours difference\r\n   from Universal Time, and the last two digits indicate the number of\r\n   additional minutes difference from Universal Time.  (Hence, +hhmm\r\n   means +(hh * 60 + mm) minutes, and -hhmm means -(hh * 60 + mm)\r\n   minutes).  The form \"+0000\" SHOULD be used to indicate a time zone at\r\n   Universal Time.  Though \"-0000\" also indicates Universal Time, it is\r\n   used to indicate that the time was generated on a system that may be\r\n   in a local time zone other than Universal Time and that the date-time\r\n   contains no information about the local time zone.","   The zone specifies the offset from Coordinated Universal Time (UTC) \r\n   that the date and time-of-day represent.\r\n   The \"+\" or \"-\" indicates whether the time-of-\r\n   day is ahead of (i.e., east of) or behind (i.e., west of) UTC.\r\n   The first two digits indicate the number of hours difference\r\n   from UTC, and the last two digits indicate the number of\r\n   additional minutes difference from UTC.  (Hence, +hhmm\r\n   means +(hh * 60 + mm) minutes, and -hhmm means -(hh * 60 + mm)\r\n   minutes).  The form \"+0000\" SHOULD be used to indicate a time zone at\r\n   UTC.  Though \"-0000\" also indicates UTC, it is\r\n   used to indicate that the time was generated on a system that may be\r\n   in a local time zone other than UTC and that the date-time\r\n   contains no information about the local time zone.","It is not correct to say that UTC was formerly referred to as GMT. I think this was an editorial mistake: RFC 822 did not use the term UTC and said \"Universal  Time (formerly called Greenwich Mean Time)\" which is reasonably correct for UT without a suffix.\r\n\r\nFor the purposes of RFC 5322 and for consistency with RFC 3339 and ISO 8601 I think it is best to refer to UTC throughout - though see the next erratum for notes on the obsolete syntax.","2011-02-21",{"errata_id":5088,"doc-id":5017,"errata_status_code":5018,"errata_type_code":5035,"section":944,"orig_text":5089,"correct_text":5090,"notes":5091,"submit_date":5092,"update_date":5025},"2816","   from            =   \"From:\" mailbox-list CRLF\r\n\r\n   sender          =   \"Sender:\" mailbox CRLF\r\n\r\n   reply-to        =   \"Reply-To:\" address-list CRLF","   from            =   \"From:\" mailbox-list CRLF\r\n\r\n   sender          =   \"Sender:\" mailbox CRLF\r\n\r\n   reply-to        =   \"Reply-To:\" mailbox-list CRLF","The text in section 3.6.2 (and everywhere else Reply-To is mentioned) makes it clear that Reply-To is envisioned as referring to one or more mailboxes.  But the following chain of productions:\r\n\r\naddress-list -> address -> group -> DQUOTE DQUOTE \":\" \";\"\r\n\r\n...means that the following Reply-To header would be permitted by the spec:\r\n\r\n  Reply-To: \"\" : ;\r\n\r\nThis header has no mailbox in it at all.  So either the reply-to production rule is wrong (and should be a mailbox-list instead of an address-list), or the spec needs to explain what the semantics are for a Reply-To line with no mailboxes in it.\r\n\r\nNote also the description of \"group\" in section 3.4:\r\n\r\n  The group construct allows the sender to indicate a named group of recipients.\r\n\r\nAgain, this does not envision using a group in a header like Reply-To.  But that is what the current reply-to construct permits.\r\n\r\nSummary:  The RFC either needs to forbid Reply-To with zero mailboxes, or it needs to explain what the semantics of such a Reply-To are.\n --VERIFIER NOTES-- \nReply-To has allowed address lists (as against mailbox lists) as far back as RFC 733. This would be a change to long held consensus. Not appropriate for an erratum.   ","2011-05-27",{"errata_id":5094,"doc-id":5017,"errata_status_code":5042,"errata_type_code":5035,"section":914,"orig_text":5095,"correct_text":5096,"notes":5097,"submit_date":5098,"update_date":5099},"2950","   fields          =   *(trace\r\n                         *optional-field \u002F\r\n                         *(resent-date \u002F\r\n                          resent-from \u002F\r\n                          resent-sender \u002F\r\n                          resent-to \u002F\r\n                          resent-cc \u002F\r\n                          resent-bcc \u002F\r\n                          resent-msg-id))\r\n                       *(orig-date \u002F\r\n                       from \u002F\r\n                       sender \u002F\r\n                       reply-to \u002F\r\n                       to \u002F\r\n                       cc \u002F\r\n                       bcc \u002F\r\n                       message-id \u002F\r\n                       in-reply-to \u002F\r\n                       references \u002F\r\n                       subject \u002F\r\n                       comments \u002F\r\n                       keywords \u002F\r\n                       optional-field)","   fields          =   *(trace\r\n                         *optional-field \u002F\r\n                         1*(resent-date \u002F\r\n                           resent-from \u002F\r\n                           resent-sender \u002F\r\n                           resent-to \u002F\r\n                           resent-cc \u002F\r\n                           resent-bcc \u002F\r\n                           resent-msg-id))\r\n                       *(orig-date \u002F\r\n                       from \u002F\r\n                       sender \u002F\r\n                       reply-to \u002F\r\n                       to \u002F\r\n                       cc \u002F\r\n                       bcc \u002F\r\n                       message-id \u002F\r\n                       in-reply-to \u002F\r\n                       references \u002F\r\n                       subject \u002F\r\n                       comments \u002F\r\n                       keywords \u002F\r\n                       optional-field)","The original version causes an infinite loop (matching an infinite list of empty strings).","2011-08-30","2019-11-13 20:48:09",{"errata_id":5101,"doc-id":5017,"errata_status_code":5042,"errata_type_code":5019,"section":5102,"orig_text":5103,"correct_text":5104,"notes":5105,"submit_date":5106,"update_date":5025},"3048","3.6.6.  Rese","   When resent fields are used, the \"Resent-From:\" and \"Resent-Date:\"\r\n   fields MUST be sent.  The \"Resent-Message-ID:\" field SHOULD be sent.","   When resent fields are used, the \"Resent-From:\" and \"Resent-Date:\"\r\n   fields MUST be set.  The \"Resent-Message-ID:\" field SHOULD be set.","[Verifier note: The original report only noted the second use of the word \"sent\". I have updated to include both. I have marked as \"Hold\" because (a) I believe the meaning is clear in the current and (b) it is not obvious that \"set\" is the correct word here; perhaps \"used\" is better. Left for an editing pass when this moves to Standard.]","2011-12-08",{"errata_id":5108,"doc-id":5017,"errata_status_code":5018,"errata_type_code":5035,"section":856,"orig_text":5109,"correct_text":5110,"notes":5111,"submit_date":5112,"update_date":5025},"3088","date-time       =   [ day-of-week \",\" ] date time [CFWS]","date-time       =   [ day-of-week \",\" ] date time [comment]","If using the [CFWS] at the end of the original text, by the rules of CFWS, the next line could contain only FWS after the CRLF, which would violate the requirement found in 3.2.2, which reads: \"...where CFWS occurs in this specification, it MUST NOT be inserted in such a way that any line of a folded header field is made up entirely of WSP characters and nothing else.\"\n --VERIFIER NOTES-- \nCFWS allows there to be multiple comments, including comments that go on to the second line, which is perfectly OK.","2012-01-11",{"errata_id":5114,"doc-id":5017,"errata_status_code":5018,"errata_type_code":5019,"section":1410,"orig_text":5115,"correct_text":5115,"notes":5116,"submit_date":5117,"update_date":5025},"3134","   From: Pete(A nice \\) chap) \u003Cpete(his account)@silly.test(his host)>\r\n   To:A Group(Some people)\r\n        :Chris Jones \u003Cc@(Chris's host.)public.example>,\r\n            joe@example.org,\r\n     John \u003Cjdoe@one.test> (my dear friend); (the end of the group)\r\n","Errata 2515 and 2579 change the above text, but there is no change needed to the original RFC. The quote from Section 3.4.1 says \"SHOULD NOT\", not \"MUST NOT\" (\"Comments and folding white space SHOULD NOT be used around the \"@\" in the addr-spec.\"). The example in A.5 \"is aesthetically displeasing, but perfectly legal.\" It's meant to highlight extreme cases.\n --VERIFIER NOTES-- \nThough unstated in the text, the intention of the WG was that the examples in A.1-5 were intended to be messages that conformed to all of the MUSTs and SHOULDs of section 3. Indeed, RFC 2119 defines SHOULD NOT  to mean effectively MUST NOT unless you have fully understood and weighed the reasons for choosing a different course. The description below the example says that it is \"aesthetically displeasing, but perfectly legal\". I don't think violating a SHOULD NOT makes it \"perfectly\" legal.","2012-02-25",{"errata_id":5119,"doc-id":5017,"errata_status_code":5042,"errata_type_code":5035,"section":826,"orig_text":5120,"correct_text":5121,"notes":5122,"submit_date":5117,"update_date":5123},"3135","   quoted-string   =   [CFWS]\r\n                       DQUOTE *([FWS] qcontent) [FWS] DQUOTE\r\n                       [CFWS]\r\n","   quoted-string   =   [CFWS]\r\n                       DQUOTE ((1*([FWS] qcontent) [FWS]) \u002F FWS) DQUOTE\r\n                       [CFWS]","The text following this definition states that a \"quoted-string is identical to atom, semantically.\" \"Semantically, neither the optional CFWS outside of the quote characters nor the quote characters themselves are part of the quoted-string; the quoted-string is what is contained between the two quote characters.\"\r\n\r\nThe published definition allows, for example, an angle-addr of \u003C\"\"@ietf.org> which is equivalent to \u003C@ietf.org>, hence invalid. The corrected definition ensures that at a minimum there is one FWS or qcontent between each DQUOTE.\r\n\r\nCurrently allowed yet invalid: \u003C\"\"@ietf.org>, \u003Cfoo.\"\"@ietf.org>, \u003C\"\".bar@ietf.org>, and \u003Cfoo.\"\".bar@ietf.org>.\r\n\r\nAs a quoted-string must be bound by the ends of the local-part or by a dot, there is no change in regard to the currently invalid addresses such as \u003Cfoo\"\"@ietf.org>, \u003C\"\"bar@ietf.org>, and \u003Cfoo\"\"bar@ietf.org>.","2019-11-13 20:47:31",{"errata_id":5125,"doc-id":5017,"errata_status_code":5018,"errata_type_code":5035,"section":742,"orig_text":5126,"correct_text":5127,"notes":5128,"submit_date":5129,"update_date":5025},"3675","3.2.3.  Atom Says:\r\n\r\n   dot-atom        =   [CFWS] dot-atom-text [CFWS]\r\n\r\n3.2.4.  Quoted Strings (but superseded by Errata 3135) Says:\r\n\r\n   quoted-string   =   [CFWS]\r\n                       DQUOTE ((1*([FWS] qcontent) [FWS]) \u002F FWS) DQUOTE\r\n                       [CFWS]\r\n\r\n3.4.1.  Addr-Spec Specification Says:\r\n\r\n   addr-spec       =   local-part \"@\" domain\r\n\r\n   local-part      =   dot-atom \u002F quoted-string \u002F obs-local-part\r\n\r\n   domain          =   dot-atom \u002F domain-literal \u002F obs-domain\r\n\r\n   domain-literal  =   [CFWS] \"[\" *([FWS] dtext) [FWS] \"]\" [CFWS]\r\n","3.2.3.  Atom\r\n\r\n   dot-atom        =   [CFWS] dot-atom-text [CFWS]\r\n\r\n   dot-atom-lh     =   [CFWS] dot-atom-text [FWS]\r\n\r\n   dot-atom-rh     =   [FWS] dot-atom-text [CFWS]\r\n\r\n3.2.4.  Quoted Strings (but superseded by Errata 3135)\r\n\r\n   quoted-string   =   [CFWS]\r\n                       DQUOTE ((1*([FWS] qcontent) [FWS]) \u002F FWS) DQUOTE\r\n                       [CFWS]\r\n\r\n   quoted-string-lh =  [CFWS]\r\n                       DQUOTE ((1*([FWS] qcontent) [FWS]) \u002F FWS) DQUOTE\r\n                       [FWS]\r\n\r\n3.4.1.  Addr-Spec Specification\r\n\r\n   addr-spec       =   local-part \"@\" domain\r\n\r\n   local-part      =   dot-atom-lh \u002F quoted-string-lh \u002F obs-local-part\r\n\r\n   domain          =   dot-atom-rh \u002F domain-literal \u002F obs-domain\r\n\r\n   domain-literal  =   [FWS] \"[\" *([FWS] dtext) [FWS] \"]\" [CFWS]\r\n","Section 3.4.1 states \"Comments and folding white space SHOULD NOT be used around the \"@\" in the addr-spec.\", yet the ABNF specifically allows it without recourse to obsoleted terms. Given that the above statement is in fact correct, then the current ABNF should be modified as shown to reflect the above statement.\n --VERIFIER NOTES-- \nThe DRUMS Working Group made a conscious decision at the time of writing 2822 that they preferred clarity and ease of understanding of the ABNF at the expense of shift-reduce conflicts and other things that had to be limited in the text descriptions of the syntax, and that assumption carried over into 5322. This is one of those cases. While more precise, the correction is not what was intended, and there are many other cases where the text limits the more free syntax.","2013-06-29",{"errata_id":5131,"doc-id":5017,"errata_status_code":5028,"errata_type_code":5035,"section":5132,"orig_text":5133,"correct_text":5134,"notes":5135,"submit_date":5136,"update_date":5025},"3979","3.6.7; 4.5.7","received        =   \"Received:\" *received-token \";\" date-time CRLF\r\n\r\nobs-received    =   \"Received\" *WSP \":\" *received-token CRLF","received        =   \"Received:\" [1*received-token \u002F CFWS]\r\n                      \";\" date-time CRLF\r\n\r\nobs-received    =   \"Received\" *WSP \":\" [1*received-token \u002F CFWS] CRLF","\"The 'Received:' field contains a (possibly empty) list of tokens followed by a semicolon and a date-time specification.\" As it was originally written, though, whitespace and comments are disallowed right after the colon if the list of tokens is empty: for example, the header field \"Received: ; Wed, 30 Apr 2014 00:00:00 -0000\\r\\n\" (with a space after the first colon) would be invalid according to the current spec; only \"Received:; Wed, 30 Apr 2014 00:00:00 -0000\\r\\n\" (without a space) would be.\r\n\r\nVerifier note: The erratum is clearly correct. There are other possible ABNF solutions, but the one above is sufficient to fix the problem.","2014-04-30",{"errata_id":5138,"doc-id":5017,"errata_status_code":5042,"errata_type_code":5035,"section":826,"orig_text":5139,"correct_text":5140,"notes":5141,"submit_date":5142,"update_date":5025},"4692","   qtext           =   %d33 \u002F             ; Printable US-ASCII\r\n                       %d35-91 \u002F          ;  characters not including\r\n                       %d93-126 \u002F         ;  \"\\\" or the quote character\r\n                       obs-qtext","   qtext           =   %d32 \u002F             ; Printable US-ASCII\r\n                       %d33 \u002F             ;  characters not including\r\n                       %d35-91 \u002F          ;  \"\\\" or the quote character\r\n                       %d93-126 \u002F\r\n                       obs-qtext","According to the Open Group's definition of the \"print\" class of characters in a locale [1], the SPACE character (%d32) is printable as well. So either it should be included in the \"qtext\" definition or the comment should state explicitly that it is excluded from \"qtext\" along with backslash and double quote.\r\n\r\n[1]: pubs.opengroup.org\u002Fonlinepubs\u002F009695399\u002Fbasedefs\u002Fxbd_chap07.html\r\n\r\n----- Verifier notes -----\r\nThere are many places in the document that refer to \"printable US-ASCII characters\", and it's clear from the context of them that SPACE was not included there.  This issue does need to be looked at when we revise this document to advance it to Internet Standard.","2016-05-13",{"errata_id":5144,"doc-id":5017,"errata_status_code":5018,"errata_type_code":5035,"section":856,"orig_text":5145,"correct_text":5146,"notes":5147,"submit_date":5148,"update_date":5025},"5035","   time            =   time-of-day zone\r\n\r\n   zone            =   (FWS ( \"+\" \u002F \"-\" ) 4DIGIT) \u002F obs-zone\r\n","time            =       time-of-day FWS zone\r\n\r\nzone            =       (( \"+\" \u002F \"-\" ) 4DIGIT) \u002F obs-zone\r\n","The rfc5322 version of the syntax clearly forces the obs-zone to follow the time-of-day with no space.  The syntax from rfc2822 seems to be what is actually in use in the real world.  Why was this change made?  Should it just be changed back?\n --VERIFIER NOTES-- \nAs per reply from Pete Resnick:\r\n\r\nI believe this erratum report should be rejected. While it is true that\r\nobs-zone does not begin with FWS, time-of-day ends with second, which\r\ncan be an obs-second, and obs-second ends with an optional CFWS.\r\nTherefore, obs-zone is not forced to follow time-of-day with no space;\r\nit just makes the space optional. And this allows for the original 822\r\nsyntax, which did not require space between the time-of-day and the\r\nzone. (Somewhat goofy to allow that, but it is parseable.)\r\n","2017-06-09",{"errata_id":5150,"doc-id":5017,"errata_status_code":5018,"errata_type_code":5035,"section":796,"orig_text":5151,"correct_text":5152,"notes":5153,"submit_date":5154,"update_date":5025},"5712","   FWS             =   ([*WSP CRLF] 1*WSP) \u002F  obs-FWS\r\n                                          ; Folding white space","   FWS             =   ([*WSP] CRLF 1*WSP) \u002F  obs-FWS\r\n                                          ; Folding white space","Both section 2.2.3 and part of section 3.2.2 (\"Wherever folding appears in a message (that is, a header field body containing a CRLF followed by any WSP)\") describe folding as adding CRLF followed by WSP, so CRLF is required for folding.  However, the CRLF in the FWS rule is shown inside the square brackets, which would make it optional.  It should not be inside the square brackets.\r\n\r\nSquare brackets:  section 1.2.2 states \"This specification uses the Augmented Backus-Naur Form (ABNF) [RFC5234] notation for the formal definitions of the syntax of messages.\"  In RFC 5234, section 3.8 states \"Square brackets enclose an optional element sequence\".\n --VERIFIER NOTES-- \n \r\nThe FWS construct shows where folding is permitted (where CRLF *can* appear).  The mechanism for actual folding is described in the text, and won't happen at each instance of FWS.  Having the CRLF be optional is intentional and necessary.","2019-04-29",{"errata_id":5156,"doc-id":5017,"errata_status_code":5042,"errata_type_code":5035,"section":1242,"orig_text":5157,"correct_text":5158,"notes":5159,"submit_date":5160,"update_date":5161},"5867","   obs-received    =   \"Received\" *WSP \":\" *received-token CRLF\r\n","   obs-received    =   \"Received\" *WSP \":\"\r\n                       [1*received-token \u002F CFWS] [ \";\" date-time CRLF ]\r\n                    ","Erratum 3979 already describes that CFWS should be allowed in an otherwise empty list of received-tokens. This adds an optional date-time after that.","2019-10-01","2019-11-13 20:46:45",{"errata_id":5163,"doc-id":5017,"errata_status_code":5042,"errata_type_code":5035,"section":856,"orig_text":5164,"correct_text":5165,"notes":5166,"submit_date":5167,"update_date":5168},"5905","   The time-of-day specifies the number of hours, minutes, and\r\n   optionally seconds since midnight of the date indicated.\r\n\r\n   The date and time-of-day SHOULD express local time.\r\n","   The time-of-day specifies the number of hours, minutes, and\r\n   optionally seconds since midnight of the date indicated or, when\r\n   a time-zone transition has intervened in the interval, since the\r\n   nominal midnight of the zone now in effect.\r\n\r\n   The date and time-of-day SHOULD express local time.\r\n","The problem with the original text is its reading on the day of a time-zone transition.\r\n\r\nFor example, if the hour from 02:00 to 03:00 was repeated (a fall-back, as at the end of DST), then what local time refers to as 04:00 is 5 hours after midnight \"of the date indicated\" and what local time refers to as 23:59 is almost 25 hours after midnight.  Likewise, if an hour early in the day has been skipped (a spring-forward, as at the start of DST), the time since midnight is one hour short of the local time, as normally understood; for example, 23:00 is only 22 hours after midnight.\r\n\r\nThere are zones in which transitions happen at midnight, for which 01:00 is midnight on a relevant day: at the other end of the year, there may then be a day that repeats 00:00, so may be argued to have two midnights (with a rather literal \"midnight hour\" in between).\r\n\r\nI cannot think of a good replacement text, sad to say, but I have tried my (painfully verbose) best.  I assume everyone has always just used the conventional meaning of local time (as per the SHOULD in the paragraph I haven't changed), without worrying about the inaccurate \"since midnight\" phrasing.","2019-11-13","2019-11-13 20:46:18",{"errata_id":5170,"doc-id":5017,"errata_status_code":5042,"errata_type_code":5035,"section":673,"orig_text":5171,"correct_text":21,"notes":5172,"submit_date":5173,"update_date":5174},"5918","Header fields are lines beginning with a field name, followed by a\r\n   colon (\":\"), followed by a field body, and terminated by CRLF.  A\r\n   field name MUST be composed of printable US-ASCII characters (i.e.,\r\n   characters that have values between 33 and 126, inclusive), except\r\n   colon.","I'm reporting an omission rather than a correction. The description of field names in S2.2 does not describe any length limit, but it implicitly prohibits folding by not permitting WSP chars in the name. 3.6.8 defines an ABNF for field-name, but does not specify a length limit either. \r\n\r\nAs far as I can see this means that field names should be limited to 77 characters – the field name and a trailing : – after which the field body can start after FWS on the next line.\r\n\r\nI suspect this will be open to some debate, so I'm not sure what to suggest as a correction beyond that. Nor do I know whether common clients & servers impose their own arbitrary limits on field names.","2019-11-26","2024-05-15 08:57:58",{"errata_id":5176,"doc-id":5017,"errata_status_code":5028,"errata_type_code":5035,"section":856,"orig_text":5177,"correct_text":5178,"notes":5179,"submit_date":5180,"update_date":5181},"6639","   zone            =   (FWS ( \"+\" \u002F \"-\" ) 4DIGIT) \u002F obs-zone","   zone            =   (FWS ( \"+\" \u002F \"-\" ) 4DIGIT) \u002F [FWS] obs-zone","The current syntax does not allow space before an obs-zone. Thus, it rejects header items like:\r\n\r\nDate: Mon, 12 Jul 2021 18:32:01 GMT\r\n\r\nwhich are still being produced today by, for example, mail(1) on FreeBSD.","2021-07-12","2024-05-15 08:59:01",{"errata_id":5183,"doc-id":5017,"errata_status_code":5042,"errata_type_code":5035,"section":645,"orig_text":5184,"correct_text":5185,"notes":5186,"submit_date":5187,"update_date":5188},"6921","composed of characters with values in the range of 1 through 127 and interpreted as US-ASCII [ANSI.X3-4.1986] characters.","composed of ASCII characters [RFC20] with values in the range from 0\u002F1 to 7\u002F15.\r\n\r\n   --OR--\r\n\r\ncomposed of octets with decimal values in the range from 1 through 127 and interpreted as US-ASCII [ANSI.X3-4.1986] characters.","See previous erratum about \"US-ASCII\" versus \"ASCII\" or \"RFC20\" and apply as needed to the suggested text.  \r\n\r\nWhile there are several ways to fix the problem being reported here, the \"range of 1 through 127\" has no meaning without some qualification as to what the numbers mean.  One could infer from the original form that the range is interpreted according to something in the standard, but that standard, unlike, e.g., Unicode, never uses a linear sequence of numbers to refer to code points, only the Column\u002FRow notation shown above (plus, of course, the actual seven-bit binary coding).","2022-04-05","2024-05-16 13:27:47",{"errata_id":5190,"doc-id":5017,"errata_status_code":5028,"errata_type_code":5019,"section":645,"orig_text":5191,"correct_text":5192,"notes":5193,"submit_date":5187,"update_date":5194},"6920","and interpreted as US-ASCII [ANSI.X3-4.1986] characters.  For brevity, this document sometimes refers to this range of characters as simply \"US-ASCII characters\".","and interpreted as ASCII [ANSI.X3-4.1986] characters.  For brevity, this document sometimes refers to this range of characters as simply \"ASCII characters\".","The choice of \"US-ASCII\" as a charset name reflected circumstances at the time, but it was not then and has never been the name of a coded character set, much less the one specified in the various versions of what is now ANSI INCITS 4-1986[R2017].  The common name of the latter, both specified in the Standard and in common practice, is \"ASCII\" without any further qualification.   \"For brevity\", \"ASCII\" is not only more accurate, but shorter.   While the correction is being made, it would be wise to change the citation anchor to \"[ASCII]\" or, if necessary for some reason, \"[ASCII1986]\".  The odd punctuation used in \"[ANSI.X3-4.1986]\" to refer to ANSI X3.4-1986 is just unnecessarily confusing.\r\n\r\n(this erratum is being reported more or less at the request of the editor of RFC 5322 and its successor)","2024-04-01 21:16:44",{"errata_id":5196,"doc-id":5017,"errata_status_code":5018,"errata_type_code":5035,"section":811,"orig_text":5197,"correct_text":5198,"notes":5199,"submit_date":5200,"update_date":5201},"7382","ccontent        =   ctext \u002F quoted-pair \u002F comment\r\n\r\ncomment         =   \"(\" *([FWS] ccontent) [FWS] \")\"","ccontent        =   ctext \u002F quoted-pair\r\n\r\ncomment         =   \"(\" *([FWS] ccontent) [FWS] \")\"","Trying to getting all possible originator formats a reader can get stuck into a circular dependency between \"comment\" and \"ccontent\" definitions.\r\nSince \"ccontent\" is referenced in the \"comment\" definition only circular dependency should be cut there I suppose.\n --VERIFIER NOTES-- \nThe ABNF for comment is correct in 5322. It is intended to be recursive, allowing for nested comments.","2023-03-11","2024-05-15 08:54:32",{"errata_id":5203,"doc-id":5017,"errata_status_code":5018,"errata_type_code":5035,"section":1102,"orig_text":5204,"correct_text":5205,"notes":5206,"submit_date":5207,"update_date":5208},"8464","obs-angle-addr  =   [CFWS] \"\u003C\" obs-route addr-spec \">\" [CFWS]","obs-angle-addr  =   [CFWS] \"\u003C\" [obs-route] addr-spec \">\" [CFWS]","If I understand correctly, according to RFC 822 (the RFC 5322 'obsolete syntax'), an email address enclosed in angle brackets may or may not have a prepended route. If correct, the obs-route particle of the ABNF declaration should be labeled optional in brackets [].\r\n\r\nRFC 5322 states that \r\n\"mailbox addresses were allowed to have a route portion before the addr-spec when enclosed in \"\u003C\" and \">\"\", which suggests that they were also allowed to not have a route portion.\r\n\r\nRFC 822 Section 6.1 defines the route is optional in an angle bracketed address:\r\nroute-addr  =  \"\u003C\" [route] addr-spec \">\"\r\n\r\nand RFC 2822 Section 4.4, where the section in question seems to be copied from, does indeed label the route portion as optional in the ABNF:\r\nobs-angle-addr  =       [CFWS] \"\u003C\" [obs-route] addr-spec \">\" [CFWS]\n --VERIFIER NOTES-- \nFrom Pete Resnick:\r\nThis is a bit obscure, but the current text is correct. The only place\r\nthat obs-angle-addr is used in the syntax is section 3.4:\r\n\r\n    angle-addr      =   [CFWS] \"\u003C\" addr-spec \">\" [CFWS] \u002F\r\n                        obs-angle-addr\r\n\r\nIf you do the substitution, you get:\r\n\r\n    angle-addr      =   [CFWS] \"\u003C\" addr-spec \">\" [CFWS] \u002F\r\n                        [CFWS] \"\u003C\" obs-route addr-spec \">\" [CFWS]\r\n\r\nWhat that says is that angle-addr is either without a route, or with an\r\nobs-route. Making the obs-route in there as optional would be redundant.\r\nWe could have made angle-addr this way:\r\n\r\n    angle-addr      =   [CFWS] \"\u003C\" [obs-route] addr-spec \">\" [CFWS]\r\n\r\nbut that breaks the pattern of having an obs- replacement as a final\r\nalternative, and I think it would probably be more confusing.","2025-06-17","2025-11-01 18:45:07",{"errata_id":5210,"doc-id":5017,"errata_status_code":5018,"errata_type_code":5035,"section":5211,"orig_text":5212,"correct_text":5213,"notes":5214,"submit_date":5215,"update_date":5216},"8453","3.2.2, 3.2.4","This is a bit related to erratas 3135 and 4692.\r\n\r\nThe standard says in 3.2.2\r\n\r\n   Runs of FWS, comment, or CFWS that occur between lexical tokens in a\r\n   structured header field are semantically interpreted as a single\r\n   space character.\r\n\r\nThis seems to have evaluated from RFC 822 which said\r\n\r\n     3.4.2.  WHITE SPACE\r\n\r\n        Note:  In structured field bodies, multiple linear space ASCII\r\n               characters  (namely  HTABs  and  SPACEs) are treated as\r\n               single spaces[.]\r\n\r\nRFC 822 is pretty clear that a (RFC 5322) quoted-string defined as\r\n\r\n   ((1*([FWS] qcontent) [FWS])\r\n\r\nand stating that is shall be treated \"as an atom\", in a context of\r\n\r\n   Bat  \" \\t from \\t \"  hell \u003C b  \" \\t l \\t \"  a  @exam.ple>\r\n\r\neffectively reduces to\r\n\r\n   Bat \" from \" hell \u003C\"b l a\">@exam.ple>\r\n\r\n(Or is that already\r\n   Bat \" from \" hell \u003Cb \" l \" a@examp.ple>\r\nor even (that not me thinks)\r\n   Bat \"from\" hell \u003Cb\"  l  \"a@exampl.ple>\r\ni struggle.)\r\n\r\nHowever, with RFC 5322 words, and with the meaning of \"atom\", it seems to me, the effective reduction would be\r\n\r\n   Bat \"  from  \" hell \u003Cb \" \\t l \\t \" a@exam.ple>\r\nor\r\n   Bat \"  from  \" hell \u003Cb \"   l   \" a@exam.ple>\r\n\r\nif HTAB reduces to SP (i think that yes, anyway).\r\n\r\nIt is not clear, and in practice everybody does its thing the one or the other way, that much is plain!\r\n(This also applies to anything \"consecutive\" btw, does this stack up in a single-pass parser, or does it require a multi-pass parser?)","I have no idea.\r\nI would reintroduce the RFC 822 wording somehow, so that the result is\r\n\r\n   Bat \" from \" hell \u003C\"b l a\"@exam.ple>","My own parser formerly reduced to\r\n\r\n   \"Bat from hell\" \u003C\"bla\"@exam.ple>\r\n\r\nand i changed it to\r\n\r\n   \"Bat__from__hell\" \u003C\"b l a\"@exam.ple>\r\n \r\n(__ means twice space, thanks to this web editor, if i saw this correctly :)\r\nbecause we requote the entire thing no matter what, resulting in two adjacent space characters.\r\nI am a bit sad, but looking around it is not bad.  (To make it a rhyme.)\n --VERIFIER NOTES-- \nThis report was reviewed by both Pete Resnick and Dave Crocker, concluding that 5322 and  5322bis (at the moment in the RFC editor's queue) addresses the matter of this report: whitespace in the local-part is in the so-called \"obsolete\" syntax in 5322 because it's not clear what a parser is meant to do in the scenario presented in this report.","2025-06-06","2025-11-07 12:54:30","2026-07-18T03:35:28.983Z",["Reactive",5219],{"$scolor-mode":5220},{"preference":5221,"value":5221,"unknown":17,"forced":5222},"system",false,["Set"],["ShallowReactive",5225],{"info-buckethtmldocument-rfc5322":-1},["Reactive",5227],{"auth":5228,"notifications":5234,"uiSettings":5245,"hasTouch":5256},{"hasCheckedAuth":5229,"isAuthenticated":5231,"user":5232},["EmptyRef",5230],"false",["EmptyRef",5230],["EmptyRef",5233],"_",{"queue":5235},["Ref",5236],["Reactive",5237],[5238],{"id":5239,"title":5240,"description":5241,"url":5242,"delayMs":5243,"durationMs":-4,"position":5244,"allowDismiss":17},"placeholder","Placeholder notification","This is a placeholder notification to demonstrate the toast queue.","\u002Finfo\u002Frfc9000\u002F",2000,"bottom",{"isUiSettingsModalOpen":5246,"obsoletedByMode":5247,"updatedByMode":5249,"disableRFCLinkPreview":5250,"textScale":5251,"subjectDensity":5253,"wordBreakMode":5254},["EmptyRef",5230],["Ref",5248],"compact",["Ref",5248],["EmptyRef",5230],["Ref",5252],1.5,["Ref",5248],["Ref",5255],"wbr",{"hasTouch":5257},["EmptyRef",5258],"null"]</script></body></html>